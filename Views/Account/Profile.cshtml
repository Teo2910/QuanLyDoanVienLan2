@using Microsoft.AspNetCore.Identity
@using QLDV.Models
@inject UserManager<ApplicationUser> UserManager
@{
    var user = await UserManager.GetUserAsync(User);
    ViewData["Title"] = "User Profile";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="content-header">
    <h1><i class="fas fa-id-badge"></i> User Profile</h1>
    <p class="text-muted">Manage your account information</p>
</div>

<div class="row">
    <div class="col-md-4">
        <div class="card shadow">
            <div class="card-body text-center">
                <div class="rounded-circle bg-light d-inline-flex align-items-center justify-content-center mb-3" style="width: 120px; height: 120px; font-size: 3rem; color: #0056b3;">
                    @if (!string.IsNullOrEmpty(user?.AvatarUrl))
                    {
                        <img src="@user.AvatarUrl" class="rounded-circle" style="width: 100%; height: 100%; object-fit: cover;">
                    }
                    else
                    {
                        <i class="fas fa-user"></i>
                    }
                </div>
                <h3>@user?.FullName</h3>
                <p class="text-muted">@user?.Email</p>
                <span class="badge bg-primary">@user?.Role</span>
            </div>
        </div>
    </div>
    <div class="col-md-8">
        <div class="card shadow">
            <div class="card-header bg-white">
                <h5 class="mb-0">Account Details</h5>
            </div>
            <div class="card-body">
                <div class="row mb-3">
                    <div class="col-sm-3 font-weight-bold">Username:</div>
                    <div class="col-sm-9">@user?.UserName</div>
                </div>
                <div class="row mb-3">
                    <div class="col-sm-3 font-weight-bold">Email:</div>
                    <div class="col-sm-9">@user?.Email</div>
                </div>
                <div class="row mb-3">
                    <div class="col-sm-3 font-weight-bold">Full Name:</div>
                    <div class="col-sm-9">@user?.FullName</div>
                </div>
                <div class="row mb-3">
                    <div class="col-sm-3 font-weight-bold">Role:</div>
                    <div class="col-sm-9">@user?.Role</div>
                </div>
                <div class="row mb-3">
                    <div class="col-sm-3 font-weight-bold">Joined:</div>
                    <div class="col-sm-9">@(user?.CreatedAt > 0 ? DateTimeOffset.FromUnixTimeSeconds(user.CreatedAt).ToString("dd/MM/yyyy") : "N/A")</div>
                </div>
            </div>
            <div class="card-footer bg-white">
                <button class="btn btn-outline-primary" disabled>Edit Profile (Coming Soon)</button>
                <button class="btn btn-outline-secondary" disabled>Change Password (Coming Soon)</button>
            </div>
        </div>
    </div>
</div>
