@model QLDV.Controllers.LoginViewModel
@{
    ViewData["Title"] = "Đăng nhập hệ thống";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - QLDV</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <style>
        body {
            font-family: 'Inter', sans-serif;
            background-color: #f2f5f9;
            background-image: radial-gradient(at 0% 0%, rgba(0, 97, 242, 0.05) 0, transparent 50%), radial-gradient(at 50% 0%, rgba(16, 185, 129, 0.05) 0, transparent 50%);
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0;
            padding: 1.5rem;
        }

        .auth-card {
            background: #ffffff;
            width: 100%;
            max-width: 440px;
            border-radius: 32px;
            box-shadow: 0 20px 40px rgba(0,0,0,0.05);
            padding: 3rem;
            position: relative;
            border: 1px solid #f1f5f9;
        }

        @@media (max-width: 575.98px) {
            .auth-card {
                padding: 2.5rem 1.5rem;
                border-radius: 24px;
            }
        }

        .brand-logo-badge {
            width: 56px;
            height: 56px;
            background: linear-gradient(135deg, #0061f2 0%, #004085 100%);
            color: #fff;
            border-radius: 16px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: 800;
            font-size: 1.25rem;
            box-shadow: 0 8px 16px rgba(0, 97, 242, 0.2);
            margin: 0 auto 1.5rem;
        }

        .auth-header {
            text-align: center;
            margin-bottom: 2.5rem;
        }

        .auth-header h2 {
            font-weight: 900;
            font-size: 1.75rem;
            letter-spacing: -1px;
            color: #0f172a;
            margin-bottom: 0.5rem;
        }

        .auth-header p {
            font-size: 0.85rem;
            color: #64748b;
            font-weight: 600;
        }

        .custom-label {
            font-size: 0.7rem;
            font-weight: 800;
            color: #94a3b8;
            text-transform: uppercase;
            letter-spacing: 1px;
            margin-bottom: 0.5rem;
            display: block;
        }

        .custom-input {
            background: #f8fafc;
            border: 1px solid #e2e8f0;
            border-radius: 12px;
            padding: 0.85rem 1.15rem;
            font-weight: 600;
            color: #1e293b;
            transition: all 0.3s;
            width: 100%;
            font-size: 0.95rem;
        }

        .custom-input:focus {
            background: #fff;
            border-color: #0061f2;
            box-shadow: 0 0 0 4px rgba(0, 97, 242, 0.08);
            outline: none;
        }

        .submit-btn {
            background: #0061f2;
            color: #fff;
            border: none;
            border-radius: 12px;
            padding: 1rem;
            font-weight: 800;
            font-size: 0.85rem;
            text-transform: uppercase;
            letter-spacing: 1px;
            width: 100%;
            margin-top: 1rem;
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
            box-shadow: 0 8px 20px rgba(0, 97, 242, 0.2);
        }

        .submit-btn:hover {
            transform: translateY(-2px);
            box-shadow: 0 12px 25px rgba(0, 97, 242, 0.3);
            background: #004085;
        }

        .auth-footer {
            text-align: center;
            margin-top: 2.5rem;
            font-size: 0.85rem;
            color: #666;
            font-weight: 600;
        }

        .auth-footer a {
            color: #0056b3;
            text-decoration: none;
            font-weight: 800;
        }

        .auth-footer a:hover {
            text-decoration: underline;
        }

        .form-check-label {
            font-size: 0.85rem;
            font-weight: 600;
            color: #666;
            cursor: pointer;
        }

        .form-check-input {
            border-radius: 6px;
            border-color: #eee;
            cursor: pointer;
        }

        .form-check-input:checked {
            background-color: #0056b3;
            border-color: #0056b3;
        }

        .validation-summary-errors {
            background: #fff5f5;
            color: #e03131;
            padding: 1rem;
            border-radius: 14px;
            font-size: 0.8rem;
            font-weight: 600;
            margin-bottom: 1.5rem;
        }

        .validation-summary-errors ul {
            margin: 0;
            padding-left: 1.5rem;
        }
    </style>
</head>
<body>
    <div class="auth-card">
        <div class="brand-logo-badge">QN</div>
        <div class="auth-header">
            <h2>Chào mừng trở lại</h2>
            <p>Đăng nhập để quản lý đoàn viên thông minh</p>
        </div>

        <form asp-route-returnurl="@ViewData["ReturnUrl"]" method="post">
            <div asp-validation-summary="All" class="text-danger"></div>
            
            <div class="mb-4">
                <label class="custom-label">Địa chỉ Email</label>
                <input asp-for="Email" class="custom-input" placeholder="name@example.com" required />
            </div>

            <div class="mb-4">
                <label class="custom-label">Mật khẩu</label>
                <input asp-for="Password" type="password" class="custom-input" placeholder="••••••••" required />
            </div>

            <div class="mb-4 d-flex justify-content-between align-items-center">
                <div class="form-check">
                    <input asp-for="RememberMe" class="form-check-input" id="rememberMe" />
                    <label class="form-check-label" for="rememberMe">Ghi nhớ tôi</label>
                </div>
                <a href="#" style="font-size: 0.8rem; color: #0056b3; font-weight: 700; text-decoration: none;">Quên mật khẩu?</a>
            </div>

            <button type="submit" class="submit-btn">
                ĐĂNG NHẬP NGAY
            </button>
        </form>

        <div class="auth-footer">
            Chưa có tài khoản? <a href="/Account/Register">Đăng ký tại đây</a>
        </div>
    </div>
</body>
</html>
