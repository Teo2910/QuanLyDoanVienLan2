@model QLDV.Controllers.LoginViewModel
@{
    ViewData["Title"] = "Đăng nhập hệ thống";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - QLDV</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
    <style>
        :root {
            --primary: #0061f2;
            --primary-bold: #004ecc;
            --slate-900: #0f172a;
            --slate-800: #1e293b;
            --slate-600: #475569;
            --slate-400: #94a3b8;
            --slate-200: #e2e8f0;
            --slate-100: #f1f5f9;
            --slate-50: #f8fafc;
        }

        body {
            font-family: 'Inter', sans-serif;
            background-color: var(--slate-50);
            background-image: 
                radial-gradient(at 0% 0%, rgba(0, 97, 242, 0.03) 0, transparent 50%), 
                radial-gradient(at 100% 100%, rgba(16, 185, 129, 0.03) 0, transparent 50%);
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0;
            padding: 2rem;
        }

        .auth-container {
            width: 100%;
            max-width: 480px;
            animation: slideUp 0.6s cubic-bezier(0.16, 1, 0.3, 1);
        }

        .auth-card {
            background: #ffffff;
            border-radius: 40px;
            box-shadow: 0 40px 100px rgba(15, 23, 42, 0.08);
            padding: 4rem;
            position: relative;
            border: 1px solid var(--slate-100);
        }

        @@media (max-width: 576px) {
            .auth-card {
                padding: 3rem 2rem;
                border-radius: 30px;
            }
        }

        .brand-section {
            text-align: center;
            margin-bottom: 3.5rem;
        }

        .brand-logo {
            width: 64px;
            height: 64px;
            background: var(--slate-900);
            color: #fff;
            border-radius: 20px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: 900;
            font-size: 1.5rem;
            margin: 0 auto 1.5rem;
            box-shadow: 0 10px 25px rgba(15, 23, 42, 0.15);
        }

        .brand-section h2 {
            font-weight: 900;
            font-size: 2rem;
            color: var(--slate-900);
            letter-spacing: -1.5px;
            margin-bottom: 0.5rem;
        }

        .brand-section p {
            font-size: 0.8rem;
            color: var(--slate-400);
            font-weight: 800;
            text-transform: uppercase;
            letter-spacing: 1.5px;
        }

        .form-group-premium {
            margin-bottom: 1.75rem;
        }

        .label-premium {
            font-size: 0.65rem;
            font-weight: 900;
            color: var(--slate-400);
            text-transform: uppercase;
            letter-spacing: 1.5px;
            margin-bottom: 0.75rem;
            display: block;
        }

        .input-premium {
            background: var(--slate-50);
            border: 2px solid transparent;
            border-radius: 18px;
            padding: 1.1rem 1.4rem;
            font-weight: 700;
            color: var(--slate-800);
            transition: all 0.3s;
            width: 100%;
            font-size: 0.95rem;
        }

        .input-premium::placeholder {
            color: var(--slate-200);
        }

        .input-premium:focus {
            background: #fff;
            border-color: var(--primary);
            box-shadow: 0 15px 40px rgba(0, 97, 242, 0.08);
            outline: none;
        }

        .submit-btn-premium {
            background: var(--slate-900);
            color: #fff;
            border: none;
            border-radius: 20px;
            padding: 1.25rem;
            font-weight: 900;
            font-size: 0.9rem;
            text-transform: uppercase;
            letter-spacing: 1.5px;
            width: 100%;
            margin-top: 1.5rem;
            transition: all 0.3s;
            box-shadow: 0 15px 35px rgba(15, 23, 42, 0.2);
            cursor: pointer;
        }

        .submit-btn-premium:hover {
            transform: translateY(-3px);
            background: var(--primary);
            box-shadow: 0 20px 45px rgba(0, 97, 242, 0.25);
        }

        .auth-options {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin: 1.5rem 0;
        }

        .checkbox-premium {
            display: flex;
            align-items: center;
            gap: 10px;
            cursor: pointer;
            font-size: 0.8rem;
            font-weight: 700;
            color: var(--slate-600);
        }

        .checkbox-premium input {
            width: 18px;
            height: 18px;
            border-radius: 6px;
            border: 2px solid var(--slate-200);
            cursor: pointer;
        }

        .forgot-link {
            font-size: 0.8rem;
            font-weight: 800;
            color: var(--primary);
            text-decoration: none;
            transition: 0.2s;
        }

        .forgot-link:hover {
            color: var(--primary-bold);
        }

        .auth-footer {
            text-align: center;
            margin-top: 3rem;
            padding-top: 2rem;
            border-top: 1px solid var(--slate-50);
            font-size: 0.85rem;
            color: var(--slate-400);
            font-weight: 700;
        }

        .auth-footer a {
            color: var(--slate-900);
            text-decoration: none;
            font-weight: 900;
            margin-left: 5px;
            transition: 0.2s;
        }

        .auth-footer a:hover {
            color: var(--primary);
        }

        .validation-errors {
            background: #fff5f5;
            color: #ef4444;
            padding: 1.25rem;
            border-radius: 20px;
            font-size: 0.8rem;
            font-weight: 700;
            margin-bottom: 2rem;
            border: 1px solid #fee2e2;
        }

        .validation-errors ul {
            margin: 0;
            padding-left: 1.25rem;
        }

        @@keyframes slideUp {
            from { opacity: 0; transform: translateY(30px); }
            to { opacity: 1; transform: translateY(0); }
        }
    </style>
</head>
<body>
    <div class="auth-container">
        <div class="auth-card">
            <div class="brand-section">
                <div class="brand-logo">QN</div>
                <h2>Chào mừng <span>trở lại</span></h2>
                <p>HỆ THỐNG QUẢN LÝ ĐOÀN THÔNG MINH</p>
            </div>

            <form asp-route-returnurl="@ViewData["ReturnUrl"]" method="post">
                @if (!ViewData.ModelState.IsValid)
                {
                    <div asp-validation-summary="All" class="validation-errors"></div>
                }
                
                <div class="form-group-premium">
                    <label class="label-premium">ĐỊA CHỈ EMAIL</label>
                    <input asp-for="Email" class="input-premium" placeholder="name@example.com" required />
                </div>

                <div class="form-group-premium">
                    <label class="label-premium">MẬT KHẨU TRUY CẬP</label>
                    <input asp-for="Password" type="password" class="input-premium" placeholder="••••••••" required />
                </div>

                <div class="auth-options">
                    <label class="checkbox-premium">
                        <input asp-for="RememberMe" type="checkbox" />
                        <span>Ghi nhớ tôi</span>
                    </label>
                    <a href="#" class="forgot-link">Quên mật khẩu?</a>
                </div>

                <button type="submit" class="submit-btn-premium">
                    ĐĂNG NHẬP NGAY <i class="fas fa-arrow-right ms-2" style="font-size: 0.8rem;"></i>
                </button>
            </form>

            <div class="auth-footer">
                Chưa có tài khoản? <a href="/Account/Register">Đăng ký tại đây</a>
            </div>
        </div>
    </div>
</body>
</html>
