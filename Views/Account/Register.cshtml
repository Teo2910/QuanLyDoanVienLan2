@model QLDV.Controllers.RegisterViewModel
@{
    ViewData["Title"] = "Đăng ký tài khoản";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - QLDV</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
    <style>
        :root {
            --primary: #0061f2;
            --primary-bold: #004ecc;
            --success: #10b981;
            --danger: #ef4444;
            --slate-900: #0f172a;
            --slate-800: #1e293b;
            --slate-600: #475569;
            --slate-400: #94a3b8;
            --slate-200: #e2e8f0;
            --slate-100: #f1f5f9;
            --slate-50: #f8fafc;
        }

        body {
            font-family: 'Inter', sans-serif;
            background-color: var(--slate-50);
            background-image: 
                radial-gradient(at 0% 0%, rgba(0, 97, 242, 0.03) 0, transparent 50%), 
                radial-gradient(at 100% 100%, rgba(16, 185, 129, 0.03) 0, transparent 50%);
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0;
            padding: 40px 20px;
        }

        .auth-container {
            width: 100%;
            max-width: 600px;
            animation: slideUp 0.6s cubic-bezier(0.16, 1, 0.3, 1);
        }

        .auth-card {
            background: #ffffff;
            border-radius: 45px;
            box-shadow: 0 40px 100px rgba(15, 23, 42, 0.08);
            padding: 4rem;
            position: relative;
            border: 1px solid var(--slate-100);
        }

        @@media (max-width: 576px) {
            .auth-card {
                padding: 3rem 2rem;
                border-radius: 30px;
            }
        }

        .brand-section {
            text-align: center;
            margin-bottom: 3rem;
        }

        .brand-logo {
            width: 60px;
            height: 60px;
            background: var(--success);
            color: #fff;
            border-radius: 20px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: 900;
            font-size: 1.4rem;
            margin: 0 auto 1.5rem;
            box-shadow: 0 10px 25px rgba(16, 185, 129, 0.2);
        }

        .brand-section h2 {
            font-weight: 900;
            font-size: 2rem;
            color: var(--slate-900);
            letter-spacing: -1.5px;
            margin-bottom: 0.5rem;
        }

        .brand-section p {
            font-size: 0.75rem;
            color: var(--slate-400);
            font-weight: 800;
            text-transform: uppercase;
            letter-spacing: 1.5px;
        }

        /* Avatar Section */
        .avatar-upload-wrapper {
            display: flex;
            flex-direction: column;
            align-items: center;
            margin-bottom: 3rem;
        }

        .avatar-preview-box {
            width: 120px;
            height: 120px;
            background: var(--slate-50);
            border: 3px solid var(--slate-100);
            border-radius: 40px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 2rem;
            color: var(--slate-200);
            overflow: hidden;
            margin-bottom: 12px;
            cursor: pointer;
            transition: all 0.3s;
            position: relative;
        }

        .avatar-preview-box:hover {
            border-color: var(--primary);
            color: var(--primary);
            transform: scale(1.05);
        }

        .avatar-preview-box img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

        .avatar-hint {
            font-size: 0.65rem;
            font-weight: 900;
            color: var(--slate-400);
            text-transform: uppercase;
            letter-spacing: 1px;
        }

        /* Form Grouping */
        .form-row-premium {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 1.5rem;
            margin-bottom: 1.5rem;
        }

        @@media (max-width: 576px) {
            .form-row-premium {
                grid-template-columns: 1fr;
            }
        }

        .form-group-premium {
            margin-bottom: 1.5rem;
        }

        .label-premium {
            font-size: 0.65rem;
            font-weight: 900;
            color: var(--slate-400);
            text-transform: uppercase;
            letter-spacing: 1.5px;
            margin-bottom: 0.75rem;
            display: block;
        }

        .input-premium {
            background: var(--slate-50);
            border: 2px solid transparent;
            border-radius: 18px;
            padding: 1rem 1.4rem;
            font-weight: 700;
            color: var(--slate-800);
            transition: all 0.3s;
            width: 100%;
            font-size: 0.95rem;
        }

        .input-premium:focus {
            background: #fff;
            border-color: var(--primary);
            box-shadow: 0 15px 40px rgba(0, 97, 242, 0.08);
            outline: none;
        }

        /* Role Buttons */
        .role-selector {
            display: flex;
            gap: 15px;
            margin-bottom: 2rem;
        }

        .role-btn {
            flex: 1;
            padding: 1.1rem;
            border-radius: 20px;
            border: 2px solid var(--slate-100);
            background: var(--slate-50);
            color: var(--slate-400);
            font-weight: 900;
            font-size: 0.75rem;
            text-transform: uppercase;
            letter-spacing: 1px;
            cursor: pointer;
            transition: all 0.3s;
            text-align: center;
        }

        .role-btn.active[data-role="Secretary"] {
            border-color: var(--success);
            color: var(--success);
            background: rgba(16, 185, 129, 0.05);
            box-shadow: 0 10px 20px rgba(16, 185, 129, 0.1);
        }

        .role-btn.active[data-role="Admin"] {
            border-color: var(--danger);
            color: var(--danger);
            background: rgba(239, 68, 68, 0.05);
            box-shadow: 0 10px 20px rgba(239, 68, 68, 0.1);
        }

        /* Dropdown */
        .dropdown-container {
            position: relative;
        }

        .custom-dropdown-trigger {
            background: var(--slate-50);
            border: 2px solid transparent;
            border-radius: 18px;
            padding: 1rem 1.4rem;
            font-weight: 700;
            color: var(--slate-800);
            cursor: pointer;
            display: flex;
            justify-content: space-between;
            align-items: center;
            transition: all 0.3s;
            font-size: 0.95rem;
        }

        .custom-dropdown-trigger.active {
            background: #fff;
            border-color: var(--primary);
            box-shadow: 0 15px 40px rgba(0, 97, 242, 0.08);
        }

        .dropdown-menu-custom {
            position: absolute;
            top: calc(100% + 10px);
            left: 0;
            width: 100%;
            background: #fff;
            border-radius: 22px;
            box-shadow: 0 20px 50px rgba(15, 23, 42, 0.15);
            border: 1px solid var(--slate-100);
            z-index: 1000;
            padding: 10px;
            display: none;
            max-height: 250px;
            overflow-y: auto;
        }

        .dropdown-menu-custom.show {
            display: block;
            animation: slideUp 0.3s ease;
        }

        .dropdown-item-custom {
            padding: 12px 18px;
            border-radius: 14px;
            font-weight: 700;
            font-size: 0.9rem;
            color: var(--slate-800);
            cursor: pointer;
            transition: 0.2s;
        }

        .dropdown-item-custom:hover {
            background: var(--slate-50);
            color: var(--primary);
        }

        .dropdown-item-custom.selected {
            background: rgba(0, 97, 242, 0.05);
            color: var(--primary);
        }

        .submit-btn-premium {
            background: var(--slate-900);
            color: #fff;
            border: none;
            border-radius: 20px;
            padding: 1.25rem;
            font-weight: 900;
            font-size: 0.9rem;
            text-transform: uppercase;
            letter-spacing: 1.5px;
            width: 100%;
            margin-top: 2rem;
            transition: all 0.3s;
            box-shadow: 0 15px 35px rgba(15, 23, 42, 0.2);
            cursor: pointer;
        }

        .submit-btn-premium:hover {
            transform: translateY(-3px);
            background: var(--success);
            box-shadow: 0 20px 45px rgba(16, 185, 129, 0.25);
        }

        .auth-footer {
            text-align: center;
            margin-top: 3rem;
            padding-top: 2rem;
            border-top: 1px solid var(--slate-50);
            font-size: 0.85rem;
            color: var(--slate-400);
            font-weight: 700;
        }

        .auth-footer a {
            color: var(--slate-900);
            text-decoration: none;
            font-weight: 900;
            margin-left: 5px;
            transition: 0.2s;
        }

        .auth-footer a:hover {
            color: var(--success);
        }

        .validation-errors {
            background: #fff5f5;
            color: var(--danger);
            padding: 1.25rem;
            border-radius: 20px;
            font-size: 0.8rem;
            font-weight: 700;
            margin-bottom: 2rem;
            border: 1px solid #fee2e2;
        }

        .validation-errors ul {
            margin: 0;
            padding-left: 1.25rem;
        }

        @@keyframes slideUp {
            from { opacity: 0; transform: translateY(30px); }
            to { opacity: 1; transform: translateY(0); }
        }

        @@keyframes fadeIn {
            from { opacity: 0; }
            to { opacity: 1; }
        }
    </style>
</head>
<body>
    <div class="auth-container">
        <div class="auth-card">
            <div class="brand-section">
                <div class="brand-logo">QN</div>
                <h2>Tạo tài khoản <span>mới</span></h2>
                <p>THAM GIA CỘNG ĐỒNG QUẢN LÝ THÔNG MINH</p>
            </div>

            <form asp-controller="Account" asp-action="Register" method="post" enctype="multipart/form-data">
                @if (!ViewData.ModelState.IsValid)
                {
                    <div asp-validation-summary="All" class="validation-errors"></div>
                }
                
                <div class="avatar-upload-wrapper">
                    <div class="avatar-preview-box" onclick="document.getElementById('avatarInput').click()">
                        <img id="previewImg" src="#" style="display: none;">
                        <i id="previewIcon" class="fas fa-camera"></i>
                    </div>
                    <span class="avatar-hint">Ảnh đại diện (Tùy chọn)</span>
                    <input asp-for="Avatar" type="file" id="avatarInput" class="d-none" accept="image/*" onchange="previewFile(this)" />
                </div>

                <div class="form-group-premium">
                    <label class="label-premium">VAI TRÒ HỆ THỐNG</label>
                    <div class="role-selector">
                        <input type="radio" asp-for="Role" value="Secretary" id="roleSecretary" class="d-none" checked onchange="handleRoleChange('Secretary')">
                        <label for="roleSecretary" id="labelSecretary" class="role-btn active" data-role="Secretary">BÍ THƯ</label>

                        <input type="radio" asp-for="Role" value="Admin" id="roleAdmin" class="d-none" onchange="handleRoleChange('Admin')">
                        <label for="roleAdmin" id="labelAdmin" class="role-btn" data-role="Admin">QUẢN TRỊ VIÊN</label>
                    </div>
                </div>

                <div id="adminCodeSection" class="form-group-premium" style="display: none; animation: fadeIn 0.4s ease;">
                    <label class="label-premium" style="color: var(--danger);">MÃ XÁC NHẬN QUẢN TRỊ</label>
                    <input asp-for="AdminCode" type="password" class="input-premium" placeholder="Nhập mã bí mật cấp cao..." style="border-color: rgba(239, 68, 68, 0.1);" />
                </div>

                <div id="unitSection" class="form-group-premium" style="animation: fadeIn 0.4s ease;">
                    <label class="label-premium">ĐƠN VỊ CÔNG TÁC</label>
                    <div class="dropdown-container">
                        <input type="hidden" asp-for="UnitId" id="UnitIdInput" />
                        <div class="custom-dropdown-trigger" id="unitDropdownTrigger">
                            <span id="unitSelectedText">-- Chọn đơn vị chi đoàn --</span>
                            <i class="fas fa-chevron-down" style="color: var(--slate-200); font-size: 0.8rem;"></i>
                        </div>
                        <div class="dropdown-menu-custom" id="unitDropdownMenu">
                            <div class="dropdown-item-custom" data-value="">-- Chọn đơn vị --</div>
                            @if (ViewBag.Units != null)
                            {
                                foreach (var unit in (IEnumerable<QLDV.Models.Unit>)ViewBag.Units)
                                {
                                    <div class="dropdown-item-custom" data-value="@unit.Id">@unit.Name</div>
                                }
                            }
                        </div>
                    </div>
                </div>

                <div class="form-group-premium">
                    <label class="label-premium">HỌ VÀ TÊN</label>
                    <input asp-for="FullName" class="input-premium" placeholder="VD: Nguyễn Quốc Gia Huy" required />
                </div>

                <div class="form-group-premium">
                    <label class="label-premium">ĐỊA CHỈ EMAIL</label>
                    <input asp-for="Email" class="input-premium" placeholder="name@example.com" required />
                </div>

                <div class="form-row-premium">
                    <div>
                        <label class="label-premium">MẬT KHẨU</label>
                        <input asp-for="Password" type="password" class="input-premium" placeholder="••••••••" required />
                    </div>
                    <div>
                        <label class="label-premium">XÁC NHẬN</label>
                        <input asp-for="ConfirmPassword" type="password" class="input-premium" placeholder="••••••••" required />
                    </div>
                </div>

                <button type="submit" class="submit-btn-premium">
                    ĐĂNG KÝ TÀI KHOẢN <i class="fas fa-user-plus ms-2" style="font-size: 0.8rem;"></i>
                </button>
            </form>

            <div class="auth-footer">
                Đã có tài khoản? <a href="/Account/Login">Đăng nhập tại đây</a>
            </div>
        </div>
    </div>

    <script>
        function handleRoleChange(role) {
            const adminSection = document.getElementById('adminCodeSection');
            const unitSection = document.getElementById('unitSection');
            const lSec = document.getElementById('labelSecretary');
            const lAdm = document.getElementById('labelAdmin');

            if (role === 'Admin') {
                adminSection.style.display = 'block';
                unitSection.style.display = 'none';
                lAdm.classList.add('active');
                lSec.classList.remove('active');
            } else {
                adminSection.style.display = 'none';
                unitSection.style.display = 'block';
                lSec.classList.add('active');
                lAdm.classList.remove('active');
            }
        }

        // Custom Dropdown Logic
        document.addEventListener('DOMContentLoaded', function() {
            const trigger = document.getElementById('unitDropdownTrigger');
            const menu = document.getElementById('unitDropdownMenu');
            const input = document.getElementById('UnitIdInput');
            const text = document.getElementById('unitSelectedText');

            if (trigger && menu) {
                trigger.addEventListener('click', function(e) {
                    e.stopPropagation();
                    menu.classList.toggle('show');
                    trigger.classList.toggle('active');
                });

                const items = menu.querySelectorAll('.dropdown-item-custom');
                items.forEach(item => {
                    item.addEventListener('click', function() {
                        const val = this.getAttribute('data-value');
                        const label = this.textContent.trim();
                        input.value = val;
                        text.textContent = label;
                        items.forEach(i => i.classList.remove('selected'));
                        this.classList.add('selected');
                        menu.classList.remove('show');
                        trigger.classList.remove('active');
                    });
                });

                document.addEventListener('click', function() {
                    menu.classList.remove('show');
                    trigger.classList.remove('active');
                });
            }
        });

        function previewFile(input) {
            var file = input.files[0];
            if (file) {
                var reader = new FileReader();
                reader.onload = function(e) {
                    document.getElementById('previewImg').src = e.target.result;
                    document.getElementById('previewImg').style.display = 'block';
                    document.getElementById('previewIcon').style.display = 'none';
                };
                reader.readAsDataURL(file);
            }
        }
    </script>
</body>
</html>
