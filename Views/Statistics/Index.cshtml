@{
    ViewData["Title"] = "Statistics";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="content-header">
    <h1><i class="fas fa-chart-bar"></i> Statistics & Analytics</h1>
    <p class="text-muted">View comprehensive statistics about members and activities</p>
</div>

<div class="row">
    <div class="col-md-6">
        <div class="card">
            <div class="card-header">
                <i class="fas fa-chart-doughnut"></i> Members by Status
            </div>
            <div class="card-body">
                <canvas id="statusChart" height="300"></canvas>
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="card">
            <div class="card-header">
                <i class="fas fa-venus-mars"></i> Members by Gender
            </div>
            <div class="card-body">
                <canvas id="genderChart" height="300"></canvas>
            </div>
        </div>
    </div>
</div>

<div class="row mt-4">
    <div class="col-md-6">
        <div class="card">
            <div class="card-header">
                <i class="fas fa-star"></i> Members by Achievement Level
            </div>
            <div class="card-body">
                <canvas id="achievementChart" height="300"></canvas>
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="card">
            <div class="card-header">
                <i class="fas fa-building"></i> Members by Unit
            </div>
            <div class="card-body">
                <canvas id="unitChart" height="300"></canvas>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js@3.7.0/dist/chart.min.js"></script>
    <script>
        // Load statistics
        fetch('/statistics/getstatistics')
            .then(response => response.json())
            .then(data => {
                // Status Chart
                const statusCtx = document.getElementById('statusChart').getContext('2d');
                new Chart(statusCtx, {
                    type: 'doughnut',
                    data: {
                        labels: Object.keys(data.membersByStatus || {}),
                        datasets: [{
                            data: Object.values(data.membersByStatus || {}),
                            backgroundColor: ['#0056b3', '#28a745', '#ffc107', '#dc3545']
                        }]
                    },
                    options: { responsive: true, plugins: { legend: { position: 'bottom' } } }
                });

                // Gender Chart
                const genderCtx = document.getElementById('genderChart').getContext('2d');
                new Chart(genderCtx, {
                    type: 'pie',
                    data: {
                        labels: Object.keys(data.membersByGender || {}),
                        datasets: [{
                            data: Object.values(data.membersByGender || {}),
                            backgroundColor: ['#ff6b6b', '#4ecdc4', '#95e1d3']
                        }]
                    },
                    options: { responsive: true, plugins: { legend: { position: 'bottom' } } }
                });

                // Achievement Chart
                const achievementCtx = document.getElementById('achievementChart').getContext('2d');
                new Chart(achievementCtx, {
                    type: 'bar',
                    data: {
                        labels: Object.keys(data.membersByAchievement || {}),
                        datasets: [{
                            label: 'Count',
                            data: Object.values(data.membersByAchievement || {}),
                            backgroundColor: '#0056b3'
                        }]
                    },
                    options: {
                        responsive: true,
                        scales: { y: { beginAtZero: true } },
                        plugins: { legend: { display: false } }
                    }
                });

                // Unit Chart
                const unitChart = document.getElementById('unitChart').getContext('2d');
                const unitData = data.membersByUnit || [];
                new Chart(unitChart, {
                    type: 'bar',
                    data: {
                        labels: unitData.map(u => u.unit),
                        datasets: [{
                            label: 'Members',
                            data: unitData.map(u => u.count),
                            backgroundColor: '#0056b3'
                        }]
                    },
                    options: {
                        indexAxis: 'y',
                        responsive: true,
                        scales: { x: { beginAtZero: true } },
                        plugins: { legend: { display: false } }
                    }
                });
            });
    </script>
}
