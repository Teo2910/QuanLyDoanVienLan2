@model QLDV.Models.KnowledgeItem
@{
    ViewData["Title"] = "Knowledge Item Details";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="content-header">
    <div class="d-flex justify-content-between align-items-center">
        <div>
            <h1><i class="fas fa-book"></i> @Model.Title</h1>
            <p class="text-muted">
                @if (!string.IsNullOrEmpty(Model.Category))
                {
                    <span class="badge bg-secondary">@Model.Category</span>
                }
                Updated: @(new DateTime(Model.UpdatedAt, DateTimeKind.Utc).ToString("g"))
            </p>
        </div>
        <div>
            <a href="/knowledgebase/edit/@Model.Id" class="btn btn-primary">
                <i class="fas fa-edit"></i> Edit
            </a>
            <a href="/knowledgebase" class="btn btn-secondary">
                <i class="fas fa-arrow-left"></i> Back to List
            </a>
        </div>
    </div>
</div>

<div class="card">
    <div class="card-body">
        <div class="knowledge-content">
            @Html.Raw(Model.Content?.Replace("\n", "<br />"))
        </div>
    </div>
</div>
