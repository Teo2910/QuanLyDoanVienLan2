@model List<QLDV.Models.KnowledgeItem>
@{
    ViewData["Title"] = "Tài liệu Nghiệp vụ";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Styles {
    <style>
        .kb-layout-container {
            padding: 0 1rem;
            animation: fadeIn 0.5s ease;
        }

        .kb-style-card {
            background: #fff;
            border-radius: 45px;
            padding: 4rem;
            box-shadow: 0 30px 80px rgba(0,0,0,0.02);
            border: 1px solid #f8fafc;
            min-height: calc(100vh - 250px);
            display: flex;
            flex-direction: column;
            position: relative;
        }

        @@media (max-width: 991px) {
            .kb-style-card {
                padding: 2.5rem 1.5rem;
                border-radius: 30px;
            }
        }

        .kb-header {
            margin-bottom: 3.5rem;
            display: flex;
            justify-content: space-between;
            align-items: center;
            border-bottom: 2px solid #f8fafc;
            padding-bottom: 2.5rem;
        }

        @@media (max-width: 768px) {
            .kb-header {
                flex-direction: column;
                align-items: flex-start;
                gap: 25px;
            }
        }

        .kb-title h2 {
            font-weight: 900;
            font-size: 2.2rem;
            color: #0f172a;
            letter-spacing: -1.5px;
            margin: 0;
            display: flex;
            align-items: center;
            gap: 20px;
        }

        .kb-title h2 i {
            color: var(--primary);
            background: rgba(0, 86, 179, 0.05);
            width: 60px;
            height: 60px;
            border-radius: 18px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.4rem;
        }

        @@media (max-width: 576px) {
            .kb-title h2 { font-size: 1.8rem; }
            .kb-title h2 i { width: 48px; height: 48px; font-size: 1.2rem; }
        }

        .kb-title p {
            color: #cbd5e1;
            font-size: 0.7rem;
            font-weight: 800;
            text-transform: uppercase;
            letter-spacing: 1.5px;
            margin: 12px 0 0 0;
        }

        .kb-actions {
            display: flex;
            gap: 15px;
            align-items: center;
            flex-wrap: wrap;
        }

        @@media (max-width: 768px) {
            .kb-actions { width: 100%; }
            .search-box { flex-grow: 1; }
        }

        .search-box {
            position: relative;
            min-width: 280px;
        }

        .search-box i {
            position: absolute;
            left: 20px;
            top: 50%;
            transform: translateY(-50%);
            color: #cbd5e1;
        }

        .search-box input {
            padding: 0.9rem 1.25rem 0.9rem 3.5rem;
            border-radius: 18px;
            border: 2px solid #f1f5f9;
            background: #f8fafc;
            width: 100%;
            font-weight: 700;
            font-size: 0.9rem;
            color: #1e293b;
            transition: all 0.3s;
            outline: none;
        }

        .search-box input:focus {
            background: #fff;
            border-color: var(--primary);
            box-shadow: 0 10px 30px rgba(0, 86, 179, 0.05);
        }

        .add-btn {
            background: #0f172a;
            color: white;
            padding: 0.9rem 2rem;
            border-radius: 18px;
            font-weight: 900;
            font-size: 0.8rem;
            text-transform: uppercase;
            letter-spacing: 1px;
            display: flex;
            align-items: center;
            gap: 12px;
            transition: all 0.3s;
            text-decoration: none;
            box-shadow: 0 10px 25px rgba(15, 23, 42, 0.2);
        }

        .add-btn:hover {
            background: var(--primary);
            color: white;
            transform: translateY(-3px);
            box-shadow: 0 15px 35px rgba(0, 86, 179, 0.3);
        }

        @@media (max-width: 576px) {
            .add-btn { width: 100%; justify-content: center; }
        }

        /* Card Grid */
        .kb-card {
            background: #fff;
            border-radius: 35px;
            padding: 2.5rem;
            height: 100%;
            border: 1px solid #f8fafc;
            box-shadow: 0 15px 40px rgba(0,0,0,0.02);
            transition: all 0.4s cubic-bezier(0.165, 0.84, 0.44, 1);
            position: relative;
            display: flex;
            flex-direction: column;
        }

        .kb-card:hover {
            transform: translateY(-10px);
            border-color: var(--primary);
            box-shadow: 0 30px 70px rgba(0, 86, 179, 0.08);
        }

        .kb-card-icon {
            width: 56px;
            height: 56px;
            background: #f8fafc;
            border-radius: 16px;
            display: flex;
            align-items: center;
            justify-content: center;
            color: #0f172a;
            font-size: 1.4rem;
            margin-bottom: 2rem;
            transition: all 0.3s;
        }

        .kb-card:hover .kb-card-icon {
            background: var(--primary);
            color: #fff;
            transform: scale(1.1) rotate(-5deg);
        }

        .kb-card-actions {
            position: absolute;
            top: 2.5rem;
            right: 2.5rem;
            display: flex;
            gap: 10px;
            opacity: 0;
            transform: translateX(10px);
            transition: all 0.3s;
        }

        .kb-card:hover .kb-card-actions {
            opacity: 1;
            transform: translateX(0);
        }

        .kb-action-btn {
            width: 40px;
            height: 40px;
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: all 0.2s;
            border: 1px solid #f1f5f9;
            background: #fff;
            color: #64748b;
        }

        .kb-action-btn:hover {
            transform: scale(1.1);
        }

        .btn-edit:hover { background: #eff6ff; color: var(--primary); border-color: var(--primary); }
        .btn-delete:hover { background: #fef2f2; color: #ef4444; border-color: #ef4444; }

        .kb-card-category {
            color: var(--primary);
            font-size: 0.65rem;
            font-weight: 900;
            text-transform: uppercase;
            letter-spacing: 1.5px;
            margin-bottom: 12px;
            display: block;
        }

        .kb-card-title {
            font-weight: 900;
            font-size: 1.5rem;
            color: #0f172a;
            margin-bottom: 15px;
            line-height: 1.3;
            display: block;
            text-decoration: none !important;
            letter-spacing: -0.5px;
        }

        .kb-card-content {
            color: #64748b;
            font-size: 1rem;
            line-height: 1.7;
            margin-bottom: 2.5rem;
            flex-grow: 1;
            display: -webkit-box;
            -webkit-line-clamp: 3;
            -webkit-box-orient: vertical;
            overflow: hidden;
            font-weight: 500;
        }

        .kb-card-footer {
            padding-top: 20px;
            border-top: 1px solid #f8fafc;
            color: #cbd5e1;
            font-size: 0.65rem;
            font-weight: 800;
            text-transform: uppercase;
            letter-spacing: 1px;
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .kb-card-footer i { font-size: 0.9rem; }

        .empty-state {
            background: #f8fafc;
            border-radius: 40px;
            padding: 8rem 2rem;
            text-align: center;
            border: 2px dashed #e2e8f0;
        }

        .empty-state-icon {
            width: 100px;
            height: 100px;
            background: #fff;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0 auto 2.5rem;
            color: #cbd5e1;
            font-size: 3rem;
            box-shadow: 0 15px 35px rgba(0,0,0,0.03);
        }

        .empty-state h4 {
            font-weight: 900;
            color: #0f172a;
            margin-bottom: 12px;
            font-size: 1.5rem;
        }

        .empty-state p {
            max-width: 400px;
            margin: 0 auto;
            color: #94a3b8;
            font-weight: 600;
        }

        @@keyframes fadeIn {
            from { opacity: 0; transform: translateY(20px); }
            to { opacity: 1; transform: translateY(0); }
        }
    </style>
}

<div id="kbModal" class="modal-overlay">
    <div class="modal-content-wrapper" style="max-width: 900px;">
        <div id="modalBody"></div>
    </div>
</div>

<div class="kb-layout-container">
    <div class="kb-style-card">
        <div class="kb-header">
            <div class="kb-title">
                <h2>
                    <i class="fas fa-layer-group"></i>
                    Thư viện <span>Nghiệp vụ</span>
                </h2>
                <p>HỆ THỐNG QUẢN LÝ KIẾN THỨC VÀ ĐÀO TẠO ĐOÀN VIÊN</p>
            </div>
            
            <div class="kb-actions">
                <div class="search-box">
                    <i class="fas fa-search"></i>
                    <input type="text" id="searchInput" placeholder="Tra cứu tài liệu...">
                </div>
                
                <a href="javascript:void(0)" onclick="openKBModal('/knowledgebase/create')" class="add-btn">
                    <i class="fas fa-plus"></i> THÊM MỚI
                </a>
            </div>
        </div>

        @if ((Model?.Count ?? 0) > 0)
        {
            <div class="row g-4" id="knowledgeList">
                @foreach (var item in (Model ?? new List<QLDV.Models.KnowledgeItem>()).OrderByDescending(k => k.UpdatedAt))
                {
                    <div class="col-xl-4 col-md-6 knowledge-card-wrapper" data-category="@item.Category">
                        <div class="kb-card">
                            <div class="kb-card-icon">
                                <i class="fas fa-file-signature"></i>
                            </div>
                            
                            <div class="kb-card-actions">
                                <a href="javascript:void(0)" onclick="openKBModal('/knowledgebase/edit/@item.Id')" class="kb-action-btn btn-edit" title="Chỉnh sửa">
                                    <i class="fas fa-pen"></i>
                                </a>
                                <button class="kb-action-btn btn-delete" onclick="deleteItem('@item.Id')" title="Xóa">
                                    <i class="fas fa-trash-alt"></i>
                                </button>
                            </div>

                            <span class="kb-card-category">@(string.IsNullOrEmpty(item.Category) ? "NGHIỆP VỤ ĐOÀN" : item.Category.ToUpper())</span>
                            
                            <a href="javascript:void(0)" onclick="openKBModal('/knowledgebase/details/@item.Id')" class="kb-card-title">@item.Title</a>
                            
                            <div class="kb-card-content">
                                @item.Content
                            </div>
                            
                            <div class="kb-card-footer">
                                <i class="far fa-clock"></i>
                                CẬP NHẬT: @(new DateTime(item.UpdatedAt, DateTimeKind.Utc).ToString("dd/MM/yyyy"))
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="empty-state">
                <div class="empty-state-icon">
                    <i class="fas fa-folder-open"></i>
                </div>
                <h4>Chưa có tài liệu nào</h4>
                <p>Bắt đầu xây dựng kho tri thức bằng cách thêm tài liệu nghiệp vụ đầu tiên.</p>
                <div class="d-flex justify-content-center mt-5">
                    <a href="javascript:void(0)" onclick="openKBModal('/knowledgebase/create')" class="add-btn">
                        <i class="fas fa-plus"></i> THÊM TÀI LIỆU ĐẦU TIÊN
                    </a>
                </div>
            </div>
        }
    </div>
</div>

@section Scripts {
    <script>
        function deleteItem(itemId) {
            if (confirm('Bạn có chắc chắn muốn xóa tài liệu này?')) {
                fetch(`/knowledgebase/delete?id=${itemId}`, { method: 'POST' })
                    .then(response => response.ok ? location.reload() : alert('Lỗi khi xóa tài liệu'));
            }
        }

        document.getElementById('searchInput').addEventListener('keyup', function() {
            const filter = this.value.toLowerCase();
            document.querySelectorAll('.knowledge-card-wrapper').forEach(card => {
                const text = card.textContent.toLowerCase();
                card.style.display = text.includes(filter) ? '' : 'none';
            });
        });

        // Modal Logic
        const modal = document.getElementById('kbModal');
        modal.addEventListener('click', function(e) {
            if (e.target === modal) {
                closeKBModal();
            }
        });

        window.openKBModal = function(url) {
            const body = document.getElementById('modalBody');
            body.innerHTML = '<div class="text-center py-5"><div class="spinner-border text-primary"></div><p class="mt-3 fw-bold text-dark">ĐANG TRUY XUẤT...</p></div>';
            modal.classList.add('show');
            document.body.style.overflow = 'hidden';

            fetch(url)
                .then(response => response.text())
                .then(html => {
                    const parser = new DOMParser();
                    const doc = parser.parseFromString(html, 'text/html');
                    
                    if (!doc || !doc.body) {
                        throw new Error('Response error');
                    }

                    const content = doc.querySelector('.form-layout-container') || doc.querySelector('.modal-layout-container') || doc.body;
                    
                    body.innerHTML = '';
                    if (doc.querySelectorAll) {
                        doc.querySelectorAll('style').forEach(s => body.appendChild(s.cloneNode(true)));
                    }
                    body.insertAdjacentHTML('beforeend', content.outerHTML);

                    // Execute scripts
                    if (doc.querySelectorAll) {
                        doc.querySelectorAll('script').forEach(oldScript => {
                            const src = oldScript.getAttribute('src') || '';
                            if (src.includes('jquery') || src.includes('bootstrap') || src.includes('signalr')) return;

                            const newScript = document.createElement('script');
                            Array.from(oldScript.attributes).forEach(attr => newScript.setAttribute(attr.name, attr.value));
                            newScript.appendChild(document.createTextNode(oldScript.innerHTML));
                            body.appendChild(newScript);
                        });
                    }

                    initializeKBModalScripts();
                })
                .catch(error => {
                    console.error('Modal error:', error);
                    body.innerHTML = '<div class="alert alert-danger">Lỗi khi tải: ' + error.message + '</div>';
                });
        };

        window.closeKBModal = function() {
            modal.classList.remove('show');
            document.body.style.overflow = '';
            setTimeout(() => {
                document.getElementById('modalBody').innerHTML = '';
            }, 300);
        };

        function initializeKBModalScripts() {
            const closeBtn = document.querySelector('#modalBody .close-form-btn, #modalBody .close-modal-btn, #modalBody .btn-back, #modalBody .btn-cancel');
            if (closeBtn) {
                closeBtn.href = 'javascript:void(0)';
                closeBtn.onclick = (e) => {
                    e.preventDefault();
                    closeKBModal();
                };
            }

            const editLink = document.querySelector('#modalBody .btn-edit-main');
            if (editLink) {
                const url = editLink.getAttribute('href');
                if (url && url.includes('/edit/')) {
                    editLink.href = 'javascript:void(0)';
                    editLink.onclick = (e) => {
                        e.preventDefault();
                        openKBModal(url);
                    };
                }
            }

            const form = document.querySelector('#modalBody form');
            if (form) {
                form.onsubmit = function(e) {
                    e.preventDefault();
                    const formData = new FormData(form);
                    const url = form.getAttribute('action');

                    fetch(url, {
                        method: 'POST',
                        body: formData,
                        headers: { 'X-Requested-With': 'XMLHttpRequest' }
                    })
                    .then(response => {
                        if (response.redirected) {
                            location.reload();
                            return;
                        }
                        return response.text();
                    })
                    .then(html => {
                        if (html) {
                            const parser = new DOMParser();
                            const doc = parser.parseFromString(html, 'text/html');
                            const content = doc.querySelector('.form-layout-container') || doc.querySelector('.modal-layout-container') || doc.body;
                            if (content) {
                                document.getElementById('modalBody').innerHTML = content.innerHTML;
                                if (doc.querySelectorAll) {
                                    doc.querySelectorAll('style').forEach(s => document.getElementById('modalBody').appendChild(s.cloneNode(true)));
                                }
                                initializeKBModalScripts();
                            }
                        }
                    });
                };
            }
        }
    </script>
}
