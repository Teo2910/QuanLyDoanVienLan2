@model QLDV.Models.Document
@{
    ViewData["Title"] = "Chi tiết văn bản";
    bool isAdmin = ViewBag.IsAdmin ?? false;
    var stats = ViewBag.Stats as Dictionary<string, int>;
}

<div class="row g-4">
    <div class="col-lg-8">
        <!-- Main Document Viewer -->
        <div class="card-premium mb-4" style="min-height: 600px; padding: 3rem !important;">
            <div class="d-flex justify-content-between align-items-center mb-5">
                <div class="d-flex gap-2">
                    <a href="/Documents" class="btn-back-premium">
                        <i class="fas fa-chevron-left"></i> QUAY LẠI
                    </a>
                    @if (isAdmin)
                    {
                        <a href="/Documents/Edit/@Model.Id" class="btn-edit-premium">
                            <i class="fas fa-edit"></i> CHỈNH SỬA
                        </a>
                    }
                </div>
                <div class="document-badge-v2">@Model.Category?.Name</div>
            </div>

            <div class="document-header-v2 mb-5">
                <h1 class="document-title-v2">@Model.Title</h1>
                
                <div class="document-meta-v2">
                    <div class="meta-pill">
                        <i class="fas fa-user-circle"></i>
                        <span>Người gửi: <strong>@Model.Sender?.FullName</strong></span>
                    </div>
                    <div class="meta-pill">
                        <i class="far fa-calendar-alt"></i>
                        <span>Phát hành: <strong>@DateTimeOffset.FromUnixTimeMilliseconds(Model.CreatedAt).ToString("dd/MM/yyyy HH:mm")</strong></span>
                    </div>
                </div>
            </div>

            <div class="document-body-content mb-5">
                @Html.Raw(Model.Content?.Replace("\n", "<br/>") ?? "")
            </div>

            @if (!string.IsNullOrEmpty(Model.FileUrl))
            {
                <div class="attachment-premium-v2">
                    <div class="d-flex align-items-center gap-3 flex-grow-1">
                        <div class="file-v2-icon">
                            <i class="fas fa-file-pdf"></i>
                        </div>
                        <div class="file-v2-info">
                            <div class="name">@Model.FileName</div>
                            <div class="size">Tài liệu văn bản đính kèm</div>
                        </div>
                    </div>
                    <a href="@Model.FileUrl" class="btn-download-v2" target="_blank">
                        <i class="fas fa-arrow-down"></i> TẢI TÀI LIỆU
                    </a>
                </div>
            }
        </div>
    </div>

    <div class="col-lg-4">
        <!-- Side Info & Actions -->
        @if (!isAdmin)
        {
            <div class="card-premium mb-4 sticky-top" style="top: 20px;">
                <div class="action-header mb-4">
                    <div class="icon-box">
                        <i class="fas fa-tasks"></i>
                    </div>
                    <div>
                        <h5 class="fw-bold mb-0">Xử lý văn bản</h5>
                        <p class="text-muted small mb-0">Cập nhật tiến độ của đơn vị</p>
                    </div>
                </div>

                @if (Model.Deadline.HasValue)
                {
                    <div class="deadline-panel mb-4 @(Model.Deadline < DateTimeOffset.UtcNow.ToUnixTimeMilliseconds() ? "overdue" : "")">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <span class="label">HẠN XỬ LÝ</span>
                            <i class="far fa-clock"></i>
                        </div>
                        <div class="date">@DateTimeOffset.FromUnixTimeMilliseconds(Model.Deadline.Value).ToString("dd/MM/yyyy")</div>
                        @if (Model.Deadline < DateTimeOffset.UtcNow.ToUnixTimeMilliseconds())
                        {
                            <div class="warning-tag mt-2">QUÁ HẠN XỬ LÝ</div>
                        }
                    </div>
                }

                <form asp-action="UpdateStatus" method="post">
                    <input type="hidden" name="documentId" value="@Model.Id" />
                    
                    <label class="premium-label-small mb-3">TRẠNG THÁI HIỆN TẠI</label>
                    <div class="status-selector-premium mb-4">
                        <div class="status-card-option">
                            <input type="radio" name="status" value="Seen" id="statusSeen" class="status-card-input" required>
                            <label for="statusSeen" class="status-card-label">
                                <div class="card-icon">
                                    <i class="fas fa-eye"></i>
                                </div>
                                <span>Đã xem</span>
                                <div class="check-mark"><i class="fas fa-check-circle"></i></div>
                            </label>
                        </div>
                        <div class="status-card-option">
                            <input type="radio" name="status" value="Processed" id="statusProcessed" class="status-card-input">
                            <label for="statusProcessed" class="status-card-label">
                                <div class="card-icon">
                                    <i class="fas fa-check-double"></i>
                                </div>
                                <span>Hoàn thành</span>
                                <div class="check-mark"><i class="fas fa-check-circle"></i></div>
                            </label>
                        </div>
                    </div>

                    <div class="mb-4">
                        <label class="premium-label-small mb-3">PHẢN HỒI / KẾT QUẢ THỰC HIỆN</label>
                        <div class="textarea-wrapper">
                            <textarea name="feedback" class="custom-textarea-premium w-100" placeholder="Nhập ý kiến phản hồi hoặc kết quả chi tiết..."></textarea>
                            <div class="textarea-decoration"></div>
                        </div>
                    </div>

                    <button type="submit" class="btn-premium-action w-100">
                        <span>CẬP NHẬT TIẾN ĐỘ</span>
                        <i class="fas fa-paper-plane"></i>
                    </button>
                </form>
            </div>
        }
        else
        {
            <div class="card-premium mb-4">
                <h5 class="fw-bold mb-4">Thống kê tiếp nhận</h5>
                <div class="stats-grid-v2">
                    <div class="stat-item-v2">
                        <div class="label">ĐÃ GỬI</div>
                        <div class="value">@stats?["Total"]</div>
                    </div>
                    <div class="stat-item-v2">
                        <div class="label">ĐÃ XEM</div>
                        <div class="value text-primary">@stats?["Seen"]</div>
                    </div>
                    <div class="stat-item-v2">
                        <div class="label">HOÀN THÀNH</div>
                        <div class="value text-success">@stats?["Processed"]</div>
                    </div>
                    <div class="stat-item-v2">
                        <div class="label">CHƯA XEM</div>
                        <div class="value text-danger">@(stats?["Total"] - stats?["Seen"])</div>
                    </div>
                </div>
            </div>

            <div class="card-premium">
                <h5 class="fw-bold mb-4">Trạng thái từng đơn vị</h5>
                <div class="unit-tracking-list" style="max-height: 500px; overflow-y: auto;">
                    @if (Model.Distributions != null)
                    {
                        @foreach (var dist in Model.Distributions.OrderBy(d => d.Status))
                        {
                            <div class="tracking-item">
                                <div class="d-flex justify-content-between align-items-start mb-2">
                                    <div class="unit-name fw-bold small">@dist.Unit?.Name</div>
                                    <span class="status-badge-small @dist.Status.ToLower()">@dist.Status</span>
                                </div>
                                <div class="d-flex justify-content-between align-items-center">
                                    <span class="text-muted" style="font-size: 0.7rem;">
                                        @(dist.SeenAt.HasValue ? "Xem lúc: " + DateTimeOffset.FromUnixTimeMilliseconds(dist.SeenAt.Value).ToString("dd/MM HH:mm") : "Chưa xem")
                                    </span>
                                    <div class="tracking-actions">
                                        <button type="button" class="btn-chat-icon" title="Nhắn tin nhắc việc" onclick="window.openChatWidget('@dist.UnitId', '@dist.Unit?.Name')">
                                            <i class="fas fa-comment-alt"></i>
                                        </button>
                                    </div>
                                </div>
                            </div>
                        }
                    }
                </div>
            </div>
        }
    </div>
</div>

<style>
    /* Premium Back Button */
    .btn-back-premium {
        display: flex;
        align-items: center;
        gap: 8px;
        color: #64748b;
        font-weight: 700;
        font-size: 0.75rem;
        text-decoration: none;
        padding: 8px 16px;
        background: #f8fafc;
        border-radius: 12px;
        transition: all 0.2s;
    }
    .btn-back-premium:hover {
        background: #f1f5f9;
        color: var(--primary);
        transform: translateX(-4px);
    }
    
    .btn-edit-premium {
        display: flex;
        align-items: center;
        gap: 8px;
        color: var(--primary);
        font-weight: 700;
        font-size: 0.75rem;
        text-decoration: none;
        padding: 8px 16px;
        background: #f0f7ff;
        border-radius: 12px;
        transition: all 0.2s;
    }
    .btn-edit-premium:hover {
        background: var(--primary);
        color: #fff;
        transform: translateY(-2px);
    }

    /* Document Viewer Styles */
    .document-badge-v2 {
        background: #f0f7ff;
        color: var(--primary);
        padding: 6px 14px;
        border-radius: 10px;
        font-weight: 800;
        font-size: 0.65rem;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }
    .document-title-v2 {
        font-size: 2.2rem;
        font-weight: 900;
        color: #1a1a1a;
        line-height: 1.3;
        letter-spacing: -1px;
    }
    .document-meta-v2 {
        display: flex;
        gap: 20px;
        margin-top: 1.5rem;
    }
    .meta-pill {
        display: flex;
        align-items: center;
        gap: 8px;
        font-size: 0.8rem;
        color: #64748b;
        background: #f8fafc;
        padding: 6px 12px;
        border-radius: 20px;
    }
    .meta-pill i { color: #cbd5e1; }
    .meta-pill strong { color: #334155; }

    .document-body-content {
        font-size: 1.15rem;
        line-height: 1.8;
        color: #334155;
        border-top: 1px solid #f1f5f9;
        padding-top: 2.5rem;
    }

    /* Attachment Panel V2 */
    .attachment-premium-v2 {
        display: flex;
        align-items: center;
        justify-content: space-between;
        background: #f8fbff;
        border: 2px dashed #e2e8f0;
        padding: 20px 25px;
        border-radius: 24px;
        transition: all 0.2s;
    }
    .attachment-premium-v2:hover {
        border-color: var(--primary-light);
        background: #f0f7ff;
    }
    .file-v2-icon {
        width: 50px;
        height: 50px;
        background: #fff;
        border-radius: 16px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.5rem;
        color: #ef4444;
        box-shadow: 0 5px 15px rgba(0,0,0,0.05);
    }
    .file-v2-info .name {
        font-weight: 800;
        font-size: 0.95rem;
        color: #1e293b;
    }
    .file-v2-info .size {
        font-size: 0.75rem;
        color: #94a3b8;
        font-weight: 600;
    }
    .btn-download-v2 {
        background: #fff;
        color: var(--primary);
        font-weight: 800;
        font-size: 0.75rem;
        padding: 10px 20px;
        border-radius: 14px;
        text-decoration: none;
        display: flex;
        align-items: center;
        gap: 10px;
        box-shadow: 0 4px 10px rgba(0, 86, 179, 0.05);
        transition: all 0.2s;
    }
    .btn-download-v2:hover {
        background: var(--primary);
        color: #fff;
        transform: translateY(-2px);
    }

    /* Side Action Panel */
    .action-header {
        display: flex;
        align-items: center;
        gap: 15px;
    }
    .icon-box {
        width: 44px;
        height: 44px;
        background: #f0f7ff;
        color: var(--primary);
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.1rem;
    }
    .deadline-panel {
        background: #f8fafc;
        border-radius: 20px;
        padding: 18px;
        border: 1px solid #f1f5f9;
    }
    .deadline-panel.overdue {
        background: #fff5f5;
        border-color: #fee2e2;
    }
    .deadline-panel .label {
        font-size: 0.65rem;
        font-weight: 800;
        color: #94a3b8;
        letter-spacing: 0.5px;
    }
    .deadline-panel .date {
        font-size: 1.4rem;
        font-weight: 800;
        color: #1e293b;
    }
    .deadline-panel.overdue .date { color: #ef4444; }
    .warning-tag {
        font-size: 0.6rem;
        font-weight: 800;
        background: #ef4444;
        color: #fff;
        padding: 4px 10px;
        border-radius: 6px;
        display: inline-block;
    }

    .premium-label-small {
        font-size: 0.65rem;
        font-weight: 800;
        color: #94a3b8;
        letter-spacing: 1px;
        text-transform: uppercase;
        display: block;
    }

    /* Status Selector Premium V2 */
    .status-selector-premium {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 15px;
    }
    .status-card-input {
        display: none;
    }
    .status-card-label {
        background: #fff;
        border: 2px solid #f1f5f9;
        border-radius: 20px;
        padding: 1.5rem 1rem;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 12px;
        cursor: pointer;
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        position: relative;
        overflow: hidden;
    }
    .status-card-label .card-icon {
        width: 48px;
        height: 48px;
        background: #f8fafc;
        border-radius: 14px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.4rem;
        color: #cbd5e1;
        transition: all 0.3s;
    }
    .status-card-label span {
        font-weight: 800;
        font-size: 0.75rem;
        color: #64748b;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }
    .status-card-label .check-mark {
        position: absolute;
        top: 10px;
        right: 10px;
        color: var(--primary);
        font-size: 1.1rem;
        opacity: 0;
        transform: scale(0);
        transition: all 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);
    }
    .status-card-input:checked + .status-card-label {
        border-color: var(--primary);
        background: #fff;
        box-shadow: 0 15px 35px rgba(0, 86, 179, 0.1);
        transform: translateY(-5px);
    }
    .status-card-input:checked + .status-card-label .card-icon {
        background: var(--primary);
        color: #fff;
        box-shadow: 0 8px 20px rgba(0, 86, 179, 0.2);
    }
    .status-card-input:checked + .status-card-label span {
        color: var(--primary);
    }
    .status-card-input:checked + .status-card-label .check-mark {
        opacity: 1;
        transform: scale(1);
    }

    /* Premium Textarea */
    .textarea-wrapper {
        position: relative;
    }
    .custom-textarea-premium {
        background: #f8fbff;
        border: 2px solid #f1f5f9;
        border-radius: 20px;
        padding: 1.2rem;
        font-weight: 600;
        font-size: 0.95rem;
        color: #1e293b;
        transition: all 0.3s;
        resize: none;
        min-height: 150px;
    }
    .custom-textarea-premium::placeholder { color: #cbd5e1; }
    .custom-textarea-premium:focus {
        background: #fff;
        border-color: var(--primary);
        box-shadow: 0 15px 35px rgba(0, 86, 179, 0.08);
        outline: none;
    }

    /* Action Button V2 */
    .btn-premium-action {
        background: linear-gradient(135deg, var(--primary) 0%, #004494 100%);
        color: #fff;
        border: none;
        padding: 1.2rem;
        border-radius: 18px;
        font-weight: 800;
        font-size: 0.9rem;
        text-transform: uppercase;
        letter-spacing: 1.5px;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 12px;
        transition: all 0.3s;
        box-shadow: 0 10px 25px rgba(0, 86, 179, 0.2);
    }
    .btn-premium-action:hover {
        transform: translateY(-3px);
        box-shadow: 0 15px 35px rgba(0, 86, 179, 0.3);
        filter: brightness(1.1);
    }
    .btn-premium-action i {
        font-size: 1.1rem;
        transition: transform 0.3s;
    }
    .btn-premium-action:hover i {
        transform: translate(5px, -5px);
    }

    /* Admin View Components */
    .stats-grid-v2 {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 15px;
    }
    .stat-item-v2 {
        background: #f8fbff;
        padding: 15px;
        border-radius: 15px;
        text-align: center;
    }
    .stat-item-v2 .label {
        font-size: 0.65rem;
        font-weight: 800;
        color: #94a3b8;
        margin-bottom: 5px;
    }
    .stat-item-v2 .value {
        font-size: 1.25rem;
        font-weight: 800;
    }
    .unit-tracking-list {
        display: flex;
        flex-direction: column;
        gap: 12px;
    }
    .tracking-item {
        padding: 12px;
        background: #fff;
        border: 1px solid #f1f5f9;
        border-radius: 14px;
        transition: all 0.2s;
    }
    .tracking-item:hover {
        border-color: var(--primary-light);
        background: #fcfdfe;
    }
    .status-badge-small {
        font-size: 0.6rem;
        font-weight: 800;
        padding: 3px 8px;
        border-radius: 6px;
        text-transform: uppercase;
    }
    .status-badge-small.sent { background: #eee; color: #888; }
    .status-badge-small.seen { background: #e0f0ff; color: #007bff; }
    .status-badge-small.processed { background: #e6ffed; color: #28a745; }
    
    .btn-chat-icon {
        width: 32px;
        height: 32px;
        background: #f0f7ff;
        color: var(--primary);
        border-radius: 8px;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: all 0.2s;
        text-decoration: none;
    }
    .btn-chat-icon:hover {
        background: var(--primary);
        color: #fff;
    }
</style>
