@model QLDV.Models.Member
@{
    ViewData["Title"] = "Delete Member";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="content-header">
    <h1><i class="fas fa-trash"></i> Delete Member</h1>
    <p class="text-muted">Are you sure you want to delete this member?</p>
</div>

<div class="row">
    <div class="col-md-8">
        <div class="card border-danger">
            <div class="card-header bg-danger text-white">
                <i class="fas fa-exclamation-triangle"></i> Confirm Delete
            </div>
            <div class="card-body">
                <div class="alert alert-warning">
                    <strong>Warning:</strong> This action cannot be undone. All data associated with this member will be permanently deleted.
                </div>

                <div class="row mb-4">
                    <div class="col-md-6">
                        <h6>Full Name</h6>
                        <p class="fs-5">@Model.FullName</p>
                    </div>
                    <div class="col-md-6">
                        <h6>Member ID</h6>
                        <p class="fs-5">@Model.MemberId</p>
                    </div>
                </div>

                <div class="row mb-4">
                    <div class="col-md-6">
                        <h6>Email</h6>
                        <p>@Model.Email</p>
                    </div>
                    <div class="col-md-6">
                        <h6>Phone</h6>
                        <p>@Model.Phone</p>
                    </div>
                </div>

                <div class="row mb-4">
                    <div class="col-md-6">
                        <h6>Status</h6>
                        <span class="badge bg-primary fs-6">@Model.Status</span>
                    </div>
                    <div class="col-md-6">
                        <h6>Unit</h6>
                        <p>@Model.Unit?.Name</p>
                    </div>
                </div>

                <hr />

                <form method="post" action="/members/delete/@Model.Id">
                    <div class="form-check mb-3">
                        <input class="form-check-input" type="checkbox" id="confirmDelete" required>
                        <label class="form-check-label" for="confirmDelete">
                            I understand that this member will be permanently deleted
                        </label>
                    </div>

                    <button type="submit" class="btn btn-danger btn-lg">
                        <i class="fas fa-trash"></i> Delete Member
                    </button>
                    <a href="/members" class="btn btn-secondary btn-lg">
                        <i class="fas fa-times"></i> Cancel
                    </a>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.querySelector('form').addEventListener('submit', function(e) {
            if (!document.getElementById('confirmDelete').checked) {
                e.preventDefault();
                alert('Please confirm before deleting');
            }
        });
    </script>
}
