@model QLDV.Models.Member
@{
    ViewData["Title"] = "Member Details";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="content-header">
    <div class="d-flex justify-content-between align-items-center">
        <div>
            <h1><i class="fas fa-user"></i> Member Details</h1>
            <p class="text-muted">Details for @Model.FullName</p>
        </div>
        <div>
            <a href="/members/edit/@Model.Id" class="btn btn-primary">
                <i class="fas fa-edit"></i> Edit
            </a>
            <a href="/members" class="btn btn-secondary">
                <i class="fas fa-arrow-left"></i> Back to List
            </a>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-md-4">
        <div class="card">
            <div class="card-header">
                <i class="fas fa-info-circle"></i> Basic Information
            </div>
            <div class="card-body">
                <div class="text-center mb-4">
                    <div class="rounded-circle bg-light d-inline-flex align-items-center justify-content-center" style="width: 120px; height: 120px; font-size: 3rem; color: #0056b3;">
                        <i class="fas fa-user"></i>
                    </div>
                    <h3 class="mt-3">@Model.FullName</h3>
                    <p class="text-muted">@Model.MemberId</p>
                    <span class="badge bg-primary">@Model.Status</span>
                </div>
                <ul class="list-group list-group-flush">
                    <li class="list-group-item d-flex justify-content-between">
                        <strong>Gender</strong>
                        <span>@Model.Gender</span>
                    </li>
                    <li class="list-group-item d-flex justify-content-between">
                        <strong>Date of Birth</strong>
                        <span>@Model.DOB</span>
                    </li>
                    <li class="list-group-item d-flex justify-content-between">
                        <strong>Unit</strong>
                        <span>@Model.Unit?.Name</span>
                    </li>
                    <li class="list-group-item d-flex justify-content-between">
                        <strong>Join Date</strong>
                        <span>@Model.JoinDate</span>
                    </li>
                </ul>
            </div>
        </div>
    </div>
    <div class="col-md-8">
        <div class="card">
            <div class="card-header">
                <i class="fas fa-address-card"></i> Detailed Profile
            </div>
            <div class="card-body">
                <div class="row mb-3">
                    <div class="col-sm-4 font-weight-bold">Email:</div>
                    <div class="col-sm-8">@Model.Email</div>
                </div>
                <div class="row mb-3">
                    <div class="col-sm-4 font-weight-bold">Phone:</div>
                    <div class="col-sm-8">@Model.Phone</div>
                </div>
                <div class="row mb-3">
                    <div class="col-sm-4 font-weight-bold">Ethnic:</div>
                    <div class="col-sm-8">@Model.Ethnic</div>
                </div>
                <div class="row mb-3">
                    <div class="col-sm-4 font-weight-bold">Religion:</div>
                    <div class="col-sm-8">@Model.Religion</div>
                </div>
                <div class="row mb-3">
                    <div class="col-sm-4 font-weight-bold">Place of Birth:</div>
                    <div class="col-sm-8">@Model.PlaceOfBirth</div>
                </div>
                <div class="row mb-3">
                    <div class="col-sm-4 font-weight-bold">Hometown:</div>
                    <div class="col-sm-8">@Model.Hometown</div>
                </div>
                <div class="row mb-3">
                    <div class="col-sm-4 font-weight-bold">Permanent Address:</div>
                    <div class="col-sm-8">@Model.PermanentAddress</div>
                </div>
                <hr />
                <div class="row mb-3">
                    <div class="col-sm-4 font-weight-bold">Academic Year:</div>
                    <div class="col-sm-8">@Model.AcademicYear</div>
                </div>
                <div class="row mb-3">
                    <div class="col-sm-4 font-weight-bold">Professional Level:</div>
                    <div class="col-sm-8">@Model.ProfessionalLevel</div>
                </div>
                <div class="row mb-3">
                    <div class="col-sm-4 font-weight-bold">Position:</div>
                    <div class="col-sm-8">@Model.Position</div>
                </div>
                <div class="row mb-3">
                    <div class="col-sm-4 font-weight-bold">Achievement Level:</div>
                    <div class="col-sm-8">@Model.AchievementLevel</div>
                </div>
            </div>
        </div>

        <div class="card mt-4">
            <div class="card-header">
                <i class="fas fa-history"></i> Status History
            </div>
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-sm">
                        <thead>
                            <tr>
                                <th>Date</th>
                                <th>Old Status</th>
                                <th>New Status</th>
                                <th>Reason</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var history in Model.StatusHistory.OrderByDescending(h => h.Date))
                            {
                                <tr>
                                    <td>@DateTimeOffset.FromUnixTimeSeconds(history.Date).ToString("dd/MM/yyyy HH:mm")</td>
                                    <td>@history.OldStatus</td>
                                    <td>@history.NewStatus</td>
                                    <td>@history.Reason</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
