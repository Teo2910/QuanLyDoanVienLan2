@model QLDV.Models.Member
@{
    ViewData["Title"] = "Hồ sơ đoàn viên: " + Model.FullName;
    bool isAjax = Context.Request.Headers["X-Requested-With"] == "XMLHttpRequest";
    Layout = isAjax ? null : "~/Views/Shared/_Layout.cshtml";
}

<style>
    /* Profile Header */
    .profile-header {
        display: flex;
        align-items: center;
        gap: 30px;
        margin-bottom: 3.5rem;
    }

    .profile-avatar-box {
        width: 110px;
        height: 110px;
        background: #f0f7ff;
        border-radius: 35px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 2rem;
        font-weight: 700;
        color: var(--primary-color);
        box-shadow: 0 10px 25px rgba(0, 86, 179, 0.08);
    }

    .profile-title-box h1 {
        font-weight: 700;
        font-size: 1.8rem;
        letter-spacing: -1px;
        margin-bottom: 0.5rem;
        color: #1a1a1a;
        display: flex;
        align-items: center;
        gap: 20px;
    }

    .status-badge-header {
        font-size: 0.65rem;
        font-weight: 700;
        color: #ccc;
        background: #f8f9fa;
        padding: 5px 15px;
        border-radius: 20px;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        border: 1px solid #eee;
    }

    .profile-meta-info {
        display: flex;
        align-items: center;
        gap: 25px;
        font-size: 0.9rem;
        font-weight: 600;
        color: #999;
    }

    .meta-item {
        display: flex;
        align-items: center;
        gap: 8px;
    }

    /* Content Layout */
    .profile-main-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 50px;
        margin-bottom: 3rem;
    }

    .section-column-title {
        font-size: 0.8rem;
        font-weight: 700;
        color: var(--primary-color);
        text-transform: uppercase;
        letter-spacing: 1.5px;
        margin-bottom: 2rem;
        padding-bottom: 12px;
        border-bottom: 1.5px solid #f0f7ff;
    }

    .info-card-box {
        background: #f8fbff;
        border-radius: 24px;
        padding: 1.5rem 1.75rem;
        margin-bottom: 1.5rem;
        transition: all 0.2s;
    }

    .info-card-box:hover {
        background: #f0f7ff;
    }

    .info-card-label {
        font-size: 0.65rem;
        font-weight: 700;
        color: #ccc;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        margin-bottom: 8px;
    }

    .info-card-value {
        font-size: 0.95rem;
        font-weight: 600;
        color: #1a1a1a;
        line-height: 1.5;
    }

    /* Achievement Card */
    .achievement-card {
        background: #fffdf0;
        border: 1px solid #fff5d6;
        border-radius: 35px;
        padding: 2.5rem;
        position: relative;
        overflow: hidden;
        margin-top: 1rem;
    }

    .achievement-card i.star-bg {
        position: absolute;
        right: -15px;
        bottom: -15px;
        font-size: 3.5rem;
        color: #ffb400;
        opacity: 0.1;
    }

    .achievement-card .label {
        font-size: 0.7rem;
        font-weight: 700;
        color: #ffb400;
        text-transform: uppercase;
        margin-bottom: 12px;
        display: block;
    }

    .achievement-card .value {
        font-size: 1.5rem;
        font-weight: 700;
        color: #8a6d3b;
    }

    /* Footer Buttons */
    .profile-actions-footer {
        display: grid;
        grid-template-columns: 1fr 140px;
        gap: 20px;
        margin-top: 4rem;
    }

    .btn-main-action {
        background: var(--primary-color);
        color: #fff;
        border: none;
        border-radius: 20px;
        padding: 1.4rem;
        font-weight: 700;
        font-size: 0.95rem;
        text-transform: uppercase;
        letter-spacing: 1px;
        transition: all 0.2s;
        box-shadow: 0 10px 25px rgba(0, 86, 179, 0.2);
        text-decoration: none;
        text-align: center;
    }

    .btn-main-action:hover {
        transform: translateY(-3px);
        box-shadow: 0 15px 35px rgba(0, 86, 179, 0.3);
        color: #fff;
    }

    .btn-secondary-action {
        background: #fff;
        border: 1px solid #eee;
        color: #666;
        border-radius: 20px;
        padding: 1.4rem;
        font-weight: 700;
        font-size: 0.9rem;
        text-transform: uppercase;
        letter-spacing: 1px;
        transition: all 0.2s;
        text-decoration: none;
        text-align: center;
    }

    .btn-secondary-action:hover {
        background: #f8f9fa;
        color: #1a1a1a;
    }

    /* --- RESPONSIVE BREAKPOINTS --- */
    @@media (max-width: 991px) {
        .profile-main-grid {
            gap: 30px;
        }
    }

    @@media (max-width: 768px) {
        .profile-header {
            flex-direction: column;
            text-align: center;
            gap: 20px;
        }

        .profile-avatar-box {
            width: 80px;
            height: 80px;
            font-size: 2rem;
            border-radius: 25px;
            margin: 0 auto;
        }

        .profile-title-box h1 {
            font-size: 1.8rem;
            justify-content: center;
            flex-wrap: wrap;
            gap: 10px;
        }

        .profile-meta-info {
            justify-content: center;
            flex-wrap: wrap;
            gap: 15px;
            font-size: 0.8rem;
        }

        .profile-main-grid {
            grid-template-columns: 1fr;
            gap: 40px;
        }

        .section-column-title {
            margin-bottom: 1.5rem;
            font-size: 0.75rem;
        }

        .info-card-box {
            padding: 1.25rem;
            margin-bottom: 1rem;
        }

        .achievement-card {
            padding: 1.5rem;
            border-radius: 25px;
        }

        .achievement-card .value {
            font-size: 1.4rem;
        }

        .profile-actions-footer {
            grid-template-columns: 1fr;
            margin-top: 2rem;
            gap: 12px;
        }

        .btn-main-action, .btn-secondary-action {
            padding: 1.1rem;
            font-size: 0.85rem;
            border-radius: 16px;
        }
    }

    @@media (max-width: 576px) {
        .profile-title-box h1 {
            font-size: 1.5rem;
        }

        .info-card-value {
            font-size: 0.85rem;
        }

        .row [class*="col-"] {
            width: 100%;
            flex: 0 0 100%;
            max-width: 100%;
        }
    }
</style>

<div class="modal-layout-container">
    <a href="/members" class="close-modal-btn">
        <i class="fas fa-times"></i>
    </a>

    <div class="profile-header">
        <div class="profile-avatar-box">
            @Model.FullName[0]
        </div>
        <div class="profile-title-box">
            <h1>
                @Model.FullName
                <span class="status-badge-header">@Model.Status</span>
            </h1>
            <div class="profile-meta-info">
                <div class="meta-item"># @Model.MemberId</div>
                <div class="meta-item"><i class="fas fa-venus-mars"></i> @Model.Gender</div>
                <div class="meta-item"><i class="fas fa-map-marker-alt"></i> @(Model.Hometown ?? "Chưa cập nhật")</div>
            </div>
        </div>
    </div>

    <div class="profile-main-grid">
        <!-- Left Side: Học tập & Hoạt đoàn -->
        <div class="grid-column">
            <div class="section-column-title">HỌC TẬP & HOẠT ĐOÀN</div>
            
            <div class="info-card-box">
                <div class="info-card-label">CHI ĐOÀN & ĐƠN VỊ</div>
                <div class="info-card-value"><i>@(Model.Unit?.Name ?? "Chưa phân bổ")</i></div>
            </div>

            <div class="info-card-box">
                <div class="info-card-label">QUÊ QUÁN</div>
                <div class="info-card-value">@(Model.Hometown ?? "Chưa cập nhật")</div>
            </div>

            <div class="info-card-box">
                <div class="info-card-label">NƠI SINH & THƯỜNG TRÚ</div>
                <div class="info-card-value">@(Model.PlaceOfBirth ?? "Chưa cập nhật")</div>
            </div>

            <div class="info-card-box">
                <div class="info-card-label">ĐỊA CHỈ THƯỜNG TRÚ</div>
                <div class="info-card-value">@(Model.PermanentAddress ?? "Chưa cập nhật")</div>
            </div>

            <div class="row">
                <div class="col-6">
                    <div class="info-card-box">
                        <div class="info-card-label">DÂN TỘC & TÔN GIÁO</div>
                        <div class="info-card-value">@Model.Ethnic / @(Model.Religion ?? "Không")</div>
                    </div>
                </div>
                <div class="col-6">
                    <div class="info-card-box">
                        <div class="info-card-label">GIỚI TÍNH</div>
                        <div class="info-card-value">@Model.Gender</div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Right Side: Liên hệ & Xếp loại -->
        <div class="grid-column">
            <div class="section-column-title">LIÊN HỆ & XẾP LOẠI</div>

            <div class="info-card-box d-flex align-items-center gap-3">
                <div class="icon-circle-small"><i class="far fa-envelope"></i></div>
                <div>
                    <div class="info-card-label">EMAIL CHÍNH THỨC</div>
                    <div class="info-card-value">@(Model.Email ?? "Chưa cập nhật")</div>
                </div>
            </div>

            <div class="info-card-box d-flex align-items-center gap-3">
                <div class="icon-circle-small"><i class="fas fa-phone-alt"></i></div>
                <div>
                    <div class="info-card-label">SỐ ĐIỆN THOẠI</div>
                    <div class="info-card-value">@(Model.Phone ?? "--")</div>
                </div>
            </div>

            <div class="row">
                <div class="col-6">
                    <div class="info-card-box">
                        <div class="info-card-label">NGÀY VÀO ĐOÀN</div>
                        <div class="info-card-value">
                            @{
                                if (DateTime.TryParse(Model.JoinDate, out var joinDate))
                                {
                                    @joinDate.ToString("dd/MM/yyyy")
                                }
                                else
                                {
                                    @:Chưa cập nhật
                                }
                            }
                        </div>
                    </div>
                </div>
                <div class="col-6">
                    <div class="info-card-box">
                        <div class="info-card-label">NIÊN KHÓA</div>
                        <div class="info-card-value">@(Model.AcademicYear ?? "--")</div>
                    </div>
                </div>
            </div>

            <div class="achievement-card">
                <i class="fas fa-star star-bg" style="@(Model.IsOutstanding ? "opacity: 0.3;" : "")"></i>
                <span class="label">XẾP LOẠI & DANH HIỆU</span>
                <div class="value">
                    @if (Model.IsOutstanding)
                    {
                        <div class="text-warning" style="display: flex; align-items: center; gap: 8px; font-size: 1.1rem;">
                            <i class="fas fa-star"></i> ĐOÀN VIÊN TIÊU BIỂU
                        </div>
                        @if (!string.IsNullOrEmpty(Model.AchievementLevel) && Model.AchievementLevel != "Chưa xếp loại")
                        {
                            <div style="font-size: 0.8rem; color: #8a6d3b; margin-top: 4px; opacity: 0.7;">XẾP LOẠI: @Model.AchievementLevel</div>
                        }
                    }
                    else
                    {
                        @(string.IsNullOrEmpty(Model.AchievementLevel) ? "Chưa xếp loại" : Model.AchievementLevel)
                    }
                </div>
            </div>
        </div>
    </div>

    <div class="profile-actions-footer">
        <a href="/members/edit/@Model.Id" class="btn-main-action" onclick="if(window.openMemberModal){ event.preventDefault(); openMemberModal('/members/edit/@Model.Id'); }">CHỈNH SỬA HỒ SƠ</a>
        @if (isAjax)
        {
            <a href="javascript:void(0)" class="btn-secondary-action" onclick="closeMemberModal()">ĐÓNG</a>
        }
        else
        {
            <a href="/members" class="btn-secondary-action">ĐÓNG</a>
        }
    </div>
</div>

<script>
    // Any Details-specific JS can go here and will be executed by openMemberModal
</script>
