@model QLDV.Models.Member
@{
    ViewData["Title"] = "Đăng ký đoàn viên mới";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css">
<style>
    .form-layout-container {
        display: flex;
        justify-content: center;
        padding-top: 2rem;
        padding-bottom: 4rem;
    }

    .form-style-card {
        background: #fff;
        width: 100%;
        max-width: 800px;
        border-radius: 40px;
        box-shadow: 0 30px 60px rgba(0,0,0,0.1);
        padding: 3rem;
        position: relative;
    }

    .close-form-btn {
        position: absolute;
        top: 2rem;
        right: 2rem;
        width: 36px;
        height: 36px;
        background: #f4f7fa;
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #666;
        text-decoration: none;
        transition: all 0.2s;
    }

    .close-form-btn:hover {
        background: #eef2f7;
        color: #1a1a1a;
    }

    .form-header {
        margin-bottom: 3.5rem;
    }

    .form-header h2 {
        font-weight: 800;
        font-size: 1.75rem;
        letter-spacing: -0.5px;
        color: #1a1a1a;
        margin-bottom: 0.5rem;
    }

    .form-header .subtext {
        font-size: 0.65rem;
        font-weight: 800;
        color: #ccc;
        text-transform: uppercase;
        letter-spacing: 1px;
    }

    .custom-label {
        font-size: 0.65rem;
        font-weight: 800;
        color: #ccc;
        text-transform: uppercase;
        letter-spacing: 1px;
        margin-bottom: 0.75rem;
        display: block;
    }

    .custom-input {
        background: #f8fbff;
        border: 1px solid transparent;
        border-radius: 16px;
        padding: 1rem 1.25rem;
        font-weight: 600;
        color: #1a1a1a;
        transition: all 0.2s;
        width: 100%;
    }

    .custom-input::placeholder {
        color: #ccc;
    }

    .custom-input:focus {
        background: #fff;
        border-color: var(--primary-color);
        box-shadow: 0 0 0 4px rgba(0, 86, 179, 0.05);
        outline: none;
    }

    /* Custom Dropdown Styles */
    .dropdown-container {
        position: relative;
        width: 100%;
    }

    .custom-dropdown-trigger {
        background: #f8fbff;
        border: 1px solid transparent;
        border-radius: 16px;
        padding: 1rem 1.25rem;
        font-weight: 600;
        color: #1a1a1a;
        cursor: pointer;
        display: flex;
        justify-content: space-between;
        align-items: center;
        transition: all 0.2s;
    }

    .custom-dropdown-trigger:hover {
        background: #f0f7ff;
    }

    .custom-dropdown-trigger.active {
        background: #fff;
        border-color: var(--primary-color);
        box-shadow: 0 0 0 4px rgba(0, 86, 179, 0.05);
    }

    .dropdown-menu-custom {
        position: absolute;
        top: calc(100% + 8px);
        left: 0;
        width: 100%;
        background: #fff;
        border-radius: 18px;
        box-shadow: 0 15px 40px rgba(0,0,0,0.1);
        border: 1px solid #f0f0f0;
        z-index: 120;
        padding: 8px;
        display: none;
        max-height: 250px;
        overflow-y: auto;
    }

    .dropdown-menu-custom.show {
        display: block;
    }

    .dropdown-item-custom {
        padding: 12px 16px;
        border-radius: 12px;
        font-weight: 600;
        font-size: 0.9rem;
        color: #444;
        cursor: pointer;
        display: flex;
        justify-content: space-between;
        align-items: center;
        transition: background 0.2s;
    }

    .dropdown-item-custom:hover {
        background: #f8fbff;
        color: var(--primary-color);
    }

    .dropdown-item-custom.selected {
        background: #f0f7ff;
        color: var(--primary-color);
    }

    .dropdown-item-custom i {
        display: none;
        font-size: 0.8rem;
    }

    .dropdown-item-custom.selected i {
        display: block;
    }

    .submit-btn {
        background: var(--primary-color);
        color: #fff;
        border: none;
        border-radius: 16px;
        padding: 1.25rem;
        font-weight: 800;
        font-size: 0.9rem;
        text-transform: uppercase;
        letter-spacing: 1px;
        width: 100%;
        margin-top: 3rem;
        transition: all 0.2s;
        box-shadow: 0 10px 20px rgba(0, 86, 179, 0.2);
    }

    .submit-btn:hover {
        transform: translateY(-2px);
        box-shadow: 0 15px 30px rgba(0, 86, 179, 0.3);
    }

    /* Flatpickr Custom Styling */
    .flatpickr-calendar {
        border-radius: 24px !important;
        box-shadow: 0 15px 45px rgba(0,0,0,0.1) !important;
        border: 1px solid #f0f0f0 !important;
        padding: 10px !important;
    }

    .flatpickr-day.selected {
        background: var(--primary-color) !important;
        border-color: var(--primary-color) !important;
        border-radius: 12px !important;
    }
</style>

<div class="form-layout-container">
    <div class="form-style-card">
        <a href="/members" class="close-form-btn">
            <i class="fas fa-times"></i>
        </a>

        <div class="form-header">
            <h2>Đăng ký đoàn viên mới</h2>
            <div class="subtext">THÔNG TIN CHI TIẾT VỀ ĐOÀN VIÊN THANH NIÊN</div>
        </div>

        <form method="post" action="/members/create">
            <div class="mb-4">
                <label class="custom-label">HỌ VÀ TÊN ĐẦY ĐỦ</label>
                <input type="text" asp-for="FullName" class="custom-input" placeholder="VD: Nguyễn Hoàng Nam" required>
            </div>

            <div class="row">
                <div class="col-md-6 mb-4">
                    <label class="custom-label">EMAIL</label>
                    <input type="email" asp-for="Email" class="custom-input" placeholder="VD: name@domain.com">
                </div>
                <div class="col-md-6 mb-4">
                    <label class="custom-label">SỐ ĐIỆN THOẠI</label>
                    <input type="tel" asp-for="Phone" class="custom-input" placeholder="VD: 090xxxxxxxx">
                </div>
            </div>

            <div class="row">
                <div class="col-md-6 mb-4">
                    <label class="custom-label">NƠI SINH</label>
                    <input type="text" asp-for="PlaceOfBirth" class="custom-input" placeholder="VD: Hải Phòng...">
                </div>
                <div class="col-md-6 mb-4">
                    <label class="custom-label">QUÊ QUÁN</label>
                    <input type="text" asp-for="Hometown" class="custom-input" placeholder="Nhập quê quán (Tỉnh/Thành phố)">
                </div>
            </div>

            <div class="mb-4">
                <label class="custom-label">ĐỊA CHỈ THƯỜNG TRÚ</label>
                <input type="text" asp-for="PermanentAddress" class="custom-input" placeholder="Nhập đầy đủ địa chỉ thường trú...">
            </div>

            <div class="row">
                <div class="col-md-6 mb-4">
                    <label class="custom-label">DÂN TỘC</label>
                    <input type="text" asp-for="Ethnic" class="custom-input" placeholder="VD: Kinh...">
                </div>
                <div class="col-md-6 mb-4">
                    <label class="custom-label">TÔN GIÁO</label>
                    <input type="text" asp-for="Religion" class="custom-input" placeholder="VD: Không, Phật giáo...">
                </div>
            </div>

            <div class="row">
                <div class="col-md-6 mb-4">
                    <label class="custom-label">MSSV</label>
                    <input type="text" asp-for="MemberId" class="custom-input" placeholder="VD: 2024001" required>
                </div>
                <div class="col-md-6 mb-4">
                    <label class="custom-label">NGÀY SINH</label>
                    <div class="dropdown-container">
                        <input type="text" asp-for="DOB" class="custom-input date-picker" required placeholder="mm/dd/yyyy">
                        <i class="far fa-calendar-alt" style="position: absolute; right: 20px; top: 50%; transform: translateY(-50%); color: #ccc; pointer-events: none;"></i>
                    </div>
                </div>
            </div>

            <div class="row mb-4">
                <div class="col-md-6">
                    <label class="custom-label">GIỚI TÍNH</label>
                    <div class="dropdown-container">
                        <input type="hidden" asp-for="Gender" id="GenderInput" required />
                        <div class="custom-dropdown-trigger" id="genderDropdownTrigger">
                            <span id="genderSelectedText">Chọn giới tính...</span>
                            <i class="fas fa-chevron-down" style="color: #ccc; font-size: 0.8rem;"></i>
                        </div>
                        <div class="dropdown-menu-custom" id="genderDropdownMenu">
                            <div class="dropdown-item-custom" data-value="Nam">Nam <i class="fas fa-check"></i></div>
                            <div class="dropdown-item-custom" data-value="Nữ">Nữ <i class="fas fa-check"></i></div>
                            <div class="dropdown-item-custom" data-value="Khác">Khác <i class="fas fa-check"></i></div>
                        </div>
                    </div>
                </div>
                <div class="col-md-6">
                    <label class="custom-label">CHI ĐOÀN CÔNG TÁC</label>
                    <div class="dropdown-container">
                        <input type="hidden" asp-for="UnitId" id="UnitIdInput" required />
                        <div class="custom-dropdown-trigger" id="unitDropdownTrigger">
                            <span id="unitSelectedText">Chọn chi đoàn...</span>
                            <i class="fas fa-building" style="color: #ccc; font-size: 0.9rem;"></i>
                        </div>
                        <div class="dropdown-menu-custom" id="unitDropdownMenu">
                            @foreach (var unit in ViewBag.Units ?? new List<QLDV.Models.Unit>())
                            {
                                <div class="dropdown-item-custom" data-value="@unit.Id">@unit.Name <i class="fas fa-check"></i></div>
                            }
                        </div>
                    </div>
                </div>
            </div>

            <button type="submit" class="submit-btn">
                XÁC NHẬN ĐĂNG KÝ
            </button>
        </form>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>
    <script>
        $(document).ready(function() {
            // Initialize Flatpickr
            flatpickr(".date-picker", {
                dateFormat: "Y-m-d",
                altInput: true,
                altFormat: "m/d/Y",
                allowInput: true,
                disableMobile: true
            });

            function setupDropdown(triggerId, menuId, inputId, textId) {
                const trigger = document.getElementById(triggerId);
                const menu = document.getElementById(menuId);
                const input = document.getElementById(inputId);
                const text = document.getElementById(textId);
                const items = menu.querySelectorAll('.dropdown-item-custom');

                trigger.addEventListener('click', (e) => {
                    e.stopPropagation();
                    const isOpen = menu.classList.contains('show');
                    document.querySelectorAll('.dropdown-menu-custom').forEach(m => m.classList.remove('show'));
                    document.querySelectorAll('.custom-dropdown-trigger').forEach(t => t.classList.remove('active'));
                    if (!isOpen) {
                        menu.classList.add('show');
                        trigger.classList.add('active');
                    }
                });

                items.forEach(item => {
                    item.addEventListener('click', () => {
                        const val = item.getAttribute('data-value');
                        const label = item.textContent.trim();
                        input.value = val;
                        text.textContent = label;
                        items.forEach(i => i.classList.remove('selected'));
                        item.classList.add('selected');
                        menu.classList.remove('show');
                        trigger.classList.remove('active');
                    });
                });
            }

            setupDropdown('genderDropdownTrigger', 'genderDropdownMenu', 'GenderInput', 'genderSelectedText');
            setupDropdown('unitDropdownTrigger', 'unitDropdownMenu', 'UnitIdInput', 'unitSelectedText');

            document.addEventListener('click', () => {
                document.querySelectorAll('.dropdown-menu-custom').forEach(m => m.classList.remove('show'));
                document.querySelectorAll('.custom-dropdown-trigger').forEach(t => t.classList.remove('active'));
            });
        });
    </script>
}
