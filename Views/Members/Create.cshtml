@model QLDV.Models.Member
@{
    ViewData["Title"] = "Create Member";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="content-header">
    <h1><i class="fas fa-user-plus"></i> Add New Member</h1>
</div>

<div class="row">
    <div class="col-md-8">
        <div class="card">
            <div class="card-header">
                Member Information
            </div>
            <div class="card-body">
                <form method="post" action="/members/create">
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Full Name *</label>
                            <input type="text" asp-for="FullName" class="form-control" required>
                            <span asp-validation-for="FullName" class="text-danger"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Member ID *</label>
                            <input type="text" asp-for="MemberId" class="form-control" required>
                            <span asp-validation-for="MemberId" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Email</label>
                            <input type="email" asp-for="Email" class="form-control">
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Phone</label>
                            <input type="tel" asp-for="Phone" class="form-control">
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Date of Birth *</label>
                            <input type="date" asp-for="DOB" class="form-control" required>
                            <span asp-validation-for="DOB" class="text-danger"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Gender *</label>
                            <select asp-for="Gender" class="form-select" required>
                                <option value="">Select Gender</option>
                                <option value="Nam">Nam</option>
                                <option value="Nữ">Nữ</option>
                                <option value="Khác">Khác</option>
                            </select>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-12 mb-3">
                            <label class="form-label">Unit *</label>
                            <select asp-for="UnitId" class="form-select" required>
                                <option value="">Select Unit</option>
                                @foreach (var unit in ViewBag.Units ?? new List<object>())
                                {
                                    <option value="@unit.Id">@unit.Name</option>
                                }
                            </select>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Academic Year</label>
                            <input type="text" asp-for="AcademicYear" class="form-control">
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Join Date</label>
                            <input type="date" asp-for="JoinDate" class="form-control">
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-12 mb-3">
                            <label class="form-label">Place of Birth</label>
                            <input type="text" asp-for="PlaceOfBirth" class="form-control">
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-12 mb-3">
                            <label class="form-label">Hometown</label>
                            <input type="text" asp-for="Hometown" class="form-control">
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-12 mb-3">
                            <label class="form-label">Permanent Address</label>
                            <textarea asp-for="PermanentAddress" class="form-control" rows="3"></textarea>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Achievement Level</label>
                            <select asp-for="AchievementLevel" class="form-select">
                                <option value="Chưa xếp loại">Chưa xếp loại</option>
                                <option value="Xuất sắc">Xuất sắc</option>
                                <option value="Khá">Khá</option>
                                <option value="Trung bình">Trung bình</option>
                            </select>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Position</label>
                            <input type="text" asp-for="Position" class="form-control">
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Professional Level</label>
                            <input type="text" asp-for="ProfessionalLevel" class="form-control">
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Ethnic</label>
                            <input type="text" asp-for="Ethnic" class="form-control">
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-12 mb-3">
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" asp-for="IsOutstanding" id="isOutstanding">
                                <label class="form-check-label" for="isOutstanding">
                                    Outstanding Member
                                </label>
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-12">
                            <button type="submit" class="btn btn-primary btn-lg">
                                <i class="fas fa-save"></i> Save Member
                            </button>
                            <a href="/members" class="btn btn-secondary btn-lg">
                                <i class="fas fa-times"></i> Cancel
                            </a>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/jquery-validation@1.19.3/dist/jquery.validate.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/jquery-validation-unobtrusive@3.2.12/jquery.validate.unobtrusive.min.js"></script>
}
