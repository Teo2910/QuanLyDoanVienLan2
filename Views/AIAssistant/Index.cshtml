@{
    ViewData["Title"] = "Trợ lý AI";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="ai-layout-container">
    <div class="ai-style-card">
        <div class="form-header">
            <div>
                <h2>Hệ thống Tri thức <span>AI</span></h2>
                <div class="subtext">
                    <div class="dot-blue"></div>
                    DLU INTELLIGENT CORE V3.0 • ĐÃ ĐỒNG BỘ HÓA 100% DỮ LIỆU CHI ĐOÀN
                </div>
            </div>
            <div class="status-badge">
                STATUS: <div class="status-dot"></div> CORE ACTIVE
            </div>
        </div>

        <div class="chat-container" id="chatBox">
            <div class="message-ai chat-message">
                <div class="avatar-box">
                    <i class="fas fa-robot"></i>
                </div>
                <div>
                    <div class="message-bubble">
                        Xin chào! Tôi là Trợ lý AI của Đoàn thanh niên. Tôi đã sẵn sàng hỗ trợ bạn quản lý đoàn viên, phong trào và các báo cáo. Bạn cần giúp gì hôm nay?
                    </div>
                    <span class="message-time">@DateTime.Now.ToString("HH:mm") • AI ASSISTANT</span>
                </div>
            </div>
        </div>

        <div class="input-section">
            <div class="ai-input-wrapper">
                <i class="fas fa-magic search-icon"></i>
                <input type="text" id="messageInput" class="modern-input" placeholder="Điều lệnh hoặc câu hỏi của bạn? (VD: Tìm đoàn viên, Tạo sự kiện...)" autocomplete="off">
                <button class="send-btn-circle" id="sendBtn">
                    <i class="fas fa-paper-plane"></i>
                </button>
            </div>
        </div>

        <div class="suggests-container">
            <div class="suggests-header">LỆNH GỢI Ý THÔNG MINH</div>
            <div class="suggests-grid">
                <div class="suggest-item" onclick="sendMessage('Tìm đoàn viên xuất sắc')">TÌM ĐOÀN VIÊN</div>
                <div class="suggest-item" onclick="sendMessage('Tạo phong trào mùa hè xanh')">TẠO PHONG TRÀO MÙA HÈ</div>
                <div class="suggest-item" onclick="sendMessage('Lấy tài liệu thi đua 2026')">LẤY TÀI LIỆU THI ĐUA</div>
                <div class="suggest-item" onclick="sendMessage('Check list báo cáo tháng 5')">CHECK LIST BÁO CÁO</div>
            </div>
        </div>

        <div class="footer-note">• POWERED BY INTELLIGENT CORE TECHNOLOGY •</div>
    </div>
</div>

@section Scripts {
    <script>
        function sendMessage(message) {
            if (!message) {
                message = $('#messageInput').val().trim();
            }
            if (!message) return;

            const chatBox = $('#chatBox');
            const timeStr = new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });

            // User Message
            const userMsgHtml = `
                <div class="message-user chat-message">
                    <div class="avatar-box" style="background: #0f172a; color: #fff;">
                        <i class="fas fa-user"></i>
                    </div>
                    <div>
                        <div class="message-bubble">${message}</div>
                        <span class="message-time">${timeStr} • BÍ THƯ TRỰC TUYẾN</span>
                    </div>
                </div>
            `;
            chatBox.append(userMsgHtml);
            $('#messageInput').val('');

            // AI Typing
            const typingId = 'typing-' + Date.now();
            const aiTypingHtml = `
                <div class="message-ai chat-message" id="${typingId}">
                    <div class="avatar-box">
                        <i class="fas fa-robot"></i>
                    </div>
                    <div>
                        <div class="message-bubble">
                            <div class="typing">
                                <span class="dot"></span><span class="dot"></span><span class="dot"></span>
                                <span class="status-text">ĐANG TRUY XUẤT LÕI TRI THỨC...</span>
                            </div>
                        </div>
                    </div>
                </div>
            `;
            chatBox.append(aiTypingHtml);
            chatBox.scrollTop(chatBox[0].scrollHeight);

            // Fetch Response
            fetch('/AIAssistant/Chat', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ message: message })
            })
            .then(response => response.json())
            .then(data => {
                $('#' + typingId).remove();
                const aiMsgHtml = `
                    <div class="message-ai chat-message">
                        <div class="avatar-box">
                            <i class="fas fa-robot"></i>
                        </div>
                        <div>
                            <div class="message-bubble">${data.response || 'Xin lỗi, tôi không thể xử lý yêu cầu này.'}</div>
                            <span class="message-time">${timeStr} • AI ASSISTANT</span>
                        </div>
                    </div>
                `;
                chatBox.append(aiMsgHtml);
                chatBox.scrollTop(chatBox[0].scrollHeight);
            })
            .catch(error => {
                $('#' + typingId).remove();
                const errorMsgHtml = `
                    <div class="message-ai chat-message">
                        <div class="avatar-box">
                            <i class="fas fa-exclamation-triangle" style="color: #ef4444;"></i>
                        </div>
                        <div>
                            <div class="message-bubble" style="color: #ef4444; border-color: #fef2f2;">Lỗi hệ thống: ${error.message}</div>
                        </div>
                    </div>
                `;
                chatBox.append(errorMsgHtml);
                chatBox.scrollTop(chatBox[0].scrollHeight);
            });
        }

        $('#sendBtn').on('click', () => sendMessage());
        $('#messageInput').on('keypress', (e) => {
            if (e.key === 'Enter') sendMessage();
        });
    </script>
}
