@model QLDV.Models.Movement
@{
    ViewData["Title"] = "Thiết lập phong trào mới";
    Layout = Context.Request.Headers["X-Requested-With"] == "XMLHttpRequest" ? null : "~/Views/Shared/_Layout.cshtml";
}

<style>
    .form-layout-container {
        display: flex;
        justify-content: center;
        padding-top: 2rem;
        padding-bottom: 4rem;
    }

    .form-style-card {
        background: #fff;
        width: 100%;
        max-width: 700px;
        border-radius: 40px;
        box-shadow: 0 30px 60px rgba(0,0,0,0.1);
        padding: 3rem;
        position: relative;
    }

    .close-form-btn {
        position: absolute;
        top: 2rem;
        right: 2rem;
        width: 36px;
        height: 36px;
        background: #f4f7fa;
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #666;
        text-decoration: none;
        transition: all 0.2s;
    }

    .close-form-btn:hover {
        background: #eef2f7;
        color: #1a1a1a;
    }

    .form-header {
        margin-bottom: 2.5rem;
    }

    .form-header h2 {
        font-weight: 800;
        font-size: 1.75rem;
        letter-spacing: -0.5px;
        color: #1a1a1a;
        margin: 0;
    }

    .custom-label {
        font-size: 0.65rem;
        font-weight: 800;
        color: #ccc;
        text-transform: uppercase;
        letter-spacing: 1px;
        margin-bottom: 0.75rem;
        display: block;
    }

    .custom-input {
        background: #f8fbff;
        border: 1px solid transparent;
        border-radius: 16px;
        padding: 1rem 1.25rem;
        font-weight: 600;
        color: #1a1a1a;
        transition: all 0.2s;
        width: 100%;
    }

    .custom-input::placeholder {
        color: #ccc;
    }

    .custom-input:focus {
        background: #fff;
        border-color: var(--primary-color);
        box-shadow: 0 0 0 4px rgba(0, 86, 179, 0.05);
        outline: none;
    }

    .custom-textarea {
        min-height: 150px;
        resize: none;
    }

    .units-box {
        background: #f8fbff;
        border-radius: 20px;
        padding: 1.25rem;
        display: flex;
        flex-wrap: wrap;
        gap: 20px;
        margin-bottom: 1rem;
    }

    .unit-check-item {
        display: flex;
        align-items: center;
        gap: 10px;
        font-size: 0.85rem;
        font-weight: 700;
        color: #1a1a1a;
        cursor: pointer;
    }

    .unit-check-item input {
        width: 18px;
        height: 18px;
        border-radius: 6px;
        border: 2px solid #eee;
        cursor: pointer;
    }

    /* File Upload Styles */
    .file-upload-wrapper {
        position: relative;
        width: 100%;
    }

    .file-upload-input {
        position: absolute;
        width: 100%;
        height: 100%;
        top: 0;
        left: 0;
        opacity: 0;
        cursor: pointer;
        z-index: 2;
    }

    .file-upload-design {
        background: #f8fbff;
        border: 2px dashed #e0e8f0;
        border-radius: 16px;
        padding: 2rem;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 12px;
        transition: all 0.2s;
    }

    .file-upload-wrapper:hover .file-upload-design {
        border-color: var(--primary-color);
        background: #f0f7ff;
    }

    .file-upload-design i {
        font-size: 2rem;
        color: var(--primary-color);
        opacity: 0.7;
    }

    .file-upload-design span {
        font-size: 0.9rem;
        font-weight: 700;
        color: #666;
    }

    .file-upload-design small {
        font-size: 0.75rem;
        font-weight: 600;
        color: #ccc;
    }

    #file-list {
        margin-top: 15px;
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
    }

    .file-tag {
        background: #fff;
        border: 1px solid #eee;
        padding: 6px 12px;
        border-radius: 10px;
        font-size: 0.75rem;
        font-weight: 700;
        color: #1a1a1a;
        display: flex;
        align-items: center;
        gap: 8px;
        box-shadow: 0 2px 5px rgba(0,0,0,0.02);
    }

    .file-tag i {
        color: var(--primary-color);
    }

    .submit-btn {
        background: var(--primary-color);
        color: #fff;
        border: none;
        border-radius: 16px;
        padding: 1.25rem;
        font-weight: 800;
        font-size: 0.9rem;
        text-transform: uppercase;
        letter-spacing: 1px;
        width: 100%;
        margin-top: 2rem;
        transition: all 0.2s;
        box-shadow: 0 10px 20px rgba(0, 86, 179, 0.2);
    }

    .submit-btn:hover {
        transform: translateY(-2px);
        box-shadow: 0 15px 30px rgba(0, 86, 179, 0.3);
    }
</style>

<div class="form-layout-container">
    <div class="form-style-card">
        <a href="/movements" class="close-form-btn">
            <i class="fas fa-times"></i>
        </a>

        <div class="form-header">
            <h2>Thiết lập phong trào mới</h2>
            <div asp-validation-summary="All" class="text-danger mt-3" style="font-size: 0.8rem; font-weight: 600;"></div>
        </div>

        <form method="post" action="/movements/create" enctype="multipart/form-data">
            <div class="mb-4">
                <label class="custom-label">TIÊU ĐỀ PHONG TRÀO</label>
                <input type="text" asp-for="Title" class="custom-input" placeholder="VD: Phong trào Thanh niên tình nguyện mùa hè xanh 2024" required>
                <span asp-validation-for="Title" class="text-danger" style="font-size: 0.7rem;"></span>
            </div>

            <div class="row mb-4">
                <div class="col-md-6">
                    <label class="custom-label">NGÀY BẮT ĐẦU</label>
                    <input type="date" asp-for="StartDate" class="custom-input" required>
                    <span asp-validation-for="StartDate" class="text-danger" style="font-size: 0.7rem;"></span>
                </div>
                <div class="col-md-6">
                    <label class="custom-label">NGÀY KẾT THÚC</label>
                    <input type="date" asp-for="EndDate" class="custom-input" required>
                    <span asp-validation-for="EndDate" class="text-danger" style="font-size: 0.7rem;"></span>
                </div>
            </div>

            <div class="mb-4">
                <label class="custom-label">MÔ TẢ NỘI DUNG</label>
                <textarea asp-for="Description" class="custom-input custom-textarea" placeholder="Nêu rõ yêu cầu, nội dung và các mốc thời gian quan trọng..."></textarea>
            </div>

            <div class="mb-4">
                <label class="custom-label">ĐƠN VỊ THAM GIA (MẶC ĐỊNH CHỌN TẤT CẢ)</label>
                <div class="units-box">
                    @foreach (var unit in ViewBag.Units ?? new List<QLDV.Models.Unit>())
                    {
                        <label class="unit-check-item">
                            <input type="checkbox" value="@unit.Id" name="participatingUnitIds" checked>
                            <span>@unit.Name</span>
                        </label>
                    }
                </div>
            </div>

            <div class="mb-4">
                <label class="custom-label">TÀI LIỆU ĐÍNH KÈM (NẾU CÓ)</label>
                <div class="file-upload-wrapper">
                    <input type="file" name="attachments" class="file-upload-input" multiple id="attachments-input">
                    <div class="file-upload-design">
                        <i class="fas fa-cloud-upload-alt"></i>
                        <span>Nhấn để tải lên hoặc kéo thả tệp tại đây</span>
                        <small>Hỗ trợ nhiều tệp (Hình ảnh, PDF, Tài liệu...)</small>
                    </div>
                </div>
                <div id="file-list"></div>
            </div>

            <button type="submit" class="submit-btn">
                CÔNG BỐ PHONG TRÀO
            </button>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        document.getElementById('attachments-input').addEventListener('change', function(e) {
            const list = document.getElementById('file-list');
            list.innerHTML = '';
            
            if (this.files.length > 0) {
                Array.from(this.files).forEach(file => {
                    const tag = document.createElement('div');
                    tag.className = 'file-tag';
                    tag.innerHTML = `<i class="fas fa-file-alt"></i> ${file.name}`;
                    list.appendChild(tag);
                });
            }
        });
    </script>
}
