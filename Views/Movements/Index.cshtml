@using QLDV.Controllers
@model List<QLDV.Models.Movement>
@{
    var isAdmin = User.IsInRole("Admin");
    var isSecretary = User.IsInRole("Secretary");
    ViewData["Title"] = isAdmin ? "Phong trào & Báo cáo" : "Báo cáo phong trào";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var stats = ViewBag.MovementStats as List<MovementStatsViewModel> ?? new List<MovementStatsViewModel>();
}

<div class="page-header-premium">
    <div class="header-main">
        <div class="header-left-box">
            <div class="header-text-premium">
                <h1>Chiến dịch & Báo cáo</h1>
                <div class="subtitles">
                    <span class="subtitle-pill" style="background: var(--primary-light); color: var(--primary);">HỆ THỐNG TẬP TRUNG</span>
                    <span class="subtitle-text">QUẢN LÝ VÀ ĐIỀU PHỐI CÁC ĐƠN VỊ CƠ SỞ</span>
                </div>
            </div>
        </div>
        <div class="d-flex flex-wrap gap-2 gap-sm-3 mt-3 mt-lg-0">
            <a href="/aiassistant" class="btn-premium btn-ai-sparkle px-3 px-sm-4">
                <i class="fas fa-magic" style="color: var(--primary);"></i> <span class="d-none d-sm-inline">SÁNG TẠO AI</span><span class="d-sm-none">AI</span>
            </a>
            @if (isAdmin)
            {
                <a href="javascript:void(0)" onclick="openMovementModal('/movements/create')" class="btn-premium btn-launch-dark px-3 px-sm-4">
                    <i class="fas fa-plus"></i> <span class="d-none d-sm-inline">LỄ RA QUÂN</span><span class="d-sm-none">THÊM</span>
                </a>
            }
        </div>
    </div>
</div>

<div id="movementModal" class="modal-overlay">
    <div class="modal-content-wrapper">
        <div id="modalBody"></div>
    </div>
</div>

<div class="card-premium mb-5">
    <div class="d-flex align-items-center gap-4 mb-5">
        <div class="header-icon-premium m-0" style="background: #f8fafc; border: none; box-shadow: none;">
            <i class="fas fa-chart-bar" style="color: #64748b;"></i>
        </div>
        <div>
            <h2 class="fw-black text-dark m-0" style="font-size: 1.5rem; letter-spacing: -0.5px;">Tổng cục phong trào</h2>
            <p class="text-muted small fw-bold m-0 mt-1" style="letter-spacing: 1px; text-transform: uppercase;">DỮ LIỆU THỜI GIAN THỰC</p>
        </div>
    </div>

    <div class="table-responsive">
        <table class="table-premium-new">
            <thead>
                <tr>
                    <th>PHONG TRÀO & CHIẾN DỊCH</th>
                    <th class="text-center">ĐƠN VỊ</th>
                    <th class="text-center">ĐÃ BÁO</th>
                    <th class="text-center">TỔNG NỘP</th>
                    <th class="text-end" width="250">MỨC ĐỘ HOÀN THÀNH</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in stats)
                {
                    <tr>
                        <td>
                            <a href="javascript:void(0)" onclick="openMovementModal('/movements/details/@item.Movement.Id')" class="text-decoration-none text-dark fw-bold hover-primary fs-5">
                                @item.Movement.Title
                            </a>
                        </td>
                        <td class="text-center">
                            <span class="text-muted fw-bold">@item.TotalUnits</span>
                        </td>
                        <td class="text-center">
                            <span class="status-pill status-pill-success" style="background: #ecfdf5; color: #10b981; font-weight: 800; font-size: 0.8rem; padding: 4px 12px; border-radius: 50%; min-width: 32px; display: inline-flex; align-items: center; justify-content: center;">@item.ReportedCount</span>
                        </td>
                        <td class="text-center">
                            <span class="status-pill status-pill-info" style="background: #e0f2fe; color: #0369a1; font-weight: 800; font-size: 0.8rem; padding: 4px 12px; border-radius: 50%; min-width: 32px; display: inline-flex; align-items: center; justify-content: center;">@item.TotalSubmissions</span>
                        </td>
                        <td>
                            <div class="d-flex align-items-center gap-3 justify-content-end">
                                <div class="progress-premium">
                                    <div class="progress-bar-premium" style="width: @item.CompletionPercentage%;"></div>
                                </div>
                                <span class="completion-text">@item.CompletionPercentage.ToString("F1")%</span>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<div class="row">
    @foreach (var item in stats)
    {
        <div class="col-xl-4 col-md-6 mb-4">
            <div class="stat-card-grid" onclick="openMovementModal('/movements/details/@item.Movement.Id')">
                <div class="d-flex justify-content-between align-items-start">
                    <div class="stat-icon-box">
                        <i class="fas fa-medal"></i>
                    </div>
                    <div class="stat-count-pill">
                        @item.ReportedCount/@item.TotalUnits BÁO CÁO
                    </div>
                </div>
                
                <h3 class="stat-title-large">@item.Movement.Title</h3>
                <p class="stat-desc">
                    @(item.Movement.Description ?? "Chưa có mô tả cho chiến dịch này.")
                </p>
                
                <div class="phase-box">
                    <i class="far fa-calendar-alt"></i>
                    <div>
                        <span class="phase-label">Thời hạn</span>
                        <span class="phase-value">@item.Movement.StartDate.ToString("dd/MM") - @item.Movement.EndDate.ToString("dd/MM/yyyy")</span>
                    </div>
                </div>

                <div class="stat-footer">
                    <div class="footer-label">
                        <span>Hoàn thành</span>
                        <b>@item.CompletionPercentage.ToString("F0")%</b>
                    </div>
                    <div class="progress-container-new">
                        <div class="progress-bar-new" style="width: @item.CompletionPercentage%;"></div>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@section Scripts {
    <script>
        // Modal Event Listeners
        document.addEventListener('DOMContentLoaded', function() {
            const modal = document.getElementById('movementModal');
            
            // Close when clicking the overlay (blurred area)
            modal.addEventListener('click', function(e) {
                if (e.target === modal) {
                    closeMovementModal();
                }
            });

            // Close when clicking the wrapper but outside the actual card (optional safety)
            const wrapper = modal.querySelector('.modal-content-wrapper');
            if (wrapper) {
                wrapper.addEventListener('click', function(e) {
                    if (e.target === wrapper) {
                        closeMovementModal();
                    }
                });
            }
        });

        function openMovementModal(url) {
            const modal = document.getElementById('movementModal');
            const body = document.getElementById('modalBody');
            const wrapper = modal?.querySelector('.modal-content-wrapper');
            
            if (!modal || !body || !wrapper) {
                console.error('Modal elements missing');
                return;
            }

            // Adjust width based on content type
            if (url.includes('/details/')) {
                wrapper.style.maxWidth = '1100px';
            } else {
                wrapper.style.maxWidth = '800px';
            }

            // Show loading state
            body.innerHTML = '<div class="text-center py-5"><div class="spinner-border text-primary"></div><p class="mt-2 text-muted fw-bold">ĐANG TẢI...</p></div>';
            modal.classList.add('show');
            document.body.style.overflow = 'hidden';

            fetch(url)
                .then(response => response.text())
                .then(html => {
                    const parser = new DOMParser();
                    const doc = parser.parseFromString(html, 'text/html');
                    
                    if (!doc || doc.body === null) {
                        throw new Error('Failed to parse response or response is empty');
                    }

                    // Extract container (form or modal layout)
                    const content = doc.querySelector('.form-layout-container') || doc.querySelector('.modal-layout-container') || doc.body;
                    
                    if (!content) {
                        throw new Error('Content not found in response');
                    }

                    // Clear and re-inject styles + content
                    body.innerHTML = '';
                    doc.querySelectorAll?.('style')?.forEach(s => body.appendChild(s.cloneNode(true)));
                    body.insertAdjacentHTML('beforeend', content.outerHTML);

                    // RE-INJECT AND EXECUTE SCRIPTS
                    doc.querySelectorAll?.('script')?.forEach(oldScript => {
                        // Skip common library scripts that are already on the main page
                        const src = oldScript.getAttribute('src') || '';
                        if (src.includes('jquery') || src.includes('bootstrap') || src.includes('signalr')) {
                            return;
                        }

                        const newScript = document.createElement('script');
                        Array.from(oldScript.attributes).forEach(attr => newScript.setAttribute(attr.name, attr.value));
                        newScript.appendChild(document.createTextNode(oldScript.innerHTML));
                        body.appendChild(newScript);
                    });

                    initializeModalScripts();
                })
                .catch(error => {
                    console.error('Modal error:', error);
                    body.innerHTML = '<div class="alert alert-danger">Lỗi khi tải nội dung: ' + error.message + '</div>';
                });
        }

        function closeMovementModal() {
            const modal = document.getElementById('movementModal');
            modal.classList.remove('show');
            document.body.style.overflow = '';
            setTimeout(() => {
                document.getElementById('modalBody').innerHTML = '';
            }, 300);
        }

        function initializeModalScripts() {
            // 0. Handle Close Button inside modal
            const closeBtn = document.querySelector('#modalBody .close-form-btn, #modalBody .close-modal-btn');
            if (closeBtn) {
                closeBtn.href = 'javascript:void(0)';
                closeBtn.onclick = (e) => {
                    e.preventDefault();
                    closeMovementModal();
                };
            }

            // 0.1 Handle Edit Link inside Details modal
            const editLink = document.querySelector('#modalBody .edit-link');
            if (editLink) {
                const url = editLink.getAttribute('href');
                if (url && url.includes('/edit/')) {
                    editLink.href = 'javascript:void(0)';
                    editLink.onclick = (e) => {
                        e.preventDefault();
                        openMovementModal(url);
                    };
                }
            }

            // 1. Initialize Flatpickr if it exists in the loaded content
            if (typeof flatpickr !== 'undefined') {
                flatpickr(".date-picker", {
                    dateFormat: "Y-m-d",
                    allowInput: true,
                    disableMobile: true
                });
                
                // Also handle standard date inputs if any
                flatpickr("input[type='date']", {
                    dateFormat: "Y-m-d",
                    allowInput: true,
                    disableMobile: true
                });
            }

            // 2. Setup custom dropdowns (for Edit)
            setupDropdown('unitDropdownTrigger', 'unitDropdownMenu', 'TargetUnitInput', 'unitSelectedText');
            setupDropdown('statusDropdownTrigger', 'statusDropdownMenu', 'StatusInput', 'statusSelectedText');

            // 3. Handle File Upload (for Create and Submit Report)
            const fileInput = document.getElementById('attachments-input') || document.getElementById('report-attachments');
            if (fileInput) {
                fileInput.addEventListener('change', function(e) {
                    const list = document.getElementById('file-list') || document.getElementById('report-file-list');
                    if (!list) return;
                    list.innerHTML = '';
                    if (this.files.length > 0) {
                        Array.from(this.files).forEach(file => {
                            const tag = document.createElement('div');
                            tag.className = 'file-tag';
                            tag.innerHTML = `<i class="fas fa-file-alt"></i> ${file.name}`;
                            list.appendChild(tag);
                        });
                    }
                });
            }

            // 4. Handle Form Submit via AJAX
            const form = document.querySelector('#modalBody form');
            if (form) {
                form.onsubmit = function(e) {
                    e.preventDefault();
                    const formData = new FormData(form);
                    const url = form.getAttribute('action');

                    fetch(url, {
                        method: 'POST',
                        body: formData,
                        headers: {
                            'X-Requested-With': 'XMLHttpRequest'
                        }
                    })
                    .then(response => {
                        if (response.redirected) {
                            toast.success('Thao tác thành công!');
                            // Instead of reloading page, load the details back into modal
                            openMovementModal(response.url);
                            return;
                        }
                        return response.text();
                    })
                    .then(html => {
                        if (html) {
                            // If we get HTML back, it means there were validation errors
                            const parser = new DOMParser();
                            const doc = parser.parseFromString(html, 'text/html');
                            
                            if (!doc || !doc.body) {
                                console.error('Failed to parse validation errors');
                                return;
                            }

                            const content = doc.querySelector('.form-layout-container') || doc.querySelector('.modal-layout-container') || doc.body;
                            if (content) {
                                document.getElementById('modalBody').innerHTML = content.innerHTML;
                                
                                // Re-inject styles if any
                                if (doc.querySelectorAll) {
                                    doc.querySelectorAll('style').forEach(s => document.getElementById('modalBody').appendChild(s.cloneNode(true)));
                                }
                                
                                initializeModalScripts(); // Re-bind scripts
                            }
                        }
                    })
                    .catch(error => {
                        toast.error('Lỗi khi gửi dữ liệu: ' + error);
                    });
                };
            }
        }

        function setupDropdown(triggerId, menuId, inputId, textId) {
            const trigger = document.getElementById(triggerId);
            const menu = document.getElementById(menuId);
            const input = document.getElementById(inputId);
            const text = document.getElementById(textId);
            if (!trigger || !menu) return;
            
            const items = menu.querySelectorAll('.dropdown-item-custom');

            trigger.onclick = (e) => {
                e.stopPropagation();
                const isOpen = menu.classList.contains('show');
                document.querySelectorAll('.dropdown-menu-custom').forEach(m => m.classList.remove('show'));
                if (!isOpen) menu.classList.add('show');
            };

            items.forEach(item => {
                item.onclick = () => {
                    const val = item.getAttribute('data-value');
                    const label = item.textContent.trim();
                    input.value = val;
                    text.textContent = label;
                    items.forEach(i => i.classList.remove('selected'));
                    item.classList.add('selected');
                    menu.classList.remove('show');
                };
            });
        }

        // Close dropdowns on outside click
        document.addEventListener('click', () => {
            document.querySelectorAll('.dropdown-menu-custom').forEach(m => m.classList.remove('show'));
        });

        function deleteMovement(id, title) {
            if (confirm(`Bạn có chắc chắn muốn xóa phong trào "${title}"? Thao tác này không thể hoàn tác.`)) {
                $.ajax({
                    url: '/Movements/Delete',
                    type: 'POST',
                    data: { id: id },
                    success: function (response) {
                        if (response.success) {
                            toast.success(`Đã xóa phong trào "${title}" thành công!`);
                            setTimeout(() => {
                                location.reload();
                            }, 1000);
                        } else {
                            toast.error("Lỗi: " + response.message);
                        }
                    },
                    error: function () {
                        toast.error("Lỗi kết nối máy chủ");
                    }
                });
            }
        }
    </script>
}
