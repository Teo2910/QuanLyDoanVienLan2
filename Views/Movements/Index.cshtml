@using QLDV.Controllers
@model List<QLDV.Models.Movement>
@{
    ViewData["Title"] = "Chiến dịch & Báo cáo";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var stats = ViewBag.MovementStats as List<MovementStatsViewModel> ?? new List<MovementStatsViewModel>();
}

<style>
    .page-header-new {
        margin-bottom: 3rem;
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
    }

    .header-title-box h1 {
        font-weight: 800;
        font-size: 3rem;
        letter-spacing: -1.5px;
        margin-bottom: 0.5rem;
        color: #1a1a1a;
    }

    .header-badges {
        display: flex;
        gap: 10px;
        align-items: center;
    }

    .badge-modern {
        padding: 0.5rem 1rem;
        border-radius: 10px;
        font-size: 0.7rem;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    .badge-blue { background: #e8f0fe; color: var(--primary-color); }
    .badge-gray { background: #f8f9fa; color: #999; }

    .header-actions {
        display: flex;
        gap: 15px;
    }

    .btn-outline-modern {
        border: 1px solid #eee;
        background: #fff;
        color: #1a1a1a;
        padding: 0.75rem 1.5rem;
        display: flex;
        align-items: center;
        gap: 10px;
        box-shadow: var(--card-shadow);
    }

    .btn-dark-modern {
        background: #1a1a1a;
        color: #fff;
        padding: 0.75rem 1.5rem;
        display: flex;
        align-items: center;
        gap: 10px;
        box-shadow: 0 10px 20px rgba(0,0,0,0.1);
    }

    /* Summary Table Section */
    .summary-section {
        background: #fff;
        border-radius: 40px;
        padding: 2.5rem;
        box-shadow: var(--card-shadow);
        margin-bottom: 3rem;
    }

    .summary-header {
        display: flex;
        align-items: center;
        gap: 20px;
        margin-bottom: 2.5rem;
    }

    .summary-icon {
        width: 64px;
        height: 64px;
        background: #f0f4f8;
        border-radius: 20px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.5rem;
        color: #666;
    }

    .summary-title h4 {
        margin: 0;
        font-weight: 800;
        font-size: 1.25rem;
    }

    .summary-title p {
        margin: 0;
        font-size: 0.7rem;
        font-weight: 700;
        color: #ccc;
        text-transform: uppercase;
        letter-spacing: 1px;
    }

    .modern-table {
        width: 100%;
    }

    .modern-table th {
        font-size: 0.7rem;
        font-weight: 700;
        color: #ccc;
        text-transform: uppercase;
        letter-spacing: 1px;
        padding: 1rem;
        border-bottom: 1px solid #f0f0f0;
    }

    .modern-table td {
        padding: 1.5rem 1rem;
        vertical-align: middle;
        font-size: 0.9rem;
        font-weight: 600;
    }

    .text-green { color: #28a745; }
    .text-blue { color: var(--primary-color); }

    .progress-modern {
        height: 6px;
        background: #f0f0f0;
        border-radius: 10px;
        overflow: hidden;
        width: 100px;
        display: inline-block;
        margin-right: 15px;
    }

    .progress-bar-modern {
        height: 100%;
        background: var(--primary-color);
        border-radius: 10px;
    }

    .progress-bar-gray { background: #eee; }

    /* Campaign Cards */
    .campaign-card {
        background: #fff;
        border-radius: 30px;
        padding: 2rem;
        box-shadow: var(--card-shadow);
        height: 100%;
        position: relative;
        transition: all 0.3s ease;
    }

    .campaign-card:hover {
        transform: translateY(-10px);
    }

    .campaign-status-badge {
        position: absolute;
        top: 2rem;
        right: 2rem;
        background: #fff3e0;
        color: #ff9800;
        padding: 0.4rem 1rem;
        border-radius: 20px;
        font-size: 0.65rem;
        font-weight: 800;
        text-transform: uppercase;
    }

    .campaign-card .icon-box {
        width: 56px;
        height: 56px;
        background: #f8f9fa;
        border-radius: 16px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.25rem;
        color: #666;
        margin-bottom: 2rem;
    }

    .campaign-card h4 {
        font-weight: 800;
        font-size: 1.25rem;
        margin-bottom: 1rem;
    }

    .campaign-card p {
        color: #999;
        font-size: 0.85rem;
        line-height: 1.6;
        margin-bottom: 0;
    }
</style>

<div class="page-header-new">
    <div class="header-title-box">
        <h1>Chiến dịch & Báo cáo</h1>
        <div class="header-badges">
            <span class="badge-modern badge-blue">Hệ thống tập trung</span>
            <span class="badge-modern badge-gray">Quản lý và điều phối các đơn vị cơ sở</span>
        </div>
    </div>
    <div class="header-actions">
        <a href="/aiassistant" class="btn btn-outline-modern">
            <i class="fas fa-magic"></i> Sáng tạo AI
        </a>
        <a href="/movements/create" class="btn btn-dark-modern">
            <i class="fas fa-plus"></i> Lễ ra quân
        </a>
    </div>
</div>

<div class="summary-section">
    <div class="summary-header">
        <div class="summary-icon">
            <i class="fas fa-chart-bar"></i>
        </div>
        <div class="summary-title">
            <h4>Tổng cục phong trào</h4>
            <p>Dữ liệu thời gian thực</p>
        </div>
    </div>

    <table class="modern-table">
        <thead>
            <tr>
                <th>Phong trào & Chiến dịch</th>
                <th class="text-center">Đơn vị</th>
                <th class="text-center">Đã báo</th>
                <th class="text-center">Tổng nộp</th>
                <th class="text-end">Mức độ hoàn thành</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in stats)
            {
                <tr>
                    <td>@item.Movement.Title</td>
                    <td class="text-center">@item.TotalUnits</td>
                    <td class="text-center text-green">@item.ReportedCount</td>
                    <td class="text-center text-blue">@item.TotalSubmissions</td>
                    <td class="text-end">
                        <div class="progress-modern">
                            <div class="progress-bar-modern @(item.CompletionPercentage == 0 ? "progress-bar-gray" : "")" style="width: @item.CompletionPercentage%"></div>
                        </div>
                        <span style="color: @(item.CompletionPercentage == 0 ? "#ccc" : (item.CompletionPercentage < 100 ? "#ff9800" : "#28a745"))">
                            @item.CompletionPercentage.ToString("F1")%
                        </span>
                    </td>
                </tr>
            }
            @if (!stats.Any())
            {
                <tr>
                    <td colspan="5" class="text-center py-4 text-muted">Chưa có dữ liệu chiến dịch</td>
                </tr>
            }
        </tbody>
    </table>
</div>

<div class="row">
    @foreach (var item in stats)
    {
        <div class="col-md-6 mb-4">
            <a href="/movements/details/@item.Movement.Id" style="text-decoration: none; color: inherit;">
                <div class="campaign-card">
                    <div class="campaign-status-badge">
                        @item.ReportedCount/@item.TotalUnits Báo cáo
                    </div>
                    <div class="icon-box">
                        <i class="fas fa-award"></i>
                    </div>
                    <h4>@item.Movement.Title</h4>
                    <p>@(item.Movement.Description?.Length > 100 ? item.Movement.Description.Substring(0, 100) + "..." : item.Movement.Description)</p>
                </div>
            </a>
        </div>
    }
</div>
