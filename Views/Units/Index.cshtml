@using Microsoft.AspNetCore.Identity
@inject UserManager<ApplicationUser> UserManager
@model List<QLDV.Models.Unit>
@{
    ViewData["Title"] = "Quản lý đơn vị";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var currentUser = await UserManager.GetUserAsync(User);
    var isAdmin = currentUser != null && currentUser.Role == "Admin";
    var isSecretary = currentUser != null && currentUser.Role == "Secretary";
}

<div class="page-header-premium">
    <div class="header-main">
        <div class="header-left-box">
            <div class="header-icon-premium">
                <i class="fas fa-building" style="color: var(--primary);"></i>
            </div>
            <div class="header-text-premium">
                <h1>Quản lý đơn vị</h1>
                <p>DANH MỤC CÁC CHI ĐOÀN VÀ ĐƠN VỊ CƠ SỞ TRỰC THUỘC</p>
            </div>
        </div>
        @if (isAdmin)
        {
            <a href="javascript:void(0)" onclick="openUnitModal('/units/create')" class="btn-premium btn-launch-dark mt-3 mt-lg-0">
                <i class="fas fa-plus"></i> <span class="d-none d-sm-inline">THÊM ĐƠN VỊ MỚI</span><span class="d-sm-none">THÊM</span>
            </a>
        }
    </div>
</div>

<div id="unitModal" class="modal-overlay">
    <div class="modal-content-wrapper" style="max-width: 1100px;">
        <div id="modalBody"></div>
    </div>
</div>

<div class="card-premium">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-3 mb-4">
        <div class="search-box-premium w-100" style="max-width: 500px;">
            <i class="fas fa-search"></i>
            <input type="text" placeholder="Tìm kiếm đơn vị..." id="unitSearch">
        </div>
        <div class="status-pill status-pill-success fw-black text-uppercase">
            TẤT CẢ @(Model?.Count ?? 0) ĐƠN VỊ
        </div>
    </div>

    <div class="table-responsive">
        <table class="table-premium-new">
            <thead>
                <tr>
                    <th width="150">MÃ ĐƠN VỊ</th>
                    <th>TÊN ĐƠN VỊ</th>
                    <th>THÔNG TIN LIÊN HỆ</th>
                    <th width="120" class="text-end">THAO TÁC</th>
                </tr>
            </thead>
            <tbody id="unitTableBody">
                @foreach (var unit in Model ?? new List<QLDV.Models.Unit>())
                {
                    <tr class="unit-row">
                        <td>
                            <span class="status-pill status-pill-warning" style="background: #f1f5f9; color: #64748b; font-weight: 800;">@unit.Code</span>
                        </td>
                        <td>
                            <div class="fw-bold text-dark fs-5">@unit.Name</div>
                        </td>
                        <td>
                            <div class="d-flex flex-column">
                                <div class="d-flex align-items-center gap-2 fw-bold text-dark mb-1">
                                    <div style="width: 6px; height: 6px; background: var(--primary); border-radius: 50%;"></div>
                                    @unit.Email
                                </div>
                                <div class="text-muted small fw-bold ms-3">@unit.Address</div>
                            </div>
                        </td>
                        <td>
                            <div class="d-flex justify-content-end gap-2">
                                <a href="javascript:void(0)" onclick="openUnitModal('/units/details/@unit.Id')" class="btn-premium btn-premium-light p-2 px-3" title="Chi tiết">
                                    <i class="fas fa-eye"></i>
                                </a>
                                @if (isAdmin || (isSecretary && unit.Id == currentUser?.UnitId))
                                {
                                    <a href="javascript:void(0)" onclick="openUnitModal('/units/edit/@unit.Id')" class="btn-premium btn-premium-light p-2 px-3" title="Sửa">
                                        <i class="fas fa-edit"></i>
                                    </a>
                                }
                                @if (isAdmin)
                                {
                                    <a href="javascript:void(0)" onclick="openUnitModal('/units/delete/@unit.Id')" class="btn-premium btn-premium-light p-2 px-3 text-danger" title="Xóa">
                                        <i class="fas fa-trash-alt"></i>
                                    </a>
                                }
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @if (Model == null || Model.Count == 0)
    {
        <div class="text-center py-5">
            <i class="fas fa-folder-open fa-3x mb-3 text-muted opacity-25"></i>
            <p class="text-muted fw-bold">Chưa có đơn vị nào trong hệ thống.</p>
        </div>
    }

    <div class="d-flex justify-content-between align-items-center mt-5 pt-4 border-top">
        <div class="text-muted small fw-bold text-uppercase letter-spacing-1">
            TỔNG SỐ: @(Model?.Count ?? 0) ĐƠN VỊ TRONG DANH SÁCH
        </div>
        <div class="d-flex gap-2">
            <div style="width: 8px; height: 8px; background: var(--primary); border-radius: 50%;"></div>
            <div style="width: 8px; height: 8px; background: #e2e8f0; border-radius: 50%;"></div>
            <div style="width: 8px; height: 8px; background: #e2e8f0; border-radius: 50%;"></div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            $("#unitSearch").on("keyup", function() {
                var value = $(this).val().toLowerCase();
                $("#unitTableBody tr").filter(function() {
                    $(this).toggle($(this).text().toLowerCase().indexOf(value) > -1)
                });
            });

            // Modal Event Listeners
            const modal = document.getElementById('unitModal');
            if (modal) {
                modal.addEventListener('click', function(e) {
                    if (e.target === modal) {
                        closeUnitModal();
                    }
                });
            }
        });

        function openUnitModal(url) {
            const modal = document.getElementById('unitModal');
            const body = document.getElementById('modalBody');
            const wrapper = modal?.querySelector('.modal-content-wrapper');
            
            if (!modal || !body || !wrapper) return;

            // Adjust width and alignment based on content type
            if (url.includes('/edit/') || url.includes('/create')) {
                wrapper.style.maxWidth = '800px';
                modal.style.alignItems = 'flex-start';
            } else if (url.includes('/delete/')) {
                wrapper.style.maxWidth = '550px';
                modal.style.alignItems = 'center';
            } else {
                wrapper.style.maxWidth = '1100px';
                modal.style.alignItems = 'flex-start';
            }

            // Show loading state
            body.innerHTML = '<div class="text-center py-5"><div class="spinner-border text-primary"></div><p class="mt-2 text-muted fw-bold">ĐANG TẢI...</p></div>';
            modal.classList.add('show');
            document.body.style.overflow = 'hidden';

            fetch(url, { headers: { 'X-Requested-With': 'XMLHttpRequest' } })
                .then(response => {
                    if (response.redirected) {
                        toast.success('Thao tác thành công!');
                        setTimeout(() => { location.reload(); }, 1000);
                        return;
                    }
                    return response.text();
                })
                .then(html => {
                    if (!html) return;
                    const parser = new DOMParser();
                    const doc = parser.parseFromString(html, 'text/html');
                    const content = doc.querySelector('.modal-layout-container') || doc.querySelector('.form-layout-container') || doc.body;
                    
                    body.innerHTML = content.outerHTML;

                    // RE-INJECT AND EXECUTE STYLES
                    doc.querySelectorAll('style').forEach(s => {
                        body.appendChild(s.cloneNode(true));
                    });

                    // RE-INJECT AND EXECUTE SCRIPTS (Crucial for dropdowns)
                    doc.querySelectorAll('script').forEach(oldScript => {
                        const newScript = document.createElement('script');
                        Array.from(oldScript.attributes).forEach(attr => newScript.setAttribute(attr.name, attr.value));
                        newScript.appendChild(document.createTextNode(oldScript.innerHTML));
                        body.appendChild(newScript);
                    });
                    
                    initializeUnitModalScripts(body);
                })
                .catch(error => {
                    console.error('Modal error:', error);
                    body.innerHTML = '<div class="alert alert-danger m-4">Lỗi khi tải nội dung: ' + error.message + '</div>';
                });
        }

        function closeUnitModal() {
            const modal = document.getElementById('unitModal');
            if (modal) {
                modal.classList.remove('show');
                document.body.style.overflow = '';
                setTimeout(() => {
                    document.getElementById('modalBody').innerHTML = '';
                }, 300);
            }
        }

        function initializeUnitModalScripts(container) {
            // Handle close buttons
            container.querySelectorAll('.close-modal-btn, .close-form-btn').forEach(btn => {
                btn.href = 'javascript:void(0)';
                btn.onclick = (e) => {
                    e.preventDefault();
                    closeUnitModal();
                };
            });

            // Handle navigation links to stay in modal
            container.querySelectorAll('a[href*="/units/edit/"], a[href*="/units/delete/"], a[href*="/units/details/"]').forEach(link => {
                const url = link.getAttribute('href');
                link.href = 'javascript:void(0)';
                link.onclick = (e) => {
                    e.preventDefault();
                    openUnitModal(url);
                };
            });

            // Handle form submission via AJAX
            const form = container.querySelector('form');
            if (form) {
                form.onsubmit = function(e) {
                    e.preventDefault();
                    const formData = new FormData(form);
                    const url = form.getAttribute('action');

                    fetch(url, {
                        method: 'POST',
                        body: formData,
                        headers: { 'X-Requested-With': 'XMLHttpRequest' }
                    })
                    .then(response => {
                        if (response.redirected) {
                            if (typeof toast !== 'undefined') toast.success('Thao tác thành công!');
                            setTimeout(() => { location.reload(); }, 1000);
                            return;
                        }
                        return response.text();
                    })
                    .then(html => {
                        if (html) {
                            const parser = new DOMParser();
                            const doc = parser.parseFromString(html, 'text/html');
                            const content = doc.querySelector('.form-layout-container') || doc.querySelector('.modal-layout-container') || doc.body;
                            if (content) {
                                container.innerHTML = content.outerHTML;
                                doc.querySelectorAll('style').forEach(s => container.appendChild(s.cloneNode(true)));
                                initializeUnitModalScripts(container);
                            }
                        }
                    })
                    .catch(err => {
                        if (typeof toast !== 'undefined') toast.error('Lỗi khi gửi dữ liệu');
                        console.error(err);
                    });
                };
            }
        }
    </script>
}
