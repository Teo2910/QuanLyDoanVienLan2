@using Microsoft.AspNetCore.Identity
@inject UserManager<ApplicationUser> UserManager
@model List<QLDV.Models.Unit>
@{
    ViewData["Title"] = "Quản lý đơn vị";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var currentUser = await UserManager.GetUserAsync(User);
    var isAdmin = currentUser != null && currentUser.Role == "Admin";
    var isSecretary = currentUser != null && currentUser.Role == "Secretary";
}

<div class="page-header-premium">
    <div class="header-main">
        <div class="header-left-box">
            <div class="header-icon-premium">
                <i class="fas fa-building"></i>
            </div>
            <div class="header-text-premium">
                <h1>Quản lý đơn vị</h1>
                <p>DANH MỤC CÁC CHI ĐOÀN VÀ ĐƠN VỊ CƠ SỞ TRỰC THUỘC</p>
            </div>
        </div>
        @if (isAdmin)
        {
            <a href="/units/create" class="btn-premium btn-premium-primary">
                <i class="fas fa-plus"></i> THÊM ĐƠN VỊ MỚI
            </a>
        }
    </div>
</div>

<div class="card-premium">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div class="search-box-premium">
            <i class="fas fa-search"></i>
            <input type="text" placeholder="Tìm kiếm theo tên hoặc mã đơn vị..." id="unitSearch">
        </div>
        <div class="status-pill status-pill-success">
            TẤT CẢ @(Model?.Count ?? 0) ĐƠN VỊ
        </div>
    </div>

    <div class="table-responsive">
        <table class="table-premium-new">
            <thead>
                <tr>
                    <th width="150">MÃ ĐƠN VỊ</th>
                    <th>TÊN ĐƠN VỊ</th>
                    <th>THÔNG TIN LIÊN HỆ</th>
                    <th width="120" class="text-end">THAO TÁC</th>
                </tr>
            </thead>
            <tbody id="unitTableBody">
                @foreach (var unit in Model ?? new List<QLDV.Models.Unit>())
                {
                    <tr class="unit-row">
                        <td>
                            <span class="status-pill status-pill-warning" style="background: #f1f5f9; color: #64748b; font-weight: 800;">@unit.Code</span>
                        </td>
                        <td>
                            <div class="fw-bold text-dark fs-5">@unit.Name</div>
                        </td>
                        <td>
                            <div class="d-flex flex-column">
                                <div class="d-flex align-items-center gap-2 fw-bold text-dark mb-1">
                                    <div style="width: 6px; height: 6px; background: var(--primary); border-radius: 50%;"></div>
                                    @unit.Email
                                </div>
                                <div class="text-muted small fw-bold ms-3">@unit.Address</div>
                            </div>
                        </td>
                        <td>
                            <div class="d-flex justify-content-end gap-2">
                                <a href="/units/details/@unit.Id" class="btn-premium btn-premium-light p-2 px-3" title="Chi tiết">
                                    <i class="fas fa-eye"></i>
                                </a>
                                @if (isAdmin || (isSecretary && unit.Id == currentUser?.UnitId))
                                {
                                    <a href="/units/edit/@unit.Id" class="btn-premium btn-premium-light p-2 px-3" title="Sửa">
                                        <i class="fas fa-edit"></i>
                                    </a>
                                }
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @if (Model == null || Model.Count == 0)
    {
        <div class="text-center py-5">
            <i class="fas fa-folder-open fa-3x mb-3 text-muted opacity-25"></i>
            <p class="text-muted fw-bold">Chưa có đơn vị nào trong hệ thống.</p>
        </div>
    }

    <div class="d-flex justify-content-between align-items-center mt-5 pt-4 border-top">
        <div class="text-muted small fw-bold text-uppercase letter-spacing-1">
            TỔNG SỐ: @(Model?.Count ?? 0) ĐƠN VỊ TRONG DANH SÁCH
        </div>
        <div class="d-flex gap-2">
            <div style="width: 8px; height: 8px; background: var(--primary); border-radius: 50%;"></div>
            <div style="width: 8px; height: 8px; background: #e2e8f0; border-radius: 50%;"></div>
            <div style="width: 8px; height: 8px; background: #e2e8f0; border-radius: 50%;"></div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            $("#unitSearch").on("keyup", function() {
                var value = $(this).val().toLowerCase();
                $("#unitTableBody tr").filter(function() {
                    $(this).toggle($(this).text().toLowerCase().indexOf(value) > -1)
                });
            });
        });
    </script>
}
