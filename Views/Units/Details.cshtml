@model QLDV.Models.Unit
@{
    ViewData["Title"] = Model.Name;
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="content-header">
    <div class="d-flex justify-content-between align-items-center">
        <div>
            <h1><i class="fas fa-building"></i> @Model.Name</h1>
            <p class="text-muted">@Model.Code</p>
        </div>
        <div>
            <a href="/units/edit/@Model.Id" class="btn btn-primary">
                <i class="fas fa-edit"></i> Edit
            </a>
            <a href="/units/delete/@Model.Id" class="btn btn-danger">
                <i class="fas fa-trash"></i> Delete
            </a>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-md-8">
        <div class="card">
            <div class="card-header">
                <i class="fas fa-info-circle"></i> Unit Information
            </div>
            <div class="card-body">
                <div class="row mb-3">
                    <div class="col-md-6">
                        <h6 class="text-muted">Unit Code</h6>
                        <p>@Model.Code</p>
                    </div>
                    <div class="col-md-6">
                        <h6 class="text-muted">Email</h6>
                        <p>@(Model.Email ?? "N/A")</p>
                    </div>
                </div>
                <div class="row mb-3">
                    <div class="col-md-6">
                        <h6 class="text-muted">Phone</h6>
                        <p>@(Model.Phone ?? "N/A")</p>
                    </div>
                    <div class="col-md-6">
                        <h6 class="text-muted">Created</h6>
                        <p>@(new DateTime(Model.CreatedAt, DateTimeKind.Utc).ToString("g"))</p>
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-12">
                        <h6 class="text-muted">Address</h6>
                        <p>@(Model.Address ?? "N/A")</p>
                    </div>
                </div>
            </div>
        </div>

        <div class="card mt-4">
            <div class="card-header">
                <i class="fas fa-users"></i> Members (@Model.Members.Count)
            </div>
            <div class="card-body">
                @if (Model.Members.Any())
                {
                    <div class="table-responsive">
                        <table class="table table-hover">
                            <thead>
                                <tr>
                                    <th>Name</th>
                                    <th>Member ID</th>
                                    <th>Status</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var member in Model.Members)
                                {
                                    <tr>
                                        <td>@member.FullName</td>
                                        <td>@member.MemberId</td>
                                        <td><span class="badge bg-primary">@member.Status</span></td>
                                        <td>
                                            <a href="/members/edit/@member.Id" class="btn btn-sm btn-primary">
                                                <i class="fas fa-eye"></i>
                                            </a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <p class="text-muted">No members in this unit</p>
                }
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card">
            <div class="card-header">
                <i class="fas fa-chart-bar"></i> Statistics
            </div>
            <div class="card-body">
                <div class="stat-item mb-3">
                    <small class="text-muted">Total Members</small>
                    <h4>@Model.Members.Count</h4>
                </div>
                <div class="stat-item mb-3">
                    <small class="text-muted">Child Units</small>
                    <h4>@Model.Children.Count</h4>
                </div>
                @if (Model.Parent != null)
                {
                    <div class="stat-item">
                        <small class="text-muted">Parent Unit</small>
                        <p>
                            <a href="/units/details/@Model.Parent.Id">@Model.Parent.Name</a>
                        </p>
                    </div>
                }
            </div>
        </div>

        @if (Model.Children.Any())
        {
            <div class="card mt-3">
                <div class="card-header">
                    <i class="fas fa-sitemap"></i> Child Units
                </div>
                <div class="card-body">
                    <ul class="list-group list-group-flush">
                        @foreach (var child in Model.Children)
                        {
                            <li class="list-group-item d-flex justify-content-between align-items-center">
                                <a href="/units/details/@child.Id">@child.Name</a>
                                <span class="badge bg-secondary">@child.Members.Count</span>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        }
    </div>
</div>

<style>
    .stat-item {
        border-bottom: 1px solid #f0f0f0;
        padding-bottom: 15px;
    }
</style>
