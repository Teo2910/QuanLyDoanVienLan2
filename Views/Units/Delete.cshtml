@model QLDV.Models.Unit
@{
    ViewData["Title"] = "Xác nhận xóa đơn vị";
    bool isAjax = Context.Request.Headers["X-Requested-With"] == "XMLHttpRequest";
    Layout = isAjax ? null : "~/Views/Shared/_Layout.cshtml";
}

<div class="confirm-card">
    <div class="confirm-icon-box">
        <i class="fas fa-trash-alt"></i>
    </div>
    
    <h3>Xác nhận xóa</h3>
    
    <p>
        Bạn có chắc chắn muốn xóa đơn vị "@Model.Name"? <br/>
        Thao tác này sẽ xóa tất cả báo cáo liên quan và không thể hoàn tác.
    </p>

    <form method="post" action="/units/delete/@Model.Id">
        <div class="confirm-actions">
            <button type="button" class="btn-confirm-no" onclick="closeUnitModal()">
                HỦY BỎ
            </button>
            <button type="submit" class="btn-confirm-yes">
                XÁC NHẬN XÓA
            </button>
        </div>
    </form>
</div>
