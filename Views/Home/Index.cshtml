@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Khởi động hệ thống - QLDV</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
    <style>
        :root {
            --primary: #0061f2;
            --primary-dark: #004dc6;
            --primary-light: #e0f2fe;
            --text-dark: #0f172a;
            --text-light: #64748b;
        }

        body {
            font-family: 'Inter', sans-serif;
            background: radial-gradient(circle at center, #0f172a 0%, #020617 100%);
            color: #fff;
            margin: 0;
            padding: 0;
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            overflow-x: hidden;
            position: relative;
        }

        /* Abstract glowing blobs for premium feel */
        .glow-blob {
            position: absolute;
            width: 500px;
            height: 500px;
            background: radial-gradient(circle, rgba(0, 97, 242, 0.15) 0%, transparent 70%);
            border-radius: 50%;
            z-index: 0;
            pointer-events: none;
        }
        .blob-1 { top: -10%; left: -10%; }
        .blob-2 { bottom: -10%; right: -10%; }

        .start-container {
            z-index: 10;
            width: 100%;
            max-width: 900px;
            padding: 30px;
            text-align: center;
            animation: fadeIn 1s ease-out;
        }

        .system-badge {
            background: rgba(255, 255, 255, 0.05);
            border: 1px solid rgba(255, 255, 255, 0.1);
            backdrop-filter: blur(10px);
            padding: 8px 20px;
            border-radius: 50px;
            font-size: 0.75rem;
            font-weight: 800;
            letter-spacing: 2px;
            text-transform: uppercase;
            color: #38bdf8;
            display: inline-flex;
            align-items: center;
            gap: 8px;
            margin-bottom: 20px;
        }

        .system-badge i {
            animation: pulse-ring 2s infinite;
        }

        h1 {
            font-weight: 900;
            font-size: 2.8rem;
            letter-spacing: -1.5px;
            margin-bottom: 15px;
            background: linear-gradient(135deg, #ffffff 0%, #94a3b8 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        p.subtitle {
            font-size: 1.1rem;
            color: #94a3b8;
            font-weight: 500;
            margin-bottom: 40px;
            max-width: 600px;
            margin-left: auto;
            margin-right: auto;
        }

        /* Video Showcase Display */
        .video-wrapper {
            background: rgba(255, 255, 255, 0.03);
            border: 1px solid rgba(255, 255, 255, 0.08);
            border-radius: 30px;
            padding: 12px;
            box-shadow: 0 30px 100px rgba(0, 0, 0, 0.8), 
                        inset 0 1px 0 rgba(255, 255, 255, 0.1);
            backdrop-filter: blur(20px);
            margin-bottom: 45px;
            position: relative;
            overflow: hidden;
        }

        video {
            width: 100%;
            border-radius: 20px;
            display: block;
            background: #000;
            box-shadow: 0 5px 20px rgba(0,0,0,0.5);
        }

        /* Control bar inside video screen */
        .video-info-overlay {
            position: absolute;
            bottom: 25px;
            left: 25px;
            right: 25px;
            background: rgba(15, 23, 42, 0.6);
            backdrop-filter: blur(12px);
            border: 1px solid rgba(255, 255, 255, 0.08);
            border-radius: 16px;
            padding: 12px 20px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            opacity: 0;
            transform: translateY(10px);
            transition: all 0.4s ease;
            pointer-events: none;
        }

        .video-wrapper:hover .video-info-overlay {
            opacity: 1;
            transform: translateY(0);
        }

        .video-title {
            font-size: 0.85rem;
            font-weight: 700;
            color: #fff;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        /* Deploy Button styling */
        .btn-deploy {
            background: linear-gradient(135deg, #0061f2 0%, #0029b3 100%);
            color: #fff;
            padding: 18px 45px;
            border-radius: 20px;
            font-weight: 800;
            font-size: 1.05rem;
            text-transform: uppercase;
            letter-spacing: 1.5px;
            border: none;
            box-shadow: 0 15px 35px rgba(0, 97, 242, 0.4),
                        0 0 0 1px rgba(255, 255, 255, 0.1);
            transition: all 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
            display: inline-flex;
            align-items: center;
            gap: 15px;
            text-decoration: none !important;
            position: relative;
            overflow: hidden;
        }

        .btn-deploy::before {
            content: '';
            position: absolute;
            top: 0; left: -100%;
            width: 100%; height: 100%;
            background: linear-gradient(90deg, transparent, rgba(255,255,255,0.2), transparent);
            transition: all 0.6s ease;
        }

        .btn-deploy:hover {
            color: #fff;
            transform: translateY(-5px) scale(1.02);
            box-shadow: 0 20px 45px rgba(0, 97, 242, 0.6),
                        0 0 0 2px rgba(255, 255, 255, 0.2);
        }

        .btn-deploy:hover::before {
            left: 100%;
        }

        .btn-deploy i {
            font-size: 1.2rem;
            transition: transform 0.3s ease;
        }

        .btn-deploy:hover i {
            transform: translateX(5px);
        }

        @@keyframes fadeIn {
            from { opacity: 0; transform: translateY(20px); }
            to { opacity: 1; transform: translateY(0); }
        }

        @@keyframes pulse-ring {
            0% { transform: scale(0.95); opacity: 0.5; }
            50% { transform: scale(1.1); opacity: 1; }
            100% { transform: scale(0.95); opacity: 0.5; }
        }

        /* Responsive */
        @@media (max-width: 768px) {
            h1 { font-size: 2.1rem; }
            p.subtitle { font-size: 0.95rem; }
            .btn-deploy { padding: 15px 30px; font-size: 0.95rem; }
        }
    </style>
</head>
<body>
    <!-- Glow effects background -->
    <div class="glow-blob blob-1"></div>
    <div class="glow-blob blob-2"></div>

    <div class="start-container">
        <div class="system-badge">
            <i class="fas fa-circle text-success" style="font-size: 0.6rem;"></i> 
            DLU Intelligent Core v2.0
        </div>
        
        <h1>Hội nghị Công bố Chuyển đổi số</h1>
        <p class="subtitle">Trải nghiệm nền tảng quản lý số hóa Đoàn viên và Tổ chức Cơ sở Đoàn thế hệ mới.</p>

        <!-- Video Showcase block -->
        <div class="video-wrapper">
            <video id="introVideo" controls autoplay muted playsinline loop>
                <source src="/videos/intro.mp4" type="video/mp4" />
                Trình duyệt của bạn không hỗ trợ phát thẻ video.
            </video>
            <div class="video-info-overlay">
                <div class="video-title">
                    <i class="fas fa-play-circle text-primary"></i> Video giới thiệu & lễ công bố phần mềm QLDV
                </div>
                <div class="badge bg-primary-subtle text-primary" style="font-size: 0.65rem;">HD 1080P</div>
            </div>
        </div>

        <!-- Deploy (Triển khai) button to access system -->
        <div>
            <a href="/dashboard" class="btn-deploy">
                Triển khai hệ thống <i class="fas fa-arrow-right"></i>
            </a>
        </div>
    </div>

    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script>
        $(document).ready(function() {
            // Unmute the video on first user interaction if blocked by browsers auto-play policy
            const video = document.getElementById('introVideo');
            if (video) {
                $(document).one('click touchstart', function() {
                    video.muted = false;
                });
            }
        });
    </script>
</body>
</html>
