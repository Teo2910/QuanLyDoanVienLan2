@model List<QLDV.Models.Award>
@{
    ViewData["Title"] = "Quản lý khen thưởng";
    Layout = "~/Views/Shared/_Layout.cshtml";

    string currentSearch = ViewBag.Search ?? "";
    string selectedUnit = ViewBag.SelectedUnit ?? "";
    string selectedTargetType = ViewBag.SelectedTargetType ?? "";
    string selectedLevel = ViewBag.SelectedLevel ?? "";
}

<div class="page-header-premium">
    <div class="header-main">
        <div class="header-left-box">
            <div class="header-icon-premium">
                <i class="fas fa-trophy" style="color: var(--primary);"></i>
            </div>
            <div class="header-text-premium">
                <h1>Quản lý khen thưởng</h1>
                <p>VINH DANH CÁC TẬP THỂ VÀ CÁ NHÂN TIÊU BIỂU</p>
            </div>
        </div>
        <div class="d-flex flex-wrap gap-2 gap-sm-3 mt-3 mt-lg-0">
            <a href="/awards/create" class="btn-premium btn-launch-dark px-3 px-sm-4">
                <i class="fas fa-plus"></i> <span class="d-none d-sm-inline">ĐĂNG KÝ KHEN THƯỞNG</span><span class="d-sm-none">THÊM</span>
            </a>
        </div>
    </div>
</div>

<!-- Thống kê nhanh khen thưởng -->
<div class="row g-4 mb-4">
    <div class="col-sm-6 col-lg-4">
        <div class="stat-card-new accent-blue">
            <div class="icon-box">
                <i class="fas fa-medal"></i>
            </div>
            <p>Tổng số lượt khen thưởng</p>
            <h2>@ViewBag.TotalCount</h2>
        </div>
    </div>
    <div class="col-sm-6 col-lg-4">
        <div class="stat-card-new accent-green">
            <div class="icon-box">
                <i class="fas fa-users"></i>
            </div>
            <p>Khen thưởng cá nhân</p>
            <h2>@ViewBag.MemberAwardsCount</h2>
        </div>
    </div>
    <div class="col-sm-6 col-lg-4">
        <div class="stat-card-new accent-amber">
            <div class="icon-box">
                <i class="fas fa-building"></i>
            </div>
            <p>Khen thưởng tập thể (đơn vị)</p>
            <h2>@ViewBag.UnitAwardsCount</h2>
        </div>
    </div>
</div>

<!-- Biểu đồ thống kê số lần được khen thưởng của từng đơn vị -->
<div class="card-premium mb-4 p-4" style="border-radius: 30px;">
    <div class="section-header mb-4">
        <div class="section-title" style="font-size: 0.7rem; color: #94a3b8; letter-spacing: 1px;">
            <i class="fas fa-chart-bar me-2"></i>THỐNG KÊ SỐ LẦN ĐƯỢC KHEN THƯỞNG CỦA TỪNG ĐƠN VỊ
        </div>
    </div>
    <div style="height: 250px; position: relative;">
        <canvas id="awardsByUnitChart"></canvas>
    </div>
</div>

<!-- Bộ lọc tìm kiếm -->
<div class="card-premium mb-5">
    <form id="filterForm" method="get" action="/awards">
        <div class="d-flex flex-wrap gap-4 align-items-center filter-row-premium">
            <div class="search-box-premium flex-grow-1" style="max-width: 600px;">
                <i class="fas fa-search"></i>
                <input type="text" name="search" placeholder="Tìm kiếm nội dung, hình thức khen thưởng, tên cá nhân..." id="advancedSearch" value="@currentSearch">
            </div>
            <div class="d-flex gap-2 filter-btns-group">
                <button type="button" class="btn-premium btn-premium-dark px-4" id="toggleAdvancedFilter">
                    <i class="fas fa-filter"></i> LỌC NÂNG CAO
                </button>
                <button type="button" class="btn-premium btn-premium-light px-3" id="resetFilters" title="Làm mới">
                    <i class="fas fa-sync-alt"></i>
                </button>
            </div>
        </div>

        <div class="collapse @(!string.IsNullOrEmpty(selectedUnit) || !string.IsNullOrEmpty(selectedTargetType) || !string.IsNullOrEmpty(selectedLevel) ? "show" : "") mt-4" id="filterPanel">
            <div class="row g-3">
                <div class="col-md-4">
                    <label class="form-label-premium">ĐƠN VỊ CHI ĐOÀN</label>
                    <div class="filter-dropdown-container">
                        <input type="hidden" name="unit" id="unitFilterValue" value="@selectedUnit">
                        <div class="filter-dropdown-trigger" onclick="toggleFilterDropdown(this)">
                            <span class="selected-text">@(string.IsNullOrEmpty(selectedUnit) ? "Tất cả chi đoàn" : selectedUnit)</span>
                            <i class="fas fa-chevron-down"></i>
                        </div>
                        <div class="filter-dropdown-menu">
                            <div class="filter-dropdown-item @(string.IsNullOrEmpty(selectedUnit) ? "selected" : "")" data-value="" onclick="selectFilterOption(this, 'unit', 'Tất cả chi đoàn')">
                                Tất cả chi đoàn <i class="fas fa-check"></i>
                            </div>
                            @if (ViewBag.Units != null)
                            {
                                @foreach (var unit in ViewBag.Units)
                                {
                                    <div class="filter-dropdown-item @(selectedUnit == unit.Name ? "selected" : "")" data-value="@unit.Name" onclick="selectFilterOption(this, 'unit', '@unit.Name')">
                                        @unit.Name <i class="fas fa-check"></i>
                                    </div>
                                }
                            }
                        </div>
                    </div>
                </div>

                <div class="col-md-4">
                    <label class="form-label-premium">ĐỐI TƯỢNG KHEN THƯỞNG</label>
                    <div class="filter-dropdown-container">
                        <input type="hidden" name="targetType" id="targetTypeFilterValue" value="@selectedTargetType">
                        <div class="filter-dropdown-trigger" onclick="toggleFilterDropdown(this)">
                            <span class="selected-text">@(string.IsNullOrEmpty(selectedTargetType) ? "Tất cả đối tượng" : selectedTargetType)</span>
                            <i class="fas fa-chevron-down"></i>
                        </div>
                        <div class="filter-dropdown-menu">
                            <div class="filter-dropdown-item @(string.IsNullOrEmpty(selectedTargetType) ? "selected" : "")" data-value="" onclick="selectFilterOption(this, 'targetType', 'Tất cả đối tượng')">
                                Tất cả đối tượng <i class="fas fa-check"></i>
                            </div>
                            @foreach (var type in ViewBag.TargetTypes)
                            {
                                <div class="filter-dropdown-item @(selectedTargetType == type ? "selected" : "")" data-value="@type" onclick="selectFilterOption(this, 'targetType', '@type')">
                                    @type <i class="fas fa-check"></i>
                                </div>
                            }
                        </div>
                    </div>
                </div>

                <div class="col-md-4">
                    <label class="form-label-premium">CẤP KHEN THƯỞNG</label>
                    <div class="filter-dropdown-container">
                        <input type="hidden" name="level" id="levelFilterValue" value="@selectedLevel">
                        <div class="filter-dropdown-trigger" onclick="toggleFilterDropdown(this)">
                            <span class="selected-text">@(string.IsNullOrEmpty(selectedLevel) ? "Tất cả cấp" : selectedLevel)</span>
                            <i class="fas fa-chevron-down"></i>
                        </div>
                        <div class="filter-dropdown-menu">
                            <div class="filter-dropdown-item @(string.IsNullOrEmpty(selectedLevel) ? "selected" : "")" data-value="" onclick="selectFilterOption(this, 'level', 'Tất cả cấp')">
                                Tất cả cấp <i class="fas fa-check"></i>
                            </div>
                            @foreach (var level in ViewBag.Levels)
                            {
                                <div class="filter-dropdown-item @(selectedLevel == level ? "selected" : "")" data-value="@level" onclick="selectFilterOption(this, 'level', '@level')">
                                    @level <i class="fas fa-check"></i>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </form>
</div>

<!-- Danh sách khen thưởng -->
<div class="member-list-card-premium">
    <div class="list-title-header">
        <div class="list-title-box">
            <h2>Hồ sơ khen thưởng thi đua</h2>
            <p>DANH SÁCH LƯU TRỮ VÀ QUẢN LÝ THÀNH TÍCH</p>
        </div>
        <div class="result-count-badge">@Model.Count KẾT QUẢ</div>
    </div>

    <div class="table-responsive">
        <table class="table-members-v2">
            <thead>
                <tr>
                    <th style="width: 80px;">STT</th>
                    <th>NỘI DUNG KHEN THƯỞNG</th>
                    <th>HÌNH THỨC</th>
                    <th>ĐỐI TƯỢNG</th>
                    <th>TẬP THỂ/CÁ NHÂN</th>
                    <th>ĐƠN VỊ CHI ĐOÀN</th>
                    <th>CẤP KT</th>
                    <th>THỜI GIAN</th>
                    <th class="text-end" style="width: 150px;">HÀNH ĐỘNG</th>
                </tr>
            </thead>
            <tbody>
                @{ int i = 1; }
                @foreach (var item in Model)
                {
                    <tr class="member-row-v2" onclick="location.href='/awards/details/@item.Id'" style="cursor: pointer;">
                        <td><span class="row-index">@(i < 10 ? "0" + i : i.ToString())</span></td>
                        <td>
                            <div class="fw-bold text-dark" style="font-size: 0.9rem;">@item.Content</div>
                        </td>
                        <td data-label="HÌNH THỨC">
                            <span class="badge bg-primary p-2" style="font-size: 0.7rem; border-radius: 8px;">@item.Form</span>
                        </td>
                        <td data-label="ĐỐI TƯỢNG">
                            <span class="badge @(item.TargetType == "Cá nhân" ? "bg-info text-dark" : "bg-warning text-dark") p-2" style="font-size: 0.7rem; border-radius: 8px;">@item.TargetType</span>
                        </td>
                        <td data-label="TẬP THỂ/CÁ NHÂN">
                            @if (item.TargetType == "Cá nhân")
                            {
                                <div class="fw-semibold text-dark">@(item.Member?.FullName ?? "N/A")</div>
                                <span class="text-muted small">@item.Member?.MemberId</span>
                            }
                            else
                            {
                                <div class="fw-semibold text-primary">@(item.Unit?.Name ?? "N/A")</div>
                            }
                        </td>
                        <td data-label="CHI ĐOÀN">
                            <div class="unit-text-v2">@(item.Unit?.Name ?? "N/A")</div>
                        </td>
                        <td data-label="CẤP KT">
                            <span class="text-dark fw-bold" style="font-size: 0.75rem;">@item.Level</span>
                        </td>
                        <td data-label="THỜI GIAN">
                            <div class="d-flex align-items-center gap-2">
                                <i class="far fa-calendar-alt text-muted" style="font-size: 0.8rem;"></i>
                                <span class="text-dark fw-bold" style="font-size: 0.75rem;">
                                    @if (DateTime.TryParse(item.Date, out var parsedDate))
                                    {
                                        @parsedDate.ToString("dd/MM/yyyy")
                                    }
                                    else
                                    {
                                        @item.Date
                                    }
                                </span>
                            </div>
                        </td>
                        <td class="text-end" onclick="event.stopPropagation()">
                            <div class="d-flex justify-content-end gap-2">
                                <a href="/awards/details/@item.Id" class="btn-premium btn-premium-light p-2 px-3" title="Chi tiết">
                                    <i class="fas fa-eye"></i>
                                </a>
                                <a href="/awards/edit/@item.Id" class="btn-premium btn-premium-light p-2 px-3" title="Sửa">
                                    <i class="fas fa-edit"></i>
                                </a>
                                <a href="/awards/delete/@item.Id" class="btn-premium btn-premium-light p-2 px-3 text-danger" title="Xóa">
                                    <i class="fas fa-trash-alt"></i>
                                </a>
                            </div>
                        </td>
                    </tr>
                    i++;
                }
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="9" class="text-center py-5 text-muted fw-bold">Không tìm thấy thông tin khen thưởng nào.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js@3.7.0/dist/chart.min.js"></script>
    <script>
        $(document).ready(function() {
            // Biểu đồ thống kê số lần được khen thưởng của từng đơn vị
            const unitStats = @Html.Raw(Json.Serialize(ViewBag.UnitStats));
            const unitCtx = document.getElementById('awardsByUnitChart').getContext('2d');
            
            const unitLabels = Object.keys(unitStats);
            const unitValues = Object.values(unitStats);

            new Chart(unitCtx, {
                type: 'bar',
                data: {
                    labels: unitLabels.length > 0 ? unitLabels : ['Chưa có dữ liệu'],
                    datasets: [{
                        label: 'Số lần được khen thưởng',
                        data: unitValues.length > 0 ? unitValues : [0],
                        backgroundColor: '#10b981',
                        borderRadius: 8,
                        barThickness: 25
                    }]
                },
                options: {
                    maintainAspectRatio: false,
                    plugins: { legend: { display: false } },
                    scales: {
                        x: { grid: { display: false }, ticks: { font: { weight: '700' } } },
                        y: { beginAtZero: true, grid: { borderDash: [5, 5] }, ticks: { stepSize: 1 } }
                    }
                }
            });

            // Panel nâng cao
            $("#toggleAdvancedFilter").on("click", function() {
                $("#filterPanel").collapse('toggle');
                $(this).toggleClass('active');
            });

            $("#resetFilters").on("click", function() {
                location.href = "/awards";
            });

            window.toggleFilterDropdown = function(trigger) {
                const menu = trigger.nextElementSibling;
                const isOpen = menu.classList.contains('show');
                document.querySelectorAll('.filter-dropdown-menu').forEach(m => m.classList.remove('show'));
                document.querySelectorAll('.filter-dropdown-trigger').forEach(t => t.classList.remove('active'));
                if (!isOpen) {
                    menu.classList.add('show');
                    trigger.classList.add('active');
                }
            };

            window.selectFilterOption = function(option, name, label) {
                const container = option.closest('.filter-dropdown-container');
                const hiddenInput = container.querySelector('input[type="hidden"]');
                hiddenInput.value = option.getAttribute('data-value');
                $("#filterForm").submit();
            };

            $(document).on('click', function(e) {
                if (!$(e.target).closest('.filter-dropdown-container').length) {
                    document.querySelectorAll('.filter-dropdown-menu').forEach(m => m.classList.remove('show'));
                    document.querySelectorAll('.filter-dropdown-trigger').forEach(t => t.classList.remove('active'));
                }
            });
        });
    </script>
}
