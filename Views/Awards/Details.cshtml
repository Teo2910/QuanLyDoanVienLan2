@model QLDV.Models.Award
@{
    ViewData["Title"] = "Chi tiết khen thưởng";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="page-header-premium">
    <div class="header-main">
        <div class="header-left-box">
            <div class="header-icon-premium text-warning">
                <i class="fas fa-medal" style="color: var(--primary);"></i>
            </div>
            <div class="header-text-premium">
                <h1>Chi tiết khen thưởng thi đua</h1>
                <p>XEM TOÀN BỘ THÀNH TÍCH VÀ QUYẾT ĐỊNH KHEN THƯỞNG</p>
            </div>
        </div>
        <div class="d-flex gap-2">
            <a href="/awards" class="btn-premium btn-premium-light px-4">
                <i class="fas fa-arrow-left"></i> DANH SÁCH
            </a>
            <a href="/awards/edit/@Model.Id" class="btn-premium btn-launch-dark px-4">
                <i class="fas fa-edit"></i> CHỈNH SỬA
            </a>
        </div>
    </div>
</div>

<div class="card-premium mb-4" style="max-width: 800px; margin: 0 auto;">
    <div class="border-bottom pb-4 mb-4">
        <span class="badge @(Model.TargetType == "Cá nhân" ? "bg-info text-dark" : "bg-warning text-dark") p-2 mb-2" style="font-size: 0.75rem; border-radius: 8px;">
            Khen thưởng @Model.TargetType
        </span>
        <h2 class="text-dark fw-bold mb-1">@Model.Content</h2>
        <p class="text-muted small mb-0">Cấp khen thưởng: @Model.Level</p>
    </div>

    <div class="row g-4 mb-5">
        <div class="col-md-6">
            <div class="p-3 bg-light rounded-3" style="border: 1px solid #eef2f6;">
                <label class="form-label-premium text-muted mb-1">ĐỐI TƯỢNG ĐƯỢC KHEN THƯỞNG</label>
                <div class="fw-bold text-dark fs-6">
                    @if (Model.TargetType == "Cá nhân" && Model.Member != null)
                    {
                        <a href="/members/details/@Model.MemberId" class="text-decoration-none">@Model.Member.FullName</a>
                        <span class="text-muted font-monospace d-block small" style="font-weight: normal;">Mã ĐV: @Model.Member.MemberId</span>
                    }
                    else
                    {
                        <span>Tập thể @(Model.Unit?.Name ?? "N/A")</span>
                    }
                </div>
            </div>
        </div>

        <div class="col-md-6">
            <div class="p-3 bg-light rounded-3" style="border: 1px solid #eef2f6;">
                <label class="form-label-premium text-muted mb-1">ĐƠN VỊ CÔNG TÁC</label>
                <div class="fw-bold text-dark fs-6">
                    @(Model.Unit?.Name ?? "N/A")
                </div>
            </div>
        </div>

        <div class="col-md-6">
            <div class="p-3 bg-light rounded-3" style="border: 1px solid #eef2f6;">
                <label class="form-label-premium text-muted mb-1">HÌNH THỨC KHEN THƯỞNG</label>
                <div class="fw-bold text-primary fs-6">
                    @Model.Form
                </div>
            </div>
        </div>

        <div class="col-md-6">
            <div class="p-3 bg-light rounded-3" style="border: 1px solid #eef2f6;">
                <label class="form-label-premium text-muted mb-1">THỜI GIAN NHẬN QUYẾT ĐỊNH</label>
                <div class="fw-bold text-dark fs-6">
                    <i class="far fa-calendar-alt text-muted me-2"></i>
                    @if (DateTime.TryParse(Model.Date, out var parsedDate))
                    {
                        @parsedDate.ToString("dd/MM/yyyy")
                    }
                    else
                    {
                        @Model.Date
                    }
                </div>
            </div>
        </div>
    </div>
</div>
