@using Microsoft.AspNetCore.Identity
@using QLDV.Models
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - QLDV</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
    <style>
        .search-container-global {
            background: #f1f5f9;
            border-radius: 16px;
            padding: 0 15px;
            height: 44px;
            align-items: center;
            gap: 12px;
            width: 450px;
            transition: 0.3s;
            position: relative;
        }

        .search-container-global:focus-within {
            background: #fff;
            box-shadow: 0 10px 30px rgba(0,0,0,0.05);
            width: 500px;
        }

        .search-container-global i.fa-search { color: #94a3b8; font-size: 0.9rem; }
        
        .search-container-global input {
            border: none;
            background: transparent;
            width: 100%;
            outline: none;
            font-weight: 700;
            font-size: 0.85rem;
            color: #1e293b;
        }

        .search-magic-badge {
            background: #0f172a;
            color: #fff;
            padding: 4px 10px;
            border-radius: 8px;
            font-size: 0.6rem;
            font-weight: 800;
            display: flex;
            align-items: center;
            gap: 5px;
            letter-spacing: 0.5px;
        }

        .search-results-premium {
            position: absolute;
            top: calc(100% + 10px);
            left: 0;
            width: 100%;
            background: #fff;
            border-radius: 20px;
            box-shadow: 0 20px 50px rgba(0,0,0,0.1);
            border: 1px solid #f1f5f9;
            z-index: 1000;
            padding: 1rem;
            max-height: 400px;
            overflow-y: auto;
        }

        .search-result-item {
            padding: 12px 15px;
            border-radius: 12px;
            cursor: pointer;
            transition: 0.2s;
            border-bottom: 1px solid #f8fafc;
        }

        .search-result-item:hover { background: #f8fafc; transform: translateX(5px); }
        .search-result-item:last-child { border-bottom: none; }
        
        .search-result-item .title { font-weight: 800; font-size: 0.9rem; color: #1e293b; display: block; }
        .search-result-item .desc { font-size: 0.75rem; color: #94a3b8; font-weight: 600; }
    </style>
    @RenderSection("Styles", required: false)
</head>
<body>
    @if (SignInManager.IsSignedIn(User))
    {
        var user = await UserManager.GetUserAsync(User);
        bool isAdmin = user?.Role == "Admin" || User.IsInRole("Admin");

        <div class="mobile-header">
            <a href="/" class="mobile-brand">
                <div class="logo">QN</div>
                <span>Quản lý Đoàn</span>
            </a>
            <div class="menu-toggle" id="sidebarToggle">
                <i class="fas fa-bars"></i>
            </div>
        </div>

        <div class="sidebar-overlay" id="sidebarOverlay"></div>

        <div class="sidebar" id="sidebar">
            <div class="sidebar-brand-header">
                <a href="/" class="sidebar-brand-new">
                    <div class="brand-logo-badge">QN</div>
                    <div class="brand-text">
                        <h4>Quản lý Đoàn</h4>
                        <small>HỆ THỐNG THÔNG MINH</small>
                    </div>
                </a>
                <a href="javascript:void(0)" id="desktopSidebarToggle" class="sidebar-toggle-btn-new d-none d-md-flex">
                    <i class="fas fa-outdent"></i>
                </a>
            </div>

            <ul class="nav-menu">
                <li class="nav-item">
                    <a class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Dashboard" ? "active" : "")" href="/">
                        <i class="fas fa-th-large"></i>
                        <span>Tổng quan</span>
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Movements" ? "active" : "")" href="/movements">
                        <i class="fas fa-bullhorn"></i>
                        <span>@(isAdmin ? "Phong trào & Báo cáo" : "Báo cáo phong trào")</span>
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Units" ? "active" : "")" href="/units">
                        <i class="fas fa-building"></i>
                        <span>Quản lý đơn vị</span>
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Members" ? "active" : "")" href="/members">
                        <i class="fas fa-users"></i>
                        <span>Danh sách đoàn viên</span>
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Statistics" ? "active" : "")" href="/statistics">
                        <i class="fas fa-chart-line"></i>
                        <span>Thống kê</span>
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Documents" ? "active" : "")" href="/documents">
                        <i class="fas fa-file-contract"></i>
                        <span>Quản lý văn bản</span>
                    </a>
                </li>
                @if (isAdmin)
                {
                    <li class="nav-item">
                        <a class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Activities" ? "active" : "")" href="/activities">
                            <i class="fas fa-calendar-alt"></i>
                            <span>Hoạt động</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "KnowledgeBase" ? "active" : "")" href="/knowledgebase">
                            <i class="fas fa-book"></i>
                            <span>Tài liệu nghiệp vụ</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Admin" ? "active" : "")" href="/admin/users">
                            <i class="fas fa-user-shield"></i>
                            <span>Quản lý tài khoản</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Logs" ? "active" : "")" href="/logs">
                            <i class="fas fa-history"></i>
                            <span>Nhật ký hệ thống</span>
                        </a>
                    </li>
                }
                <li class="nav-item">
                    <a class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "AIAssistant" ? "active" : "")" href="/aiassistant">
                        <i class="fas fa-robot"></i>
                        <span>Trợ lý AI</span>
                    </a>
                </li>
            </ul>

            <div class="sidebar-footer">
                <a href="/Account/Profile" class="user-profile-sidebar" style="text-decoration: none; cursor: pointer; transition: 0.2s;">
                    <img src="@(string.IsNullOrEmpty(user?.AvatarUrl) ? "/images/default-avatar.png" : user.AvatarUrl)" class="user-avatar-sidebar" alt="Avatar">
                    <div class="user-info-sidebar">
                        <h6>@(user?.FullName ?? "User Name")</h6>
                        <p class="@(isAdmin ? "role-admin" : "")">@(isAdmin ? "QUẢN TRỊ VIÊN" : "THÀNH VIÊN")</p>
                    </div>
                </a>
                <form asp-controller="Account" asp-action="Logout" method="post" id="logoutForm">
                    <a href="javascript:document.getElementById('logoutForm').submit()" class="logout-link">
                        <i class="fas fa-arrow-right-from-bracket"></i>
                        <span>THOÁT HỆ THỐNG</span>
                    </a>
                </form>
            </div>
        </div>

        <div class="main-wrapper">
            <header class="top-bar">
                <div class="top-bar-left">
                    <a href="javascript:history.back()" class="close-btn d-none d-md-flex">
                        <i class="fas fa-chevron-left"></i>
                    </a>
                    <div class="page-info d-none d-sm-block">
                        <h5>@ViewData["Title"]</h5>
                        <span>DLU INTELLIGENT CORE</span>
                    </div>
                    <div class="search-container-global d-none d-xl-flex ms-4">
                        <i class="fas fa-search"></i>
                        <input type="text" id="global-search-input" placeholder="Tìm kiếm thông minh hoặc ra lệnh cho AI...">
                        <div class="search-magic-badge"><i class="fas fa-magic"></i> AI</div>
                        <div id="search-results-dropdown" class="search-results-premium d-none"></div>
                    </div>
                </div>
                <div class="user-nav-pill d-none d-lg-flex">
                    <div class="info">
                        <h6>@(user?.FullName ?? "User")</h6>
                        <p>@(isAdmin ? "QUẢN TRỊ VIÊN" : "BÍ THƯ HỆ THỐNG")</p>
                    </div>
                    <img src="@(string.IsNullOrEmpty(user?.AvatarUrl) ? "/images/default-avatar.png" : user.AvatarUrl)" alt="Avatar">
                </div>
            </header>
            <main role="main" class="main-content">
                @RenderBody()
            </main>
        </div>
    }
    else
    {
        @RenderBody()
    }

    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/6.0.1/signalr.min.js"></script>
    <partial name="_Toast" />
    <script>
        $(document).ready(function() {
            const toggle = $('#sidebarToggle');
            const sidebar = $('#sidebar');
            const overlay = $('#sidebarOverlay');

            function toggleSidebar() {
                sidebar.toggleClass('active');
                overlay.toggleClass('active');
                $('body').toggleClass('sidebar-open');
            }

            toggle.on('click', toggleSidebar);
            overlay.on('click', toggleSidebar);

            // Desktop Sidebar Toggle
            const desktopToggle = $('#desktopSidebarToggle');
            desktopToggle.on('click', function() {
                $('body').toggleClass('sidebar-collapsed');
                
                // Toggle icon
                const icon = $(this).find('i');
                if ($('body').hasClass('sidebar-collapsed')) {
                    icon.removeClass('fa-outdent').addClass('fa-indent');
                } else {
                    icon.removeClass('fa-indent').addClass('fa-outdent');
                }

                // Save state to localStorage
                localStorage.setItem('sidebarCollapsed', $('body').hasClass('sidebar-collapsed'));
            });

            // Restore sidebar state
            if (localStorage.getItem('sidebarCollapsed') === 'true' && window.innerWidth > 991) {
                $('body').addClass('sidebar-collapsed');
                $('#desktopSidebarToggle i').removeClass('fa-outdent').addClass('fa-indent');
            }

            // Close sidebar on link click (for mobile)
            $('.nav-link').on('click', function() {
                if (window.innerWidth <= 991) {
                    sidebar.removeClass('active');
                    overlay.removeClass('active');
                    $('body').removeClass('sidebar-open');
                }
            });

            // Global Search Logic
            let searchTimeout;
            const searchInput = $('#global-search-input');
            const searchDropdown = $('#search-results-dropdown');

            searchInput.on('input', function() {
                const query = $(this).val().trim();
                clearTimeout(searchTimeout);

                if (query.length < 3) {
                    searchDropdown.addClass('d-none');
                    return;
                }

                searchTimeout = setTimeout(() => {
                    searchDropdown.removeClass('d-none').html('<div class="text-center p-3"><div class="spinner-border spinner-border-sm text-primary"></div><div class="mt-2 small fw-bold text-muted">AI ĐANG TRUY XUẤT...</div></div>');
                    
                    fetch('/AIAssistant/Chat', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ message: "SEARCH: " + query })
                    })
                    .then(res => res.json())
                    .then(data => {
                        const response = data.response;
                        let html = '';
                        
                        if (response.includes('Tìm thấy') || response.includes('kết quả')) {
                            const lines = response.split('\n');
                            html += `<div class="p-2 border-bottom mb-2"><span class="badge bg-primary">KẾT QUẢ TÌM KIẾM</span></div>`;
                            lines.forEach(line => {
                                if (line.startsWith('- ') || line.match(/^\d\./)) {
                                    html += `<div class="search-result-item" onclick="location.href='/members'">
                                        <span class="title">${line.replace(/^- |\d\./, '')}</span>
                                        <span class="desc">Bấm để xem chi tiết trong danh sách</span>
                                    </div>`;
                                }
                            });
                        } else {
                            html = `<div class="p-3 text-center"><div class="text-muted small fw-bold">${response}</div></div>`;
                        }
                        
                        searchDropdown.html(html || `<div class="p-3 text-center text-muted small">Không tìm thấy thông tin phù hợp</div>`);
                    })
                    .catch(() => {
                        searchDropdown.html('<div class="p-3 text-center text-danger small">Lỗi kết nối AI</div>');
                    });
                }, 800);
            });

            $(document).on('click', (e) => {
                if (!$(e.target).closest('.search-container-global').length) {
                    searchDropdown.addClass('d-none');
                }
            });
        });
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
