@using Microsoft.AspNetCore.Identity
@using QLDV.Models
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - QLDV</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
    <link href="~/css/site.css" rel="stylesheet" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    @if (SignInManager.IsSignedIn(User))
    {
        var currentUser = UserManager.GetUserAsync(User).Result;
        <div class="sidebar-overlay" id="sidebarOverlay"></div>
        <div class="sidebar" id="sidebar">
            <a href="/" class="sidebar-brand">
                <div class="brand-logo-badge">QN</div>
                <div class="brand-text">
                    <h4>Quản lý Đoàn</h4>
                    <small>Hệ thống thông minh</small>
                </div>
            </a>

            <ul class="nav-menu">
                <li class="nav-item">
                    <a href="/" class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Dashboard" ? "active" : "")">
                        <i class="fas fa-th-large"></i> Tổng quan
                    </a>
                </li>
                <li class="nav-item">
                    <a href="/movements" class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Movements" ? "active" : "")">
                        <i class="fas fa-bullhorn"></i> Phong trào & Báo cáo
                    </a>
                </li>
                <li class="nav-item">
                    <a href="/units" class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Units" ? "active" : "")">
                        <i class="fas fa-building"></i> Quản lý đơn vị
                    </a>
                </li>
                <li class="nav-item">
                    <a href="/members" class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Members" ? "active" : "")">
                        <i class="fas fa-users"></i> Danh sách đoàn viên
                    </a>
                </li>
                <li class="nav-item">
                    <a href="/statistics" class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Statistics" ? "active" : "")">
                        <i class="fas fa-chart-line"></i> Thống kê
                    </a>
                </li>
                <li class="nav-item">
                    <a href="/activities" class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Activities" ? "active" : "")">
                        <i class="fas fa-calendar-alt"></i> Hoạt động
                    </a>
                </li>
                <li class="nav-item">
                    <a href="/knowledgebase" class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "KnowledgeBase" ? "active" : "")">
                        <i class="fas fa-book"></i> Tài liệu nghiệp vụ
                    </a>
                </li>
                <li class="nav-item">
                    <a href="/logs" class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Logs" ? "active" : "")">
                        <i class="fas fa-history"></i> Nhật ký hệ thống
                    </a>
                </li>
                <li class="nav-item">
                    <a href="/aiassistant" class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "AIAssistant" ? "active" : "")">
                        <i class="fas fa-robot"></i> Trợ lý AI
                    </a>
                </li>
            </ul>

            <div class="sidebar-footer">
                <div class="user-profile-sidebar" onclick="openProfileModal()">
                    <img src="@(currentUser?.AvatarUrl ?? "/images/default-avatar.png")" alt="Avatar" class="user-avatar-sidebar profile-avatar-img">
                    <div class="user-info-sidebar">
                        <h6 class="profile-fullname-text">@(currentUser?.FullName ?? currentUser?.UserName)</h6>
                        <p>@(currentUser?.Role ?? "Thành viên")</p>
                    </div>
                </div>
                <form asp-controller="Account" asp-action="Logout" method="post" id="logoutForm">
                    <a href="javascript:document.getElementById('logoutForm').submit()" class="logout-link">
                        <i class="fas fa-sign-out-alt"></i> Thoát hệ thống
                    </a>
                </form>
            </div>
        </div>

        <div class="main-wrapper">
            <header class="top-bar">
                <div class="mobile-toggle" onclick="toggleSidebar()">
                    <i class="fas fa-bars"></i>
                </div>
                <div class="page-title-box">
                    <a href="javascript:history.back()" class="back-btn">
                        <i class="fas fa-times" style="font-size: 1.2rem;"></i>
                    </a>
                    <h5>
                        Bảng điều khiển
                        <span>Phiên bản 2.5</span>
                    </h5>
                </div>
                <div class="user-nav-top-premium">
                    <div class="user-info">
                        <h6>@(currentUser?.FullName ?? currentUser?.UserName)</h6>
                        <p>@(currentUser?.Role?.ToUpper() ?? "QUẢN TRỊ VIÊN")</p>
                    </div>
                    <img src="@(currentUser?.AvatarUrl ?? "/images/default-avatar.png")" alt="Avatar" class="profile-avatar-img">
                </div>
            </header>

            <main class="main-content">
                @if (TempData["SuccessMessage"] != null)
                {
                    <div class="alert alert-success alert-dismissible fade show" role="alert" style="border-radius: 16px; border: none; box-shadow: 0 10px 30px rgba(16, 185, 129, 0.1);">
                        <i class="fas fa-check-circle me-2"></i> @TempData["SuccessMessage"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                }
                @RenderBody()
            </main>
        </div>
    }
    else
    {
        <div class="container-fluid">
            @RenderBody()
        </div>
    }

    @await Html.PartialAsync("_ChatWidget")
    @await Html.PartialAsync("_Toast")

    @if (SignInManager.IsSignedIn(User))
    {
        var currentUser = UserManager.GetUserAsync(User).Result;
        <!-- Profile Update Modal -->
        <div class="modal fade" id="profileModal" tabindex="-1" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content modal-content-premium">
                    <div class="modal-header modal-header-premium">
                        <h5 class="modal-title fw-bold">Cập nhật hồ sơ</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body modal-body-premium">
                        <form id="profileUpdateForm" enctype="multipart/form-data">
                            @Html.AntiForgeryToken()
                            <div class="text-center mb-4">
                                <div class="position-relative d-inline-block">
                                    <img id="profilePreview" src="@(currentUser?.AvatarUrl ?? "/images/default-avatar.png")" 
                                         class="user-nav-avatar" style="width: 100px; height: 100px; border-radius: 24px; object-fit: cover;">
                                    <label for="avatarInput" class="position-absolute bottom-0 end-0 bg-primary text-white rounded-circle d-flex align-items-center justify-content-center" 
                                           style="width: 32px; height: 32px; cursor: pointer; border: 3px solid #fff; transform: translate(25%, 25%);">
                                        <i class="fas fa-camera" style="font-size: 0.75rem;"></i>
                                    </label>
                                    <input type="file" id="avatarInput" name="Avatar" style="display: none;" accept="image/*" onchange="previewAvatar(this)">
                                </div>
                            </div>

                            <div class="mb-3">
                                <label class="form-label-premium">Họ và tên</label>
                                <input type="text" name="FullName" class="form-control form-control-premium" value="@currentUser?.FullName" required>
                            </div>

                            <div class="mb-4">
                                <label class="form-label-premium">Số điện thoại</label>
                                <input type="text" name="PhoneNumber" class="form-control form-control-premium" value="@currentUser?.PhoneNumber">
                            </div>

                            <div class="d-grid">
                                <button type="submit" id="btnSaveProfile" class="btn btn-premium btn-premium-primary w-100 p-3 justify-content-center">
                                    XÁC NHẬN CẬP NHẬT
                                </button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>

        <script>
            function toggleSidebar() {
                const sidebar = document.getElementById('sidebar');
                const overlay = document.getElementById('sidebarOverlay');
                sidebar.classList.toggle('show');
                overlay.classList.toggle('show');
            }

            document.getElementById('sidebarOverlay').addEventListener('click', toggleSidebar);

            function openProfileModal() {
                var myModal = new bootstrap.Modal(document.getElementById('profileModal'));
                myModal.show();
            }

            function previewAvatar(input) {
                if (input.files && input.files[0]) {
                    var reader = new FileReader();
                    reader.onload = function(e) {
                        document.getElementById('profilePreview').src = e.target.result;
                    }
                    reader.readAsDataURL(input.files[0]);
                }
            }

            window.addEventListener('DOMContentLoaded', (event) => {
                const form = document.getElementById('profileUpdateForm');
                if (form) {
                    form.addEventListener('submit', function(e) {
                        e.preventDefault();
                        const btn = document.getElementById('btnSaveProfile');
                        btn.disabled = true;
                        btn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span> ĐANG LƯU...';

                        var formData = new FormData(this);
                        
                        fetch('/Account/UpdateProfile', {
                            method: 'POST',
                            body: formData,
                            headers: {
                                'X-Requested-With': 'XMLHttpRequest'
                            }
                        })
                        .then(response => response.json())
                        .then(data => {
                            if (data.success) {
                                // Update sidebar and top UI
                                document.querySelectorAll('.profile-fullname-text').forEach(el => el.textContent = data.user.fullName);
                                document.querySelectorAll('.profile-avatar-img, .user-nav-avatar').forEach(el => el.src = data.user.avatarUrl);
                                document.querySelector('.user-nav-info h6').textContent = data.user.fullName;
                                
                                // Close modal
                                var modalEl = document.getElementById('profileModal');
                                var modal = bootstrap.Modal.getInstance(modalEl);
                                modal.hide();
                                
                                if (typeof toast !== 'undefined') {
                                    toast.success(data.message);
                                } else {
                                    alert(data.message);
                                }
                            } else {
                                alert(data.message);
                            }
                        })
                        .catch(error => {
                            console.error('Error:', error);
                            alert('Có lỗi xảy ra khi cập nhật hồ sơ.');
                        })
                        .finally(() => {
                            btn.disabled = false;
                            btn.innerHTML = 'XÁC NHẬN CẬP NHẬT';
                        });
                    });
                }
            });
        </script>
    }

    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

