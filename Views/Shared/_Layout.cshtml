@using Microsoft.AspNetCore.Identity
@using QLDV.Models
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - QLDV</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <style>
        :root {
            --primary-color: #1a73e8;
            --primary-gradient: linear-gradient(135deg, #1a73e8 0%, #0d47a1 100%);
            --sidebar-width: 280px;
            --bg-color: #f8f9fa;
            --card-shadow: 0 10px 30px rgba(0,0,0,0.04);
            --border-radius: 24px;
        }

        body {
            font-family: 'Inter', sans-serif;
            background-color: var(--bg-color);
            color: #1a1a1a;
            overflow-x: hidden;
        }

        /* Sidebar Styles */
        .sidebar {
            width: var(--sidebar-width);
            height: 100vh;
            position: fixed;
            left: 0;
            top: 0;
            background: #fff;
            border-right: 1px solid rgba(0,0,0,0.05);
            padding: 2rem 1.5rem;
            display: flex;
            flex-direction: column;
            z-index: 1000;
        }

        .sidebar-brand {
            display: flex;
            align-items: center;
            gap: 12px;
            margin-bottom: 3rem;
            text-decoration: none;
            color: inherit;
        }

        .sidebar-brand img {
            height: 40px;
            width: 40px;
            border-radius: 12px;
        }

        .sidebar-brand h4 {
            margin: 0;
            font-weight: 800;
            font-size: 1.25rem;
            letter-spacing: -0.5px;
        }

        .nav-menu {
            list-style: none;
            padding: 0;
            margin: 0;
            flex-grow: 1;
        }

        .nav-item {
            margin-bottom: 0.5rem;
        }

        .nav-link {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 0.875rem 1.25rem;
            border-radius: 16px;
            color: #666;
            text-decoration: none;
            font-weight: 600;
            font-size: 0.95rem;
            transition: all 0.2s;
        }

        .nav-link:hover {
            background: #f0f4f8;
            color: var(--primary-color);
        }

        .nav-link.active {
            background: #e8f0fe;
            color: var(--primary-color);
            box-shadow: 0 4px 12px rgba(26, 115, 232, 0.1);
        }

        .nav-link i {
            font-size: 1.1rem;
            width: 24px;
            text-align: center;
        }

        /* Sidebar Footer */
        .sidebar-footer {
            margin-top: auto;
            padding-top: 2rem;
            border-top: 1px solid #eee;
        }

        .user-profile-sm {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 1rem;
            background: #f8f9fa;
            border-radius: 16px;
            margin-bottom: 1rem;
        }

        .user-avatar-sm {
            width: 40px;
            height: 40px;
            border-radius: 50%;
            object-fit: cover;
        }

        .user-info-sm h6 {
            margin: 0;
            font-weight: 700;
            font-size: 0.9rem;
        }

        .user-info-sm p {
            margin: 0;
            font-size: 0.75rem;
            color: #666;
        }

        .logout-btn {
            display: flex;
            align-items: center;
            gap: 8px;
            color: #dc3545;
            text-decoration: none;
            font-weight: 600;
            font-size: 0.9rem;
            padding: 0.5rem 1rem;
        }

        /* Main Content Styles */
        .main-wrapper {
            margin-left: var(--sidebar-width);
            min-height: 100vh;
            display: flex;
            flex-direction: column;
        }

        .top-bar {
            padding: 1.5rem 3rem;
            display: flex;
            justify-content: space-between;
            align-items: center;
            background: transparent;
        }

        .page-title-box h5 {
            margin: 0;
            font-weight: 800;
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .page-title-box span {
            font-size: 0.75rem;
            color: #28a745;
            text-transform: uppercase;
            letter-spacing: 1px;
        }

        .main-content {
            padding: 0 3rem 3rem 3rem;
            flex-grow: 1;
        }

        /* Card Customization */
        .card {
            border: none;
            border-radius: var(--border-radius);
            box-shadow: var(--card-shadow);
            background: #fff;
        }

        /* Form Controls */
        .form-control, .form-select {
            border-radius: 12px;
            padding: 0.75rem 1rem;
            border: 1px solid #eee;
            background-color: #fcfcfc;
        }

        .form-control:focus {
            box-shadow: 0 0 0 4px rgba(26, 115, 232, 0.1);
            border-color: var(--primary-color);
        }

        .btn {
            border-radius: 12px;
            padding: 0.75rem 1.5rem;
            font-weight: 700;
        }
    </style>
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    @if (SignInManager.IsSignedIn(User))
    {
        var currentUser = UserManager.GetUserAsync(User).Result;
        <div class="sidebar">
            <a href="/" class="sidebar-brand">
                <img src="/images/logo.png" alt="Logo">
                <div class="brand-text">
                    <h4>Quản lý Đoàn</h4>
                    <small class="text-muted" style="font-size: 0.6rem; text-transform: uppercase; letter-spacing: 1px;">Hệ thống thông minh</small>
                </div>
            </a>

            <ul class="nav-menu">
                <li class="nav-item">
                    <a href="/" class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Dashboard" ? "active" : "")">
                        <i class="fas fa-th-large"></i> Tổng quan
                    </a>
                </li>
                <li class="nav-item">
                    <a href="/movements" class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Movements" ? "active" : "")">
                        <i class="fas fa-bullhorn"></i> Phong trào & Báo cáo
                    </a>
                </li>
                <li class="nav-item">
                    <a href="/units" class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Units" ? "active" : "")">
                        <i class="fas fa-building"></i> Quản lý đơn vị
                    </a>
                </li>
                <li class="nav-item">
                    <a href="/members" class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Members" ? "active" : "")">
                        <i class="fas fa-users"></i> Danh sách đoàn viên
                    </a>
                </li>
                <li class="nav-item">
                    <a href="/statistics" class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Statistics" ? "active" : "")">
                        <i class="fas fa-chart-line"></i> Thống kê
                    </a>
                </li>
                <li class="nav-item">
                    <a href="/activities" class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Activities" ? "active" : "")">
                        <i class="fas fa-calendar-alt"></i> Hoạt động
                    </a>
                </li>
                <li class="nav-item">
                    <a href="/knowledgebase" class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "KnowledgeBase" ? "active" : "")">
                        <i class="fas fa-book"></i> Tài liệu nghiệp vụ
                    </a>
                </li>
                <li class="nav-item">
                    <a href="/logs" class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Logs" ? "active" : "")">
                        <i class="fas fa-history"></i> Nhật ký hệ thống
                    </a>
                </li>
                <li class="nav-item">
                    <a href="/aiassistant" class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "AIAssistant" ? "active" : "")">
                        <i class="fas fa-robot"></i> Trợ lý AI
                    </a>
                </li>
            </ul>

            <div class="sidebar-footer">
                <div class="user-profile-sm">
                    <img src="@(currentUser?.AvatarUrl ?? "/images/default-avatar.png")" alt="Avatar" class="user-avatar-sm">
                    <div class="user-info-sm">
                        <h6>@(currentUser?.FullName ?? currentUser?.UserName)</h6>
                        <p>@(currentUser?.Role ?? "Thành viên")</p>
                    </div>
                </div>
                <form asp-controller="Account" asp-action="Logout" method="post" id="logoutForm">
                    <a href="javascript:document.getElementById('logoutForm').submit()" class="logout-btn">
                        <i class="fas fa-sign-out-alt"></i> Thoát hệ thống
                    </a>
                </form>
            </div>
        </div>

        <div class="main-wrapper">
            <header class="top-bar">
                <div class="page-title-box">
                    <h5>
                        <button class="btn btn-light rounded-circle me-3" style="width: 40px; height: 40px; padding: 0;">
                            <i class="fas fa-times"></i>
                        </button>
                        Bảng điều khiển
                        <span class="ms-2">• Phiên bản 2.5</span>
                    </h5>
                </div>
                <div class="user-nav">
                    <!-- Right side user info if needed -->
                </div>
            </header>

            <main class="main-content">
                @if (TempData["SuccessMessage"] != null)
                {
                    <div class="alert alert-success alert-dismissible fade show" role="alert">
                        @TempData["SuccessMessage"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                }
                @RenderBody()
            </main>
        </div>
    }
    else
    {
        <div class="container-fluid">
            @RenderBody()
        </div>
    }

    @await Html.PartialAsync("_ChatWidget")
    @await Html.PartialAsync("_Toast")

    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
