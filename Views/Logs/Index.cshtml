@model List<QLDV.Models.SystemLog>
@{
    ViewData["Title"] = "System Logs";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="content-header">
    <h1><i class="fas fa-history"></i> System Logs</h1>
    <p class="text-muted">View all system activities and user actions</p>
</div>

<div class="card">
    <div class="card-header">
        <div class="row">
            <div class="col-md-4">
                <input type="text" id="userFilter" class="form-control" placeholder="Filter by user...">
            </div>
            <div class="col-md-4">
                <select id="actionFilter" class="form-select">
                    <option value="">All Actions</option>
                    <option value="CREATE">Create</option>
                    <option value="UPDATE">Update</option>
                    <option value="DELETE">Delete</option>
                    <option value="STATUS_CHANGE">Status Change</option>
                    <option value="SUBMIT_REPORT">Submit Report</option>
                </select>
            </div>
            <div class="col-md-4">
                <select id="entityFilter" class="form-select">
                    <option value="">All Entities</option>
                    <option value="Member">Member</option>
                    <option value="Unit">Unit</option>
                    <option value="Activity">Activity</option>
                    <option value="Movement">Movement</option>
                </select>
            </div>
        </div>
    </div>
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-striped table-hover" id="logsTable">
                <thead>
                    <tr>
                        <th>Time</th>
                        <th>User</th>
                        <th>Action</th>
                        <th>Entity Type</th>
                        <th>Entity ID</th>
                        <th>Details</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var log in Model?.OrderByDescending(l => l.Timestamp).ToList() ?? new List<QLDV.Models.SystemLog>())
                    {
                        <tr>
                            <td>
                                <small>@(new DateTime(log.Timestamp, DateTimeKind.Utc).ToString("g"))</small>
                            </td>
                            <td>@log.UserName</td>
                            <td>
                                @{
                                    var actionBadgeColor = log.Action switch
                                    {
                                        "CREATE" => "success",
                                        "UPDATE" => "info",
                                        "DELETE" => "danger",
                                        "STATUS_CHANGE" => "warning",
                                        _ => "secondary"
                                    };
                                }
                                <span class="badge bg-@actionBadgeColor">@log.Action</span>
                            </td>
                            <td>@log.EntityType</td>
                            <td><code>@log.EntityId</code></td>
                            <td>
                                <small>@(log.Details?.Length > 50 ? log.Details.Substring(0, 50) + "..." : log.Details)</small>
                            </td>
                            <td>
                                <a href="/logs/details/@log.Id" class="btn btn-sm btn-info" title="View Details">
                                    <i class="fas fa-eye text-white"></i>
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        @if ((Model?.Count ?? 0) == 0)
        {
            <div class="text-center py-5">
                <i class="fas fa-inbox" style="font-size: 3rem; color: #ccc;"></i>
                <p class="text-muted mt-3">No logs found</p>
            </div>
        }
    </div>
</div>

@section Scripts {
    <script>
        function filterTable() {
            const userFilter = document.getElementById('userFilter').value.toLowerCase();
            const actionFilter = document.getElementById('actionFilter').value;
            const entityFilter = document.getElementById('entityFilter').value;

            document.querySelectorAll('#logsTable tbody tr').forEach(row => {
                const user = row.cells[1].textContent.toLowerCase();
                const action = row.cells[2].textContent;
                const entity = row.cells[3].textContent;

                const userMatch = !userFilter || user.includes(userFilter);
                const actionMatch = !actionFilter || action.includes(actionFilter);
                const entityMatch = !entityFilter || entity.includes(entityFilter);

                row.style.display = userMatch && actionMatch && entityMatch ? '' : 'none';
            });
        }

        document.getElementById('userFilter').addEventListener('keyup', filterTable);
        document.getElementById('actionFilter').addEventListener('change', filterTable);
        document.getElementById('entityFilter').addEventListener('change', filterTable);
    </script>
}
