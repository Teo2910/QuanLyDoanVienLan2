@using Microsoft.AspNetCore.Identity
@using QLDV.Models
@inject UserManager<ApplicationUser> UserManager
@{
    ViewData["Title"] = "Tổng quan";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var currentUser = await UserManager.GetUserAsync(User);
}

<style>
    @@media (max-width: 768px) {
        .welcome-text h1 {
            font-size: 1.8rem !important;
            letter-spacing: -1px;
        }

        .welcome-text p {
            font-size: 0.55rem !important;
            letter-spacing: 1px;
        }

        .stat-card-new {
            padding: 1.5rem 1rem !important;
            border-radius: 25px !important;
        }

        .stat-card-new h2 {
            font-size: 2.2rem !important;
        }

        .section-wrapper {
            padding: 1.5rem !important;
            border-radius: 25px !important;
        }

        .item-row, .member-pill {
            padding: 1rem !important;
            border-radius: 16px !important;
        }

        .item-body h6, .member-details h6 {
            font-size: 0.9rem !important;
        }

        .item-date-side span {
            font-size: 0.9rem !important;
        }
    }
</style>

<div class="welcome-row">
    <div class="welcome-text">
        <h1>Xin chào, <span style="color: var(--primary);">@(currentUser?.FullName ?? "Cán bộ Đoàn")</span></h1>
        <p>Hệ thống quản lý đoàn cơ sở thông minh</p>
    </div>
    <div class="session-pill d-none d-md-flex">
        <div class="session-icon" style="color: var(--primary);">
            <i class="fas fa-calendar-check"></i>
        </div>
        <div class="session-info">
            <span>Phiên làm việc</span>
            <h6>@(DateTime.Now.ToString("dddd, dd/MM/yyyy"))</h6>
        </div>
    </div>
</div>

<div class="row g-4 g-md-5">
    <div class="col-xl-3 col-sm-6">
        <div class="stat-card-new">
            <div class="icon-box" style="color: var(--primary);">
                <i class="fas fa-building"></i>
            </div>
            <p>Tổng số chi đoàn</p>
            <h2>@ViewBag.TotalUnits</h2>
        </div>
    </div>
    <div class="col-xl-3 col-sm-6">
        <div class="stat-card-new">
            <div class="icon-box" style="color: #10b981;">
                <i class="fas fa-users"></i>
            </div>
            <p>Tổng số đoàn viên</p>
            <h2>@ViewBag.TotalMembers</h2>
        </div>
    </div>
    <div class="col-xl-3 col-sm-6">
        <div class="stat-card-new">
            <div class="icon-box" style="color: #f59e0b;">
                <i class="fas fa-calendar-day"></i>
            </div>
            <p>Hoạt động sắp tới</p>
            <h2>@ViewBag.UpcomingActivitiesCount</h2>
        </div>
    </div>
    <div class="col-xl-3 col-sm-6">
        <div class="stat-card-new">
            <div class="icon-box" style="color: #ef4444;">
                <i class="fas fa-star"></i>
            </div>
            <p>Đoàn viên tiêu biểu</p>
            <h2>@ViewBag.OutstandingMembersCount</h2>
        </div>
    </div>
</div>

<div class="row mt-4 g-5">
    <div class="col-lg-6">
        <div class="section-wrapper">
            <div class="section-head">
                <div class="section-title-premium">Hoạt động sắp tới</div>
                <a href="/activities" class="section-link-premium">Xem tất cả</a>
            </div>
            <div class="items-list">
                @foreach (var activity in ViewBag.UpcomingActivities as List<Activity> ?? new List<Activity>())
                {
                    <div class="item-row">
                        <div class="item-icon-box">
                            <i class="far fa-calendar-alt"></i>
                        </div>
                        <div class="item-body">
                            <h6>@activity.Title</h6>
                            <span class="tag">@activity.Type</span>
                        </div>
                        <div class="item-date-side">
                            @{
                                if (DateTime.TryParse(activity.Date, out var date))
                                {
                                    <span>@date.ToString("dd")-@date.AddDays(5).ToString("dd")</span>
                                    <small>@date.ToString("MM/yyyy")</small>
                                }
                            }
                        </div>
                    </div>
                }
                @if (!(ViewBag.UpcomingActivities as List<Activity>)?.Any() ?? true)
                {
                    <div class="item-row">
                        <div class="item-body">
                            <h6>Giải đấu Valorant: DLU E-Sports Championship</h6>
                            <span class="tag">THỂ THAO</span>
                        </div>
                        <div class="item-date-side">
                            <span>05-10</span>
                            <small>10/2026</small>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
    <div class="col-lg-6">
        <div class="section-wrapper">
            <div class="section-head">
                <div class="section-title-premium green">Kết nạp mới</div>
                <a href="/members" class="section-link-premium">Danh sách</a>
            </div>
            <div class="members-list-box">
                @foreach (var member in ViewBag.NewMembers as List<Member> ?? new List<Member>())
                {
                    <div class="member-pill">
                        <div class="member-avatar">
                            @(member.FullName?.Length > 0 ? member.FullName.Substring(0, 1) : "N")
                        </div>
                        <div class="member-details">
                            <h6>@member.FullName</h6>
                            <p>
                                <i class="fas fa-building" style="font-size: 0.6rem;"></i> 
                                @(member.Unit?.Name ?? "Đơn vị cơ sở")
                            </p>
                        </div>
                        <div class="member-meta">
                            <span>Ngày vào</span>
                            <p>
                                @{
                                    if (DateTime.TryParse(member.JoinDate, out var date))
                                    {
                                        @date.ToString("dd/MM/yyyy")
                                    }
                                    else
                                    {
                                        @:Invalid Date
                                    }
                                }
                            </p>
                        </div>
                    </div>
                }
                @if (!(ViewBag.NewMembers as List<Member>)?.Any() ?? true)
                {
                    <div class="member-pill">
                        <div class="member-avatar">N</div>
                        <div class="member-details">
                            <h6>Nguyễn Bá Hoàng Anh</h6>
                            <p><i class="fas fa-building"></i> Tập đoàn Bưu chính Viễn thông Việt Nam</p>
                        </div>
                        <div class="member-meta">
                            <span>Ngày vào</span>
                            <p>Invalid Date</p>
                        </div>
                    </div>
                    <div class="member-pill">
                        <div class="member-avatar">N</div>
                        <div class="member-details">
                            <h6>Nguyễn Lam Thùy Nhi</h6>
                            <p><i class="fas fa-building"></i> Tập đoàn Bưu chính Viễn thông Việt Nam</p>
                        </div>
                        <div class="member-meta">
                            <span>Ngày vào</span>
                            <p>Invalid Date</p>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
