@using Microsoft.AspNetCore.Identity
@using QLDV.Models
@inject UserManager<ApplicationUser> UserManager
@{
    ViewData["Title"] = "Dashboard";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var currentUser = await UserManager.GetUserAsync(User);
}

<style>
    .welcome-section {
        margin-bottom: 3rem;
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
    }

    .welcome-text h1 {
        font-weight: 800;
        font-size: 3rem;
        letter-spacing: -1.5px;
        margin-bottom: 0.5rem;
        color: #1a1a1a;
    }

    .welcome-text h1 span {
        color: var(--primary-color);
    }

    .welcome-text p {
        font-weight: 600;
        color: #999;
        font-size: 0.85rem;
        letter-spacing: 1.5px;
        text-transform: uppercase;
        margin: 0;
        display: flex;
        align-items: center;
        gap: 15px;
    }

    .welcome-text p::before {
        content: "";
        display: inline-block;
        width: 40px;
        height: 2px;
        background: #eee;
    }

    .session-card {
        background: #fff;
        padding: 1rem 1.5rem;
        border-radius: 20px;
        box-shadow: var(--card-shadow);
        display: flex;
        align-items: center;
        gap: 15px;
    }

    .session-icon {
        width: 48px;
        height: 48px;
        background: #f0f4f8;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #666;
    }

    .session-info span {
        display: block;
        font-size: 0.7rem;
        font-weight: 700;
        color: #999;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    .session-info h6 {
        margin: 0;
        font-weight: 700;
        font-size: 0.95rem;
    }

    /* Stat Cards */
    .stat-row {
        margin-bottom: 3rem;
    }

    .stat-card-new {
        background: #fff;
        padding: 2.5rem;
        border-radius: 40px;
        box-shadow: var(--card-shadow);
        text-align: center;
        height: 100%;
        transition: all 0.3s ease;
    }

    .stat-card-new:hover {
        transform: translateY(-10px);
        box-shadow: 0 20px 40px rgba(0,0,0,0.06);
    }

    .stat-card-new .icon-box {
        width: 64px;
        height: 64px;
        background: #f8f9fa;
        border-radius: 20px;
        margin: 0 auto 1.5rem auto;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.5rem;
        color: #1a1a1a;
    }

    .stat-card-new p {
        color: #999;
        font-size: 0.7rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 1px;
        margin-bottom: 0.5rem;
    }

    .stat-card-new h2 {
        font-weight: 800;
        font-size: 2.5rem;
        margin: 0;
        color: #1a1a1a;
    }

    /* Section Headers */
    .section-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 1.5rem;
    }

    .section-title {
        display: flex;
        align-items: center;
        gap: 12px;
        font-weight: 700;
        font-size: 0.9rem;
        text-transform: uppercase;
        letter-spacing: 1px;
        color: #666;
    }

    .section-title::before {
        content: "";
        display: inline-block;
        width: 4px;
        height: 24px;
        background: var(--primary-color);
        border-radius: 2px;
    }

    .section-title.green::before { background: #28a745; }

    .section-link {
        font-size: 0.75rem;
        font-weight: 800;
        color: var(--primary-color);
        text-decoration: none;
        text-transform: uppercase;
        letter-spacing: 1px;
    }

    /* Activity List Item */
    .activity-item {
        background: #f8f9fa;
        padding: 1.5rem;
        border-radius: 30px;
        display: flex;
        align-items: center;
        gap: 20px;
        margin-bottom: 1rem;
    }

    .activity-icon {
        width: 56px;
        height: 56px;
        background: #fff;
        border-radius: 16px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.25rem;
        color: #666;
        box-shadow: 0 4px 10px rgba(0,0,0,0.02);
    }

    .activity-info {
        flex-grow: 1;
    }

    .activity-info h6 {
        margin: 0 0 0.25rem 0;
        font-weight: 700;
        font-size: 1rem;
    }

    .activity-tag {
        display: inline-block;
        padding: 0.25rem 0.75rem;
        background: #1a1a1a;
        color: #fff;
        border-radius: 8px;
        font-size: 0.65rem;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    .activity-date {
        text-align: right;
        min-width: 80px;
    }

    .activity-date span {
        display: block;
        font-size: 1.1rem;
        font-weight: 800;
        line-height: 1;
    }

    .activity-date small {
        font-size: 0.7rem;
        font-weight: 700;
        color: #999;
    }

    /* Member List Item */
    .member-item {
        background: #fff;
        padding: 1.25rem;
        border-radius: 24px;
        display: flex;
        align-items: center;
        gap: 15px;
        margin-bottom: 0.75rem;
        border: 1px solid #f0f0f0;
        transition: all 0.2s;
    }

    .member-item:hover {
        transform: scale(1.02);
        box-shadow: var(--card-shadow);
    }

    .member-avatar-circle {
        width: 48px;
        height: 48px;
        background: #f8f9fa;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 700;
        color: #666;
        border: 1px solid #eee;
    }

    .member-info h6 {
        margin: 0;
        font-weight: 700;
        font-size: 0.95rem;
    }

    .member-info p {
        margin: 0;
        font-size: 0.75rem;
        color: #999;
        display: flex;
        align-items: center;
        gap: 5px;
    }

    .member-date {
        margin-left: auto;
        text-align: right;
    }

    .member-date span {
        display: block;
        font-size: 0.65rem;
        font-weight: 700;
        color: #ccc;
        text-transform: uppercase;
    }

    .member-date p {
        margin: 0;
        font-size: 0.8rem;
        font-weight: 700;
        color: #666;
    }
</style>

<div class="welcome-section">
    <div class="welcome-text">
        <h1>Xin chào, <span>@(currentUser?.FullName?.Split(' ').Last() ?? "Thành viên")</span></h1>
        <p>Hệ thống quản lý đoàn cơ sở</p>
    </div>
    <div class="session-card">
        <div class="session-icon">
            <i class="far fa-star fa-lg"></i>
        </div>
        <div class="session-info">
            <span>Phiên làm việc</span>
            <h6>@(DateTime.Now.ToString("dddd, dd/MM"))</h6>
        </div>
    </div>
</div>

<div class="row stat-row">
    <div class="col-md-3">
        <div class="stat-card-new">
            <div class="icon-box">
                <i class="fas fa-building"></i>
            </div>
            <p>Tổng số chi đoàn</p>
            <h2>@ViewBag.TotalUnits</h2>
        </div>
    </div>
    <div class="col-md-3">
        <div class="stat-card-new">
            <div class="icon-box">
                <i class="fas fa-users"></i>
            </div>
            <p>Tổng số đoàn viên</p>
            <h2>@ViewBag.TotalMembers</h2>
        </div>
    </div>
    <div class="col-md-3">
        <div class="stat-card-new">
            <div class="icon-box">
                <i class="far fa-calendar-check"></i>
            </div>
            <p>Hoạt động sắp tới</p>
            <h2>@ViewBag.UpcomingActivitiesCount</h2>
        </div>
    </div>
    <div class="col-md-3">
        <div class="stat-card-new">
            <div class="icon-box">
                <i class="far fa-star"></i>
            </div>
            <p>Đoàn viên tiêu biểu</p>
            <h2>@ViewBag.OutstandingMembersCount</h2>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-md-6">
        <div class="section-header">
            <div class="section-title">Hoạt động sắp tới</div>
            <a href="/activities" class="section-link">Xem tất cả &rarr;</a>
        </div>
        <div class="activities-list">
            @foreach (var activity in ViewBag.UpcomingActivities as List<Activity> ?? new List<Activity>())
            {
                <div class="activity-item">
                    <div class="activity-icon">
                        <i class="far fa-calendar-alt"></i>
                    </div>
                    <div class="activity-info">
                        <h6>@activity.Title</h6>
                        <span class="activity-tag">@activity.Type</span>
                    </div>
                    <div class="activity-date">
                        @{
                            if (DateTime.TryParse(activity.Date, out var date))
                            {
                                <span>@date.ToString("dd")-@date.ToString("MM")</span>
                                <small>@date.ToString("yyyy")</small>
                            }
                        }
                    </div>
                </div>
            }
            @if (!(ViewBag.UpcomingActivities as List<Activity>)?.Any() ?? true)
            {
                <div class="text-center p-5 text-muted">
                    <i class="fas fa-calendar-times fa-3x mb-3"></i>
                    <p>Không có hoạt động nào sắp tới</p>
                </div>
            }
        </div>
    </div>
    <div class="col-md-6">
        <div class="section-header">
            <div class="section-title green">Kết nạp mới</div>
            <a href="/members" class="section-link">Danh sách &rarr;</a>
        </div>
        <div class="members-list">
            @foreach (var member in ViewBag.NewMembers as List<Member> ?? new List<Member>())
            {
                <div class="member-item">
                    <div class="member-avatar-circle">
                        @member.FullName.Substring(0, 1)
                    </div>
                    <div class="member-info">
                        <h6>@member.FullName</h6>
                        <p><i class="fas fa-id-badge"></i> @member.MemberId</p>
                    </div>
                    <div class="member-date">
                        <span>Ngày vào</span>
                        <p>
                            @{
                                if (DateTime.TryParse(member.JoinDate, out var date))
                                {
                                    @date.ToString("dd/MM/yyyy")
                                }
                                else
                                {
                                    @:Invalid Date
                                }
                            }
                        </p>
                    </div>
                </div>
            }
            @if (!(ViewBag.NewMembers as List<Member>)?.Any() ?? true)
            {
                <div class="text-center p-5 text-muted">
                    <i class="fas fa-user-clock fa-3x mb-3"></i>
                    <p>Chưa có đoàn viên mới nào</p>
                </div>
            }
        </div>
    </div>
</div>
