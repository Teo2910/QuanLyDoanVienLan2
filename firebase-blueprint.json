{
  "entities": {
    "Unit": {
      "title": "Đơn vị",
      "description": "Thông tin chi đoàn hoặc đoàn cơ sở",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "code": { "type": "string" },
        "address": { "type": "string" },
        "phone": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "code"]
    },
    "Member": {
      "title": "Đoàn viên",
      "description": "Hồ sơ cá nhân của đoàn viên",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "fullName": { "type": "string" },
        "memberId": { "type": "string" },
        "dob": { "type": "string", "format": "date" },
        "gender": { "type": "string", "enum": ["Nam", "Nữ", "Khác"] },
        "ethnic": { "type": "string" },
        "hometown": { "type": "string" },
        "joinDate": { "type": "string", "format": "date" },
        "unitId": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "phone": { "type": "string" },
        "academicYear": { "type": "string" },
        "achievementLevel": { "type": "string", "enum": ["Xuất sắc", "Khá", "Trung bình", "Chưa xếp loại"] },
        "status": { "type": "string", "enum": ["Đang sinh hoạt", "Đã chuyển sinh hoạt", "Đã trưởng thành", "Bị kỷ luật"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["fullName", "unitId"]
    },
    "UserProfile": {
      "title": "Hồ sơ người dùng",
      "description": "Thông tin phân quyền và cá nhân của người dùng hệ thống",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "role": { "type": "string", "enum": ["admin", "secretary"] },
        "unitId": { "type": "string", "description": "ID đơn vị quản lý (nếu là Secretary)" },
        "presets": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": { "type": "string" },
              "name": { "type": "string" },
              "filters": {
                "type": "object",
                "properties": {
                  "unit": { "type": "string" },
                  "status": { "type": "string" },
                  "academicYear": { "type": "string" },
                  "achievement": { "type": "string" },
                  "searchTerm": { "type": "string" },
                  "hometown": { "type": "string" }
                }
              }
            }
          }
        }
      },
      "required": ["uid", "email", "role"]
    }
  },
  "firestore": {
    "/units/{unitId}": {
      "schema": "Unit",
      "description": "Danh sách các đơn vị đoàn"
    },
    "/members/{memberId}": {
      "schema": "Member",
      "description": "Danh sách đoàn viên"
    },
    "/users/{uid}": {
      "schema": "UserProfile",
      "description": "Thông tin phân quyền người dùng"
    }
  }
}
